{
  "$extensions": { "com.figma.modeName": "desktop" },
  "display": {
    "family": { "$type": "string", "$value": "Manrope, sans-serif" },
    "size": { "$type": "number", "$value": 48 },
    "line-height": { "$type": "number", "$value": 56 },
    "letter-spacing": { "$type": "number", "$value": -1 },
    "weight-base": { "$type": "number", "$value": 700 }
  },
  "body": {
    "family": { "$type": "string", "$value": "Inter, sans-serif" },
    "size": { "$type": "number", "$value": 18 },
    "line-height": { "$type": "number", "$value": 28 },
    "weight-base": { "$type": "number", "$value": 400 },
    "weight-strong": { "$type": "number", "$value": 600 }
  },
  "caption": {
    "size": { "$type": "number", "$value": 14 },
    "line-height": { "$type": "number", "$value": 20 },
    "note": { "$type": "string", "$value": "not emitted (property_keys filter)" }
  }
}
