{
  "$extensions": { "com.figma.modeName": "primary" },
  "cta": {
    "primary": {
      "fill": { "$type": "color", "$value": { "components": [0.184, 0.34, 0.65], "alpha": 1 } },
      "label": { "$type": "color", "$value": { "components": [1, 1, 1], "alpha": 1 } },
      "border-width": { "$type": "number", "$value": 0 }
    },
    "secondary": {
      "fill": { "$type": "color", "$value": { "components": [0.96, 0.96, 0.98], "alpha": 1 } },
      "label": { "$type": "color", "$value": { "components": [0.07, 0.09, 0.15], "alpha": 1 } }
    }
  },
  "form": {
    "input-border": { "$type": "number", "$value": 1 }
  }
}
