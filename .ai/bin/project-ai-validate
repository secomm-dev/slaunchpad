# --- Hyva integration (opt-in --check-hyva; auto-runs in PROJECT mode if .ai/integrations/hyva exists) ---
if [ $C_HYVA -eq 1 ] || { [ "$MODE" = "project" ] && [ -n "${P:-}" ] && [ -d "$P/.ai/integrations/hyva" ]; }; then
  echo "--- hyva-integration ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    DEV="$ROOT/skills-source/dev-skills/magento"; INT="$ROOT/shared-core/integrations/hyva"
    MAN="$ROOT/skills-source/dev-skills/dev-skill-manifest.yaml"; UM="$INT/upstream-manifest.yaml"; DM="$INT/dependency-map.yaml"
    [ -d "$DEV" ] || fail "canonical dev-skill root missing"
    [ -d "$DEV/hyva" ] && fail "nested magento/hyva/ directory present (skills must be flat)" || note "no nested magento/hyva/ (flat)"
    nb="$(find "$INT" -name SKILL.md -not -path "*/retired-secomm-skills/*" 2>/dev/null | wc -l)"
    [ "$nb" -eq 0 ] && note "no skill body under shared-core/integrations/hyva/ (metadata only)" || fail "$nb skill body file(s) under integrations/hyva/ (must be metadata only)"
    if command -v python3 >/dev/null 2>&1 && [ -f "$MAN" ] && [ -f "$UM" ] && [ -f "$DM" ]; then
      python3 - "$MAN" "$DEV" "$UM" "$DM" <<'PY' && note "manifest deps/closures resolve + upstream sha256 verify + dependency-map consistent" || { errors=$((errors+1)); }
import sys, yaml, pathlib, hashlib
man=yaml.safe_load(open(sys.argv[1])); dev=pathlib.Path(sys.argv[2]); um=yaml.safe_load(open(sys.argv[3])); dm=yaml.safe_load(open(sys.argv[4]))['dependencies']
skills=man['skills']; deps={k:v.get('dependencies',[]) for k,v in skills.items()}; errs=[]
for s,dl in deps.items():
    if not (dev/s/'SKILL.md').is_file(): errs.append(f"canonical SKILL.md missing: {s}")
    for d in dl:
        if d not in skills: errs.append(f"unresolved dependency {d} (from {s})")
for p,pd in man['profiles'].items():
    for s in pd['skills']:
        if s not in skills: errs.append(f"profile {p} references unknown skill {s}")
        elif (dev/s/'SKILL.md').is_file() is False: errs.append(f"profile {p} skill not canonical: {s}")
for f in um['files']:
    p=dev/f['path']
    if not p.is_file(): errs.append(f"upstream-manifest missing file {f['path']}")
    elif hashlib.sha256(p.read_bytes()).hexdigest()!=f['sha256']: errs.append(f"sha256 mismatch {f['path']}")
for s,dl in dm.items():
    fm=(dev/s/'SKILL.md').read_text().split('---')
    req=fm[1].split('requires:')[1].split('\n')[0].strip() if len(fm)>1 and 'requires:' in fm[1] else ''
    parsed=[x.strip() for x in req.split(',')] if req else []
    if parsed!=dl: errs.append(f"dependency-map vs frontmatter mismatch: {s}")
for e in errs: print("FAIL: "+e)
sys.exit(1 if errs else 0)
PY
    else warn "python3/pyyaml or manifest files unavailable — skipped manifest/sha256 deep checks"; fi
    note "canonical Hyva dev-skills: $(ls -d "$DEV"/hyva-* 2>/dev/null | wc -l) (flat, direct children)"
  else
    DEV="$P/.claude/skills/dev"; INT="$P/.ai/integrations/hyva"
    n="$(ls -d "$DEV"/hyva-* 2>/dev/null | wc -l)"
    [ "$n" -gt 0 ] && note "project Hyva dev-skills installed: $n" || fail "no Hyva dev-skills under .claude/skills/dev/"
    for f in SECOMM_OVERLAY.md provenance.yaml version-lock.yaml upstream-manifest.yaml; do
      [ -f "$INT/$f" ] && note "integration metadata present: $f" || fail "integration metadata missing: .ai/integrations/hyva/$f"
    done
    [ -f "$P/codex/AGENTS.md" ] && { grep -q "BEGIN Secomm Hyva skills routing" "$P/codex/AGENTS.md" && note "Codex routing present (STATIC)" || warn "codex/AGENTS.md present but Hyva routing absent"; }
    [ -f "$P/.github/copilot-instructions.md" ] && { grep -q "BEGIN Secomm Hyva skills routing" "$P/.github/copilot-instructions.md" && note "Copilot routing present (STATIC)" || warn ".github/copilot-instructions.md present but Hyva routing absent"; }
    note "Codex/Copilot discoverability = STATIC VALIDATION ONLY (natural-language routing; runtime invocation not automated)"
    if [ -n "${ROOT:-}" ]; then ap="$(grep -rl "$ROOT/" "$DEV" "$INT" 2>/dev/null | wc -l)"; [ "$ap" -eq 0 ] && note "no absolute generator-path refs in installed content" || fail "absolute generator-path reference in installed content"; fi
    grep -q "hyva_ai_tools_integration" "$P/.ai/toolkit/toolkit-version.md" 2>/dev/null && note "toolkit-version hyva stamp present" || warn "toolkit-version hyva stamp absent"
  fi
fi

echo "----------------------------------------"
echo "result ($MODE): $errors FAIL, $warnings WARN"
[ $errors -eq 0 ] && { echo "VALID"; exit 0; } || { echo "INVALID"; exit 1; }
