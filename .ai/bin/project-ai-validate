    grep -q "Canonical source (Phase 1f dedup)" "$ROOT/core/quality-gates.md" && grep -q "Canonical source (Phase 1f dedup)" "$ROOT/core/delivery-governance.md" && note "quality-gates/delivery-governance canonical markers present" || warn "gate canonical markers missing"
  else
