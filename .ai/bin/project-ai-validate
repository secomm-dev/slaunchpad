#!/usr/bin/env bash
# =============================================================================
# project-ai-validate — validate the Project AI Toolkit capability contract
# against the single source of truth (toolkit-capability-registry.yaml).
#
# Two modes (auto-detected by walking up from this script):
#   TOOLKIT mode — finds shared-core/registry/  → validates the SOURCE contract
#                  (templates vs registry, command maps, broken refs).
#   PROJECT mode — finds .ai/registry/          → validates a GENERATED project
#                  standalone (nav skills present, registry present, no broken
#                  refs). Use this to prove a project works with only its own
#                  repo open (Test J).
#   Override: --project <path>   --root <toolkit-path>
#
# Zero-dependency bash (grep/sed/awk). python3+pyyaml optional (YAML syntax only).
#
# The rule enforced: anything documented as usable must have a discoverable,
# valid implementation; anything implemented must be accurately documented.
#
# Usage:
#   bin/project-ai-validate                 # auto-detect
#   bin/project-ai-validate --check-adapters|--check-cheatsheet|--check-commands|--check-refs|--check-records|--check-identity|--check-specs|--check-modes|--check-project-state|--check-hyva
#   bin/project-ai-validate --project /path/to/generated/project
#   bin/project-ai-validate --quiet
# Exit: 0 = clean, 1 = material contract violation.
# =============================================================================
set -uo pipefail

QUIET=0; PROJECT=""; ROOT_OVERRIDE=""
RUN_ALL=1; C_ADAPTERS=0; C_CHEAT=0; C_CMDS=0; C_REFS=0; C_RECORDS=0; C_SPECS=0; C_MODES=0; C_PSTATE=0; C_RSEP=0; C_CEFF=0; C_GOV=0; C_HYVA=0; C_IDENT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --quiet) QUIET=1; shift ;;
    --check-adapters) RUN_ALL=0; C_ADAPTERS=1; shift ;;
    --check-cheatsheet) RUN_ALL=0; C_CHEAT=1; shift ;;
    --check-commands) RUN_ALL=0; C_CMDS=1; shift ;;
    --check-refs) RUN_ALL=0; C_REFS=1; shift ;;
    --check-records) RUN_ALL=0; C_RECORDS=1; shift ;;
    --check-identity) RUN_ALL=0; C_IDENT=1; shift ;;
    --check-specs) RUN_ALL=0; C_SPECS=1; shift ;;
    --check-modes) RUN_ALL=0; C_MODES=1; shift ;;
    --check-project-state) RUN_ALL=0; C_PSTATE=1; shift ;;
    --check-runtime-separation) RUN_ALL=0; C_RSEP=1; shift ;;
    --check-context-efficiency) RUN_ALL=0; C_CEFF=1; shift ;;
    --check-governance-dedup) RUN_ALL=0; C_GOV=1; shift ;;
    --check-hyva) RUN_ALL=0; C_HYVA=1; shift ;;
    --project) PROJECT="$2"; shift 2 ;;
    --root) ROOT_OVERRIDE="$2"; shift 2 ;;
    -h|--help) sed -n '2,26p' "$0"; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done
[ $RUN_ALL -eq 1 ] && { C_ADAPTERS=1; C_CHEAT=1; C_CMDS=1; C_REFS=1; C_RECORDS=1; C_IDENT=1; C_SPECS=1; C_MODES=1; C_PSTATE=1; C_RSEP=1; }

errors=0; warnings=0
note(){ [ $QUIET -eq 0 ] && echo "ok:   $*" || true; }
warn(){ echo "warn: $*"; warnings=$((warnings+1)); }
fail(){ echo "FAIL: $*"; errors=$((errors+1)); }

# --- locate toolkit root (shared-core/registry) ---
__d="${ROOT_OVERRIDE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
ROOT=""
while [ "$__d" != "/" ]; do
  [ -f "$__d/shared-core/registry/toolkit-capability-registry.yaml" ] && { ROOT="$__d"; break; }
  __d="$(dirname "$__d")"
done

# --- locate registry + decide mode ---
if [ -n "$PROJECT" ]; then
  P="$(cd "$PROJECT" && pwd)"
  REG="$P/.ai/registry/toolkit-capability-registry.yaml"
  MODE="project"
elif [ -n "$ROOT" ]; then
  REG="$ROOT/shared-core/registry/toolkit-capability-registry.yaml"; MODE="toolkit"
else
  # standalone project: walk up for .ai/registry
  __d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  while [ "$__d" != "/" ]; do
    if [ -f "$__d/.ai/registry/toolkit-capability-registry.yaml" ]; then P="$__d"; REG="$__d/.ai/registry/toolkit-capability-registry.yaml"; MODE="project"; break; fi
    __d="$(dirname "$__d")"
  done
fi
[ -n "${REG:-}" ] && [ -f "$REG" ] || { echo "FATAL: registry not found (no shared-core/registry in toolkit, no .ai/registry in project)" >&2; exit 2; }
# in project mode without explicit ROOT, derive ROOT for source paths if available (optional)
[ -z "${ROOT:-}" ] && ROOT=""

# optional YAML syntax sanity
if command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' 2>/dev/null; then
  python3 -c "import yaml; yaml.safe_load(open('$REG'))" 2>/dev/null && note "registry YAML parses (pyyaml)" || fail "registry YAML is syntactically invalid"
else
  warn "python3/pyyaml not available — skipping YAML syntax check (structural checks still run)"
fi

# resolve a registry adapter path to a real file path for the current mode
resolve_adapter(){
  local a="$1"
  case "$MODE" in
    toolkit) echo "$ROOT/$a" ;;                                 # path is toolkit-relative
    project)
      case "$a" in
        skills-source/*) local n="${a#skills-source/}"; echo "$P/.claude/skills/$n" ;;   # skill copied into .claude/skills/
        .ai/*) echo "$P/$a" ;;
        *) echo "" ;;                                           # codex/copilot/shared-core adapters are provenance/NL in a project — not required standalone
      esac ;;
  esac
}

# -----------------------------------------------------------------------------
# Check: every enabled hard-adapter file exists (skill/prompt-snippet).
# In PROJECT mode only the always-present set (nav.*) is asserted — non-nav
# skills are project-SELECTED, so their absence in a given project is valid.
# -----------------------------------------------------------------------------
if [ $C_ADAPTERS -eq 1 ]; then
  echo "--- adapters ($MODE) ---"
  # emit: cap|tool|invocation_type|adapter  (enabled=true only)
  while IFS='|' read -r cap tool itype adapter; do
    [ -n "$cap" ] || continue
    if [ "$MODE" = "project" ]; then
      case "$cap" in nav.*) ;; *) continue ;; esac   # project-selected skills are not asserted standalone
    fi
    case "$itype" in
      skill|prompt-snippet)
        if [ -z "$adapter" ]; then fail "$cap.$tool: enabled, invocation_type=$itype, but no adapter path"; continue; fi
        rp="$(resolve_adapter "$adapter")"
        if [ "$MODE" = "project" ] && [ -z "$rp" ]; then continue; fi   # codex/copilot/shared-core not required standalone
        [ -n "$rp" ] && [ -f "$rp" ] || fail "$cap.$tool adapter missing ($MODE): $adapter" ;;
      nl-only|function|gate|none|"") ;;
      *) warn "$cap.$tool: unknown invocation_type '$itype' (adapter=$adapter)" ;;
    esac
  done < <(awk '
    /^  [A-Za-z0-9._-]+:$/ { cap=$0; gsub(/[ :]/,"",cap); next }
    /^[[:space:]]+(claude|codex|copilot):[[:space:]]*\{/ {
      line=$0; tool=line; sub(/^[[:space:]]+/,"",tool); sub(/:.*/,"",tool)
      en=(line ~ /enabled:[ ]*true/)
      it=""; if (match(line,/invocation_type:[ ]*[a-z-]+/)){it=substr(line,RSTART,RLENGTH); sub(/invocation_type:[ ]*/,"",it)}
      ad=""; if (match(line,/adapter:[ ]*"[^"]+"/)){ad=substr(line,RSTART,RLENGTH); sub(/adapter:[ ]*"/,"",ad); sub(/"$/,"",ad)}
      if (en) print cap"|"tool"|"it"|"ad
    }' "$REG")
  note "adapter existence checked ($MODE)"
fi

# -----------------------------------------------------------------------------
# Toolkit-only: CHEATSHEET nav table ↔ registry nav.* (drift).
# -----------------------------------------------------------------------------
if [ $C_CHEAT -eq 1 ] && [ "$MODE" = "toolkit" ]; then
  echo "--- cheatsheet ---"
  CHEAT="$ROOT/shared-core/enablement/templates/CHEATSHEET.template.md"
  [ -f "$CHEAT" ] || fail "CHEATSHEET template missing: $CHEAT"
  mapfile -t REG_NAV < <(awk '
    /^  [A-Za-z0-9._-]+:$/ { cap=$0; gsub(/[ :]/,"",cap); next }
    cap ~ /^nav\./ && /^      claude:/ && /invocation:/ {
      l=$0; sub(/^.*invocation:[ ]*"/,"",l); sub(/".*/,"",l); sub(/[ ].*/,"",l); print l
    }' "$REG" | sort -u)
  mapfile -t CHEAT_NAV < <(awk '
    /^## 🧭/{f=1;next} /^## /{f=0} f && /`\/[a-z]/ {
      s=$0; while(match(s,/`\/[a-z][a-z-]+/)){print substr(s,RSTART+1,RLENGTH-1); s=substr(s,RSTART+RLENGTH)}
    }' "$CHEAT" | sort -u)
  drift=0
  for c in "${REG_NAV[@]}"; do { found=0; for x in "${CHEAT_NAV[@]}"; do [ "$x" = "$c" ] && found=1; done; [ $found -eq 0 ] && { fail "registry nav $c missing from CHEATSHEET"; drift=1; }; }; done
  for c in "${CHEAT_NAV[@]}"; do { found=0; for x in "${REG_NAV[@]}"; do [ "$x" = "$c" ] && found=1; done; [ $found -eq 0 ] && { fail "CHEATSHEET nav $c not in registry (drift)"; drift=1; }; }; done
  [ $drift -eq 0 ] && note "CHEATSHEET nav table matches registry nav.* (${#REG_NAV[@]})"
  grep -q '⚠️' "$CHEAT" || warn "CHEATSHEET: no mutating (⚠️) marker — /approve,/tbd guard may be missing"
fi

# -----------------------------------------------------------------------------
# Toolkit-only: command-map consistency + no deprecated command advertised.
# -----------------------------------------------------------------------------
if [ $C_CMDS -eq 1 ] && [ "$MODE" = "toolkit" ]; then
  echo "--- commands ---"
  CMDIDX="$ROOT/shared-core/commands/commands-index.md"
  SUPPORTED="$ROOT/shared-core/intents/supported-commands-template.md"
  mapfile -t REG_IDS < <(awk '/^  [A-Za-z0-9._-]+:$/{ id=$0; gsub(/[ :]/,"",id); print id }' "$REG" | sort -u)
  if [ -f "$CMDIDX" ]; then
    while IFS= read -r cid; do
      [ -z "$cid" ] && continue
      ok=0; for x in "${REG_IDS[@]}"; do [ "$x" = "$cid" ] && ok=1; done
      [ $ok -eq 0 ] && fail "commands-index references unknown Canonical ID: $cid"
    done < <(grep -oE '`(delivery|nav)\.[a-z-]+`' "$CMDIDX" | tr -d '`' | sort -u)
    note "commands-index Canonical IDs checked against registry"
  fi
  for f in "$CMDIDX" "$SUPPORTED"; do [ -f "$f" ] || continue
    grep -nE '(^|[^~])`/tl-review`' "$f" >/dev/null 2>&1 && fail "$(basename "$f"): deprecated /tl-review advertised as a live command"
  done
  note "deprecated-command advertising checked"
fi

# -----------------------------------------------------------------------------
# Check: no broken templates/*.md references (toolkit: repo; project: .ai/).
# -----------------------------------------------------------------------------
if [ $C_REFS -eq 1 ]; then
  echo "--- references ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    refs_root="$ROOT"; tmplsub="templates"; tmplbase="$ROOT/templates"
  else
    refs_root="$P/.ai"; tmplsub="templates"; tmplbase="$P/.ai/templates"
  fi
  brokenc=0
  if [ -d "$refs_root" ]; then
    while IFS= read -r ref; do
      f="$(printf '%s' "$ref" | sed -E "s#.*${tmplsub}/##")"
      [ -f "$tmplbase/$f" ] || { fail "broken reference: $ref"; brokenc=$((brokenc+1)); }
    done < <(grep -rhoE "${tmplsub}/[A-Za-z0-9_-]+\.md" --include='*.md' "$refs_root" 2>/dev/null | sort -u)
  fi
  [ $brokenc -eq 0 ] && note "no broken ${tmplsub}/*.md references ($MODE)"
  if [ "$MODE" = "toolkit" ]; then
    for d in .agents .codex .claude .github; do
      [ -d "$ROOT/$d" ] && [ -z "$(find "$ROOT/$d" -type f 2>/dev/null | head -1)" ] && warn "empty tool dir present: $d/ (unused scaffolding)"
    done
  fi
fi

# -----------------------------------------------------------------------------
# Check: canonical records contract (Phase 1a). Permissive when absent.
#   toolkit mode → the 4 canonical record templates must exist in templates/.
#   project mode → .ai/records/ frontmatter + decisions/components link resolve.
# -----------------------------------------------------------------------------
if [ $C_RECORDS -eq 1 ]; then
  echo "--- records ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    for t in feature-record task-record bug-record spike-record release-record decision-record; do
      [ -f "$ROOT/templates/$t-template.md" ] || fail "missing canonical record template: templates/$t-template.md"
    done
    [ -f "$ROOT/templates/project-config-template.yaml" ] || fail "missing project config template: templates/project-config-template.yaml (P2A)"
    note "canonical record templates present (toolkit)"
  else
    REC="$P/.ai/records"
    if [ ! -d "$REC" ]; then
      note "no .ai/records/ (skipped — legacy project; Phase 1a permissive)"
    elif ! command -v python3 >/dev/null 2>&1; then
      warn "python3 unavailable — records contract check skipped at $REC (install python3 to verify)"
    else
      rec_out="$(python3 - "$REC" <<'PYREC'
import sys, os, re
# Phase 1b+: decision work_items contract. Soft (WARN to stderr, exit 0) by
# default; set DEC_WORK_ITEMS_HARD=1 to promote missing/malformed work_items to
# FAIL. Anchors each DEC to >=1 work-item (FEAT-/SL-/BUG-/REL-) so concurrent
# staff cannot re-open the same subject under a different DEC-ID.
WORK_ITEMS_HARD = os.environ.get('DEC_WORK_ITEMS_HARD', '0') in ('1', 'true', 'yes')
rec = sys.argv[1]
fails = []
warns = []
def frontmatter(path):
    with open(path, encoding='utf-8') as fh: txt = fh.read()
    m = re.match(r'^---\r?\n(.*?)\r?\n---(?:\r?\n|$)', txt, re.S)
    return m.group(1) if m else ''
def has_key(fm, key):
    return re.search(r'^' + re.escape(key) + r':', fm, re.M) is not None
def field_vals(fm, key):
    vals = []; in_block = False
    for line in fm.splitlines():
        if re.match(r'^' + re.escape(key) + r':', line):
            rest = line.split(':', 1)[1]
            rest = re.sub(r'#.*$', '', rest).strip()   # strip inline comment, then trim
            if rest.startswith('['):
                vals = [v.strip().strip('\'"') for v in rest.strip('[]').split(',') if v.strip()]; in_block = False
            elif rest == '':
                in_block = True
            else:
                vals = [rest.strip().strip('\'"')]; in_block = False
        elif in_block:
            if re.match(r'^\s*-\s+', line):
                vals.append(re.sub(r'^\s*-\s*', '', line).strip().strip('\'"'))
            elif re.match(r'^[A-Za-z_]', line):
                in_block = False
    return vals
req = {
 'features': ['id','status','mode','components','changes_project_state','verified_against_commit'],
 'tasks':     ['id','status','components','changes_project_state'],
 'bugs':      ['id','status','components','changes_project_state'],
 'spikes':    ['id','status','components','changes_project_state'],
 'releases':  ['id','status'],
 'decisions': ['id','status'],
}
prefix = {'features':'FEAT-','tasks':'TASK-','bugs':'BUG-','spikes':'SPIKE-','releases':'REL-','decisions':'DEC-'}
# P2A dual-format work-item ids (work-item-identity.md §2): new collision-safe
# (<TYPE>-<6 Crockford Base32 chars, no I/L/O/U>) OR legacy (<ABBR>-<NNN+>).
NEW_ID = re.compile(r'^(FEAT|TASK|BUG|SPIKE|REL)-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{6}$')
LEGACY_ID = re.compile(r'^[A-Z][A-Z0-9]{1,7}-[0-9]{3,}$')
_dec_md = os.path.join(rec, '..', 'project-context', 'memory', 'DECISIONS.md')
_dec_md_text = ''
if os.path.exists(_dec_md):
    with open(_dec_md, encoding='utf-8') as _fh: _dec_md_text = _fh.read()
for kind in req:
    kd = os.path.join(rec, kind)
    if not os.path.isdir(kd): continue
    for fn in sorted(os.listdir(kd)):
        if not fn.endswith('.md'): continue
        rel = kind + '/' + fn
        fm = frontmatter(os.path.join(kd, fn))
        if not fm: fails.append(rel + ': no YAML frontmatter'); continue
        for key in req[kind]:
            if not has_key(fm, key): fails.append(rel + ': missing frontmatter ' + key)
        iid = (field_vals(fm, 'id') or [''])[0]
        if iid and not iid.startswith(prefix[kind]):
            fails.append(rel + ': id ' + iid + ' should start with ' + prefix[kind])
        # Decision work_items contract (Phase 1b+): >=1 FEAT-/SL-/BUG-/REL- unless exempt.
        if kind == 'decisions':
            _wis = field_vals(fm, 'work_items')
            _dtype = (field_vals(fm, 'decision_type') or [''])[0].strip()
            _exempt = _dtype in ('process', 'tooling', 'governance')
            _wi_target = fails if WORK_ITEMS_HARD else warns
            if not _exempt and len(_wis) == 0:
                _wi_target.append(rel + ': decision missing work_items (>=1 work-item ID, P2A dual format); set decision_type: process|tooling|governance to exempt')
            for _wi in _wis:
                if not (NEW_ID.match(_wi) or LEGACY_ID.match(_wi)):
                    _wi_target.append(rel + ': work_items entry not a valid work-item ID (new FEAT|TASK|BUG|SPIKE|REL-XXXXXX or legacy ABBR-NNN): ' + _wi)
            # Entry h (2026-08-17) + P2A: per-work-item file naming DEC-{CODE}-{NNN}
            # (CODE = work-item ID without hyphens: SL-015 -> SL015; TASK-4P8DX2 ->
            # TASK4P8DX2). Both legacy DEC-NNN and the new format are accepted;
            # soft-WARN when a new-format id prefix does not match the first
            # work_items entry (the primary work-item that should name the file).
            _ih = re.match(r'^DEC-([A-Z0-9]+)-[0-9]{3}$', iid)
            if _ih and _wis:
                _first = (_wis[0] or '').replace('-', '')
                if _first != _ih.group(1):
                    warns.append(rel + ': id ' + iid + ' prefix does not match first work_items entry ' + _wis[0] + ' (expected DEC-' + _first + '-NNN, or reorder work_items so the primary work-item is first)')
        for dv in field_vals(fm, 'decisions'):
            m = re.search(r'(DEC-[A-Za-z0-9_-]+)', dv)
            if m:
                did = m.group(1)
                _canonical = os.path.join(rec, 'decisions', did + '.md')
                _in_index = re.search(re.escape(did) + r'(?![0-9A-Za-z_-])', _dec_md_text) is not None
                if not os.path.exists(_canonical) and not _in_index:
                    fails.append(rel + ': decisions link unresolved: ' + did + ' (not in records/decisions/ nor DECISIONS.md)')
        # Mode A decision-coverage enforcement (Phase 1b correction)
        _mode = (field_vals(fm, 'mode') or [''])[0]
        if _mode == 'A':
            if not has_key(fm, 'decision_assessment'):
                fails.append(rel + ': Mode A record missing decision_assessment (Phase 1b; core/decision-assessment.md)')
            elif (field_vals(fm, 'decision_assessment') or [''])[0] == 'material' and not field_vals(fm, 'decisions'):
                fails.append(rel + ': Mode A decision_assessment=material but decisions empty (create DEC records)')
        # decision_approval_summary consistency (B1) — feature/bug records
        if kind in ('features', 'bugs'):
            _fm_text = fm   # frontmatter() returns the frontmatter text (string)
            if 'decision_approval_summary' in _fm_text:
                def _summ_val(name):
                    m = re.search(r'^[ \t]*' + name + r':[ \t]*\[([^\]]*)\]', _fm_text, re.M)
                    if m:
                        return [v.strip().strip('\'"') for v in m.group(1).split(',') if v.strip()]
                    m2 = re.search(r'^[ \t]*' + name + r':[ \t]*(\S+)', _fm_text, re.M)
                    return m2.group(1) if m2 else None
                _total = _summ_val('total')
                _ndec = len(field_vals(fm, 'decisions'))
                try:
                    if _total is not None and int(_total) != _ndec:
                        fails.append(rel + ': decision_approval_summary.total=' + str(_total) + ' but decisions has ' + str(_ndec))
                except ValueError:
                    pass
                _bsum = sum(len(_summ_val(b) or []) for b in ('pending_approval', 'approved', 'rejected', 'superseded'))
                try:
                    if _total is not None and int(_total) != _bsum:
                        fails.append(rel + ': decision_approval_summary buckets sum to ' + str(_bsum) + ' but total=' + str(_total))
                except ValueError:
                    pass
                _bucket_of = {'proposed': 'pending_approval', 'accepted': 'approved', 'rejected': 'rejected', 'superseded': 'superseded'}
                for dv in field_vals(fm, 'decisions'):
                    m = re.search(r'(DEC-[A-Za-z0-9_-]+)', dv)
                    if not m:
                        continue
                    did = m.group(1)
                    _dec_file = os.path.join(rec, 'decisions', did + '.md')
                    if not os.path.exists(_dec_file):
                        continue
                    _dfm = frontmatter(_dec_file)
                    if not _dfm:
                        continue
                    _st = (field_vals(_dfm, 'status') or [''])[0]
                    _expected = _bucket_of.get(_st)
                    if _expected is None:
                        continue
                    if did not in (_summ_val(_expected) or []):
                        fails.append(rel + ': decision_approval_summary drift — ' + did + ' status=' + _st + ' ⇒ expected in ' + _expected)
for w in warns: print('WARN: ' + w, file=sys.stderr)
for x in fails: print('FAIL: ' + x)
sys.exit(1 if fails else 0)
PYREC
)"
      if [ $? -eq 0 ]; then
        note "records contract OK (project)"
      else
        printf '%s\n' "$rec_out"
        errors=$((errors + $(printf '%s\n' "$rec_out" | grep -c '^FAIL:')))
      fi
    fi
  fi
fi

# -----------------------------------------------------------------------------
# Check: work-item identity model (P2A, 2026-08-20 — shared-core/rules/work-item-identity.md).
#   toolkit mode → canonical sources present (identity rule, idgen, templates) + idgen self-test.
#   project mode → .ai/toolkit/project.yaml code contract; dual-format ids; duplicate
#   canonical ids; parent resolution; project_code match; display-title rendering
#   (metadata authoritative, display derived); legacy alias uniqueness.
# -----------------------------------------------------------------------------
if [ $C_IDENT -eq 1 ]; then
  echo "--- identity ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    [ -f "$ROOT/shared-core/rules/work-item-identity.md" ] || fail "missing canonical identity rule: shared-core/rules/work-item-identity.md"
    [ -f "$ROOT/bin/project-ai-idgen" ] || fail "missing id minter: bin/project-ai-idgen"
    [ -x "$ROOT/bin/project-ai-idgen" ] || fail "bin/project-ai-idgen is not executable"
    if [ -x "$ROOT/bin/project-ai-idgen" ]; then
      _sfx="$("$ROOT/bin/project-ai-idgen" TASK --suffix 2>/dev/null || true)"
      printf '%s' "$_sfx" | grep -Eq '^[0-9ABCDEFGHJKMNPQRSTVWXYZ]{6}$' \
        || fail "idgen self-test failed (suffix not 6-char Crockford Base32): ${_sfx:-<empty>}"
      "$ROOT/bin/project-ai-idgen" --validate "TASK-${_sfx}" >/dev/null 2>&1 \
        || fail "idgen self-test failed (minted id rejected by its own validator)"
    fi
    note "identity canonical sources present + idgen self-test OK (toolkit)"
  elif ! command -v python3 >/dev/null 2>&1; then
    fail "python3 required for --check-identity in project mode"
  else
    ident_out="$(python3 - "$P" <<'PYIDENT'
import sys, re, pathlib
root = pathlib.Path(sys.argv[1]); ai = root / '.ai'
fails = []; warns = []
NEW_ID     = re.compile(r'^(FEAT|TASK|BUG|SPIKE|REL)-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{6}$')
LEGACY_ID  = re.compile(r'^[A-Z][A-Z0-9]{1,7}-[0-9]{3,}$')
CODE_RE    = re.compile(r'^[A-Z][A-Z0-9]{1,7}$')
TYPE_PREFIX = {'features':'FEAT','tasks':'TASK','bugs':'BUG','spikes':'SPIKE','releases':'REL'}
def frontmatter(path):
    try: txt = path.read_text(encoding='utf-8')
    except OSError: return '', ''
    m = re.match(r'^---\r?\n(.*?)\r?\n---\r?\n?(.*)$', txt, re.S)
    return (m.group(1), m.group(2)) if m else ('', txt)
def fm_val(fm, key):
    m = re.search(r'^'+re.escape(key)+r':\s*(.*)$', fm, re.M)
    if not m: return ''
    v = m.group(1).strip()
    if v.startswith(("'", '"')) and v.endswith(("'", '"')) and len(v) >= 2: return v[1:-1]
    return re.sub(r'\s+#.*$', '', v).strip()
def parse_parent(fm):
    lines = fm.splitlines()
    for i, ln in enumerate(lines):
        if re.match(r'^parent:', ln):
            rest = re.sub(r'#.*$', '', ln.split(':', 1)[1]).strip()
            if rest in ('', 'null', 'None', '~', '{}'):
                blk = []
                for j in range(i + 1, len(lines)):
                    if re.match(r'^\s', lines[j]): blk.append(lines[j].strip())
                    else: break
                mt = re.search(r'^id:\s*([A-Za-z0-9-]+)', '\n'.join(blk), re.M)
                return mt.group(1) if mt else None
            m = re.search(r'id:\s*([A-Za-z0-9-]+)', rest)
            return m.group(1) if m else None
    return None
def fm_list(fm, key):
    m = re.search(r'^'+re.escape(key)+r':\s*\[([^\]]*)\]', fm, re.M)
    if not m: return []
    return [v.strip().strip('\'"') for v in m.group(1).split(',') if v.strip()]
# --- collect records ---------------------------------------------------------
recs = []   # (kind, rel, fm, body, iid)
for kind, pf in TYPE_PREFIX.items():
    d = ai / 'records' / kind
    if not d.is_dir(): continue
    for p in sorted(d.glob('*.md')):
        fm, body = frontmatter(p)
        iid = fm_val(fm, 'id')
        recs.append((kind, 'records/' + kind + '/' + p.name, fm, body, iid))
has_new = any(NEW_ID.match(i or '') for *_, i in recs)
feature_ids = {i for k, *_, i in recs if k == 'features' and i}
# --- 1. project.yaml (SSOT cho project code) ---------------------------------
cfg = ai / 'toolkit' / 'project.yaml'
code = ''
if not cfg.exists():
    if has_new:
        fails.append('missing .ai/toolkit/project.yaml — required once new-format work items exist (P2A work-item-identity.md §1)')
    else:
        warns.append('no .ai/toolkit/project.yaml (pre-P2A project — run project-ai-upgrade to bootstrap; not guessed)')
else:
    cfgtxt = cfg.read_text(encoding='utf-8')
    def cfg_val(key):
        m = re.search(r'^[ \t]*' + re.escape(key) + r':[ \t]*(.*)$', cfgtxt, re.M)
        if not m: return ''
        v = m.group(1).strip()
        if v.startswith(("'", '"')) and v.endswith(("'", '"')) and len(v) >= 2: return v[1:-1]
        return re.sub(r'\s+#.*$', '', v).strip()
    code = cfg_val('code')
    if not code:
        fails.append('.ai/toolkit/project.yaml: missing project.code')
    elif code == 'PENDING':
        warns.append('project code is PENDING — set an explicit code (regex ^[A-Z][A-Z0-9]{1,7}$) in .ai/toolkit/project.yaml before creating new work items; never guessed silently')
        code = ''
    elif not CODE_RE.match(code):
        fails.append('.ai/toolkit/project.yaml: project.code ' + code + ' fails ^[A-Z][A-Z0-9]{1,7}$ (2-8 chars, uppercase)')
    if not cfg_val('name'):
        warns.append('.ai/toolkit/project.yaml: project.name empty')
# --- 2. per-record identity checks -------------------------------------------
seen = {}
legacy_n = 0
for kind, rel, fm, body, iid in recs:
    pf = TYPE_PREFIX[kind]
    if not iid: continue
    if not iid.startswith(pf + '-'):
        fails.append(rel + ': id ' + iid + ' should start with ' + pf + '-')
    if iid in seen:
        fails.append(rel + ': DUPLICATE canonical id ' + iid + ' (also ' + seen[iid] + ') — re-mint the newer item with project-ai-idgen and update its references')
    else:
        seen[iid] = rel
    if NEW_ID.match(iid):
        title = fm_val(fm, 'title')
        pc = fm_val(fm, 'project_code')
        if pc and code and pc != code:
            fails.append(rel + ': project_code ' + pc + ' != project.yaml code ' + code + ' (stale after project-code change — update frontmatter)')
        par = parse_parent(fm)
        if par:
            if not par.startswith('FEAT-'):
                fails.append(rel + ': parent must be a Feature id, got ' + par)
            elif par not in feature_ids:
                fails.append(rel + ': parent feature unresolved: ' + par + ' (no matching record under records/features/)')
        if code and title:
            h1 = next((ln[2:].strip() for ln in body.splitlines() if ln.startswith('# ')), None)
            expected = '[' + code + ']' + ('[' + par + ']' if par else '') + '[' + iid + '] ' + title
            if h1 is None:
                fails.append(rel + ': new-format record missing display title H1 (expected "' + expected + '")')
            elif h1 != expected:
                fails.append(rel + ': display title stale/mismatched — H1 "' + h1 + '" != rendered "' + expected + '" (metadata authoritative; re-render after parent/code/title change)')
    else:
        legacy_n += 1
if legacy_n:
    warns.append(str(legacy_n) + ' legacy-format record(s) grandfathered (display-title + project_code checks skipped — P2A §10)')
# --- 3. legacy_ids aliases ----------------------------------------------------
claims = {}
for kind, rel, fm, body, iid in recs:
    for lid in fm_list(fm, 'legacy_ids'):
        if lid in seen:
            fails.append(rel + ': legacy_ids entry ' + lid + ' collides with a canonical id (' + seen[lid] + ')')
        elif lid in claims and claims[lid] != rel:
            fails.append('legacy id ' + lid + ' claimed by both ' + claims[lid] + ' and ' + rel + ' (exactly one canonical owner per legacy alias)')
        else:
            claims[lid] = rel
# --- 4. legacy tickets/ duplicate numbers ------------------------------------
tdir = ai / 'tickets'
if tdir.is_dir():
    tids = {}
    for p in sorted(tdir.glob('*.md')):
        m = re.match(r'^([A-Z][A-Z0-9]{1,7}-[0-9]{3,})', p.name)
        if not m: continue
        t = m.group(1)
        if t in tids:
            fails.append('tickets/' + p.name + ': duplicate legacy ticket id ' + t + ' (also ' + tids[t] + ')')
        tids[t] = p.name
for w in warns: print('WARN: ' + w)
for x in fails: print('FAIL: ' + x)
sys.exit(1 if fails else 0)
PYIDENT
)"
    if [ $? -eq 0 ]; then
      note "work-item identity contract OK (project)"
    else
      printf '%s\n' "$ident_out"
      errors=$((errors + $(printf '%s\n' "$ident_out" | grep -c '^FAIL:')))
    fi
  fi
fi

# -----------------------------------------------------------------------------
# Check: SpecReadinessGuard. Active/executable work is ALWAYS a hard block;
# inactive/historical legacy artifacts are WARN-only so bulk validation remains
# usable during migration. Plans must identify their behavioral specification.
# DEC-SL018-002 hardening: an ACTIVE ticket must embed its own Mini-Spec (a parent
# Full-Spec reference alone is not the slice's behavioral contract) and must
# carry a plan artifact (## Approach section or a Plan: link under .ai/plans/).
# -----------------------------------------------------------------------------
if [ $C_SPECS -eq 1 ]; then
  echo "--- specs ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    [ -f "$ROOT/shared-core/rules/spec-first.md" ] || fail "missing canonical Spec-First policy"
    grep -q 'NO VALID SPECIFICATION' "$ROOT/shared-core/rules/spec-first.md" || fail "Spec-First policy missing invariant"
    note "Spec-First policy present (toolkit)"
  elif ! command -v python3 >/dev/null 2>&1; then
    fail "python3 required for --check-specs in project mode"
  else
    spec_out="$(python3 - "$P" <<'PYSPEC'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1]); ai = root / '.ai'
fails=[]; warns=[]
active = re.compile(r'^(ready|plannable|planned|implementable|in_progress|active)$', re.I)
required = ['Goal','Expected Behavior','Constraints / Rules','Out of Scope','Acceptance Criteria']
def text(p):
    try: return p.read_text(encoding='utf-8')
    except OSError: return ''
def fm_val(s, name):
    m=re.search(r'^'+re.escape(name)+r':\s*([^#\n]+)',s,re.M)
    return m.group(1).strip().strip('"\'') if m else ''
def emit(path, msg, hard):
    (fails if hard else warns).append(('IMPLEMENTATION BLOCKED — ' if hard else '') + f'{path}: {msg}')
def check_record(p):
    s=text(p); status=fm_val(s,'status'); level=fm_val(s,'specification_level').upper(); ss=fm_val(s,'spec_status').upper(); ref=fm_val(s,'specification_ref')
    hard=bool(active.match(status))
    if level not in ('MINI','FULL'): emit(p, 'missing/invalid specification_level', hard); return
    if ss != 'VALID': emit(p, 'spec_status is not VALID', hard); return
    if level=='MINI':
        for h in required:
            if not re.search(r'^#{2,3}\s+'+re.escape(h)+r'\s*$',s,re.M): emit(p, 'Mini-Spec missing '+h, hard)
    elif not ref or ref.lower() in ('embedded mini-spec','embedded mini spec'):
        emit(p, 'FULL specification_ref is missing', hard)
    else:
        target=(p.parent / ref).resolve()
        if not target.exists() and not (root/ref).exists(): emit(p, 'FULL specification_ref does not resolve: '+ref, hard)
for d in [ai/'records'/'features', ai/'records'/'tasks', ai/'records'/'bugs', ai/'records'/'spikes']:
    if d.is_dir():
        for p in d.glob('*.md'): check_record(p)
for p in (ai/'tickets').glob('*.md') if (ai/'tickets').is_dir() else []:
    s=text(p); hard=bool(re.search(r'^\*?\*?Status:\*?\*?\s*(Ready|Planned|In Progress|Active)',s,re.M|re.I))
    spec_line=re.search(r'^\*?\*?Specification:\*?\*?\s*([^#\n]*)',s,re.M)
    if spec_line is None or spec_line.group(1).strip() in ('','{...}','{spec}'):
        emit(p,'missing Specification reference',hard)
    if '## Mini Spec' in s:
        for h in required:
            if not re.search(r'^#{3,4}\s+'+re.escape(h)+r'\s*$',s,re.M): emit(p,'Mini-Spec missing '+h,hard)
    elif hard:
        emit(p,'active ticket missing embedded Mini Spec (parent Full-Spec reference alone is not the ticket behavioral contract)',hard)
    if hard:
        plan_names=[ln.split('/')[-1] for ln in re.findall(r'plans/[A-Za-z0-9._-]+\.md',s)]
        has_plan_file=any((ai/'plans'/n).exists() for n in plan_names)
        has_approach=bool(re.search(r'^#{2,3}\s+Approach\s*$',s,re.M))
        if not (has_approach or has_plan_file):
            emit(p,'active ticket missing plan artifact (## Approach section, or a Plan: link resolving under .ai/plans/)',hard)
# Spec naming convention (DEC-SL019-001 + P2A dual owner format): SPEC-<OWNER-ID>-<slug>.md
# files must carry a matching "Specification ID: SPEC-<OWNER-ID>" header. OWNER-ID is a
# work-item ID — legacy ABBR-NNN (FEAT-006, SL-019) or new collision-safe TASK-4P8DX2.
# Slug-only legacy files are grandfathered (never matched by the prefix pattern, never checked).
for p in sorted((ai/'specs').glob('*.md')) if (ai/'specs').is_dir() else []:
    mid_file = re.match(r'^(SPEC-(?:(?:FEAT|BUG|REL|SL|TASK)-[0-9]{3,}|(?:FEAT|TASK|BUG|SPIKE|REL)-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{6}))-', p.name)
    if not mid_file:
        continue
    mid_hdr = re.search(r'^Specification ID:\s*([^\s#]+)', text(p), re.M)
    expected_id = mid_file.group(1)
    if mid_hdr is None or mid_hdr.group(1).strip() != expected_id:
        emit(p, 'naming mismatch: filename owner requires header "Specification ID: ' + expected_id + '"', True)
for p in (ai/'plans').glob('*.md') if (ai/'plans').is_dir() else []:
    if not re.search(r'^\|\s*Specification\s*\|\s*[^|{}][^|]*\|',text(p),re.M): emits=fails.append; emits(str(p)+': plan missing required Specification reference')
for x in warns: print('WARN: '+x)
for x in fails: print('FAIL: '+x)
sys.exit(1 if fails else 0)
PYSPEC
)"
    if [ $? -eq 0 ]; then note "SpecReadinessGuard OK (project)"; else printf '%s\n' "$spec_out"; errors=$((errors + $(printf '%s\n' "$spec_out" | grep -c '^FAIL:'))); fi
  fi
fi

# -----------------------------------------------------------------------------
# Check: per-work-item mode / risk-routing contract (Phase 1b). Toolkit-only.
#   core routing/policy files (workflow-modes, risk-categories, escalation)
#   must be free of hard-coded vendor names (RM-04) and workflow-modes.md must
#   not route by effort band (RM-05). Skipped in project mode (project overlay
#   legitimately carries vendor names).
# -----------------------------------------------------------------------------
if [ $C_MODES -eq 1 ]; then
  echo "--- modes ($MODE) ---"
  if [ "$MODE" != "toolkit" ]; then
    note "modes check is toolkit-only (skipped in $MODE mode)"
  else
    _m_before=$errors
    vendor_re='Mollie|VNPAY|Mageplaza|ExtraFee|Hyva|Hyvä|Braintree|PayPal|Klaviyo'
    for f in core/workflow-modes.md core/risk-categories.md core/escalation-rules.md; do
      if [ ! -f "$ROOT/$f" ]; then fail "missing core routing/policy file: $f"; continue; fi
      hits="$(grep -nE "$vendor_re" "$ROOT/$f" 2>/dev/null || true)"
      [ -z "$hits" ] || while IFS= read -r ln; do fail "$f: vendor name in core routing/policy (RM-04): $ln"; done <<< "$hits"
    done
    if [ -f "$ROOT/core/workflow-modes.md" ]; then
      band_re='4[–-]16h|>[[:space:]]*16h|>[[:space:]]*4h|<[[:space:]]*4h'
      hits="$(grep -nE "$band_re" "$ROOT/core/workflow-modes.md" 2>/dev/null || true)"
      [ -z "$hits" ] || while IFS= read -r ln; do fail "core/workflow-modes.md: effort-band router (RM-05): $ln"; done <<< "$hits"
    fi
    [ $errors -eq $_m_before ] && note "core routing/policy generic + effort-free (toolkit)"
  fi
fi

# -----------------------------------------------------------------------------
# Check: durable project state + component index (Phase 1c). Permissive when
#   .ai/project/ absent. Toolkit mode → templates exist. Project mode →
#   COMPONENT_INDEX schema + component-ID resolution (records components: →
#   CMP-* rows) + CURRENT_STATE present + 01-12 verification headers (warn).
# -----------------------------------------------------------------------------
if [ $C_PSTATE -eq 1 ]; then
  echo "--- project-state ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    for t in component-index-template project-current-state-template; do
      [ -f "$ROOT/templates/$t.md" ] || fail "missing Phase 1c template: templates/$t.md"
    done
    [ -f "$ROOT/core/verification-metadata.md" ] || fail "missing core/verification-metadata.md"
    note "Phase 1c project-state templates present (toolkit)"
  else
    PROJ="$P/.ai/project"
    if [ ! -d "$PROJ" ]; then
      note "no .ai/project/ (skipped — legacy project; Phase 1c permissive)"
    else
      [ -f "$PROJ/COMPONENT_INDEX.md" ] || warn ".ai/project/COMPONENT_INDEX.md missing"
      [ -f "$PROJ/CURRENT_STATE.md" ] || warn ".ai/project/CURRENT_STATE.md missing"
      for ctx in "$P/.ai/project-context"/0*_*.md; do
        [ -f "$ctx" ] || continue
        grep -qE '^last_verified:' "$ctx" 2>/dev/null || warn "$(basename "$ctx"): missing verification header (core/verification-metadata.md)"
      done
      if [ -f "$PROJ/COMPONENT_INDEX.md" ] && command -v python3 >/dev/null 2>&1; then
        ps_out="$(python3 - "$P/.ai" <<'PYP'
import sys, os, re
ai = sys.argv[1]
ci = os.path.join(ai, 'project', 'COMPONENT_INDEX.md')
cmp_set = set(re.findall(r'CMP-[A-Za-z0-9_-]+', open(ci, encoding='utf-8').read()))
fails = []
def fm(p):
    t = open(p, encoding='utf-8').read()
    m = re.match(r'^---\r?\n(.*?)\r?\n---(?:\r?\n|$)', t, re.S); return m.group(1) if m else ''
def vals(fmk, key):
    out=[]; block=False
    for line in fmk.splitlines():
        if re.match(r'^'+re.escape(key)+r':', line):
            rest=re.sub(r'#.*$','',line.split(':',1)[1]).strip()
            if rest.startswith('['): out=[v.strip().strip('\'"') for v in rest.strip('[]').split(',') if v.strip()]; block=False
            elif rest=='': block=True
            else: out=[rest.strip().strip('\'"')]; block=False
        elif block:
            if re.match(r'^\s*-\s+', line): out.append(re.sub(r'^\s*-\s*','',line).strip().strip('\'"'))
            elif re.match(r'^[A-Za-z_]', line): block=False
    return out
for kind in ('features','bugs','releases','decisions'):
    d = os.path.join(ai,'records',kind)
    if not os.path.isdir(d): continue
    for fn in sorted(os.listdir(d)):
        if not fn.endswith('.md'): continue
        f = fm(os.path.join(d,fn))
        if not f: continue
        for c in vals(f,'components'):
            m = re.search(r'(CMP-[A-Za-z0-9_-]+)', c)
            if m and m.group(1) not in cmp_set:
                fails.append(kind+'/'+fn+': component ref unresolved: '+m.group(1)+' (not in COMPONENT_INDEX)')
for x in fails: print('FAIL: '+x)
sys.exit(1 if fails else 0)
PYP
)"
        if [ $? -ne 0 ]; then printf '%s\n' "$ps_out"; errors=$((errors + $(printf '%s\n' "$ps_out" | grep -c '^FAIL:'))); else note "component refs resolve to COMPONENT_INDEX"; fi
      fi
    fi
  fi
fi

if [ $C_RSEP -eq 1 ]; then
  echo "--- runtime-separation ($MODE) ---"
  if [ "$MODE" = "toolkit" ]; then
    grep -q "Rule 17c" "$ROOT/generator-rules/output-file-rules.md" || fail "toolkit: output-file-rules Rule 17c (runtime/durable) missing"
    for t in shared-core/navigator/templates/session-state.template.md shared-core/navigator/templates/next-action.template.md shared-core/workflows/current-workflow-state-template.md shared-core/workflows/workflow-history-template.md; do
      [ -f "$ROOT/$t" ] || fail "toolkit: runtime template missing: $t"
    done
    note "Phase 1d runtime-separation contract present (toolkit)"
  else
    if [ ! -d "$P/.ai" ]; then
      note "no .ai/ (skipped — Phase 1d permissive)"
    else
      if [ ! -f "$P/.ai/.gitignore" ]; then
        fail ".ai/.gitignore missing (Phase 1d, RM-02 — runtime must be gitignored)"
      else
        grep -qE "^/runtime/" "$P/.ai/.gitignore" || fail ".ai/.gitignore lacks /runtime/ carve-out (Phase 1d)"
        note ".ai/.gitignore runtime carve-out present"
      fi
      for f in CURRENT_WORKFLOW_STATE.md WORKFLOW_HISTORY.md; do
        [ -f "$P/.ai/workflow/$f" ] && fail ".ai/workflow/$f must live under .ai/runtime/workflow/ (Phase 1d RM-02)"
      done
      for sd in session workflow evidence; do
        [ -d "$P/.ai/runtime/$sd" ] || warn ".ai/runtime/$sd/ missing (recommended by Phase 1d)"
      done
      if command -v git >/dev/null 2>&1 && [ -d "$P/.git" ]; then
        # Check a runtime CONTENT path, not the dir: a committed .gitkeep skeleton makes
        # `check-ignore .ai/runtime/` falsely report "not ignored" (git won't ignore a path
        # with tracked descendants). A content file verifies runtime state is actually ignored.
        git -C "$P" check-ignore -q .ai/runtime/session/NEXT_ACTION.md 2>/dev/null || warn ".ai/runtime/ content not git-ignored (runtime state would be committed)"
      fi
      note "Phase 1d runtime-separation check done (project)"
    fi
  fi
fi

if [ $C_CEFF -eq 1 ]; then
  echo "--- context-efficiency ($MODE) [report] ---"
  if [ "$MODE" = "toolkit" ]; then
    grep -q "single response" "$ROOT/shared-core/functions/function-template.md" && note "function-template same-response guard present" || warn "function-template same-response guard absent"
    [ -f "$ROOT/execution-policy/AGENT_EXECUTION_EFFICIENCY_POLICY.md" ] && note "efficiency policy present" || warn "efficiency policy missing"
