/*
 * Secomm override (BUG-SDZPCD / ext ticket SLP-109):
 * The fee form + AJAX script were extracted from this template into
 * Mageplaza_ExtraFee::hyva/product/view/extra-fee.phtml, rendered by the dedicated
 * `product.info.extrafee` block BELOW the price row (full width) instead of squeezed
 * into the qty/add-to-cart column. Keep the button markup in sync with the module's
 * addtocart.phtml on module upgrades.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);
?>
<button type="submit"
        form="product_addtocart_form"
        title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>"
        class="btn btn-primary"
        id="product-addtocart-button"
        data-addto="cart"
>
    <?= $heroicons->shoppingCartHtml('border-current'); ?>
    <span class="hidden sm:block md:hidden lg:block"><?= $block->getData('is_cart_configure') ?
            $escaper->escapeHtml(__('Update item')) :
            $escaper->escapeHtml(__('Add to Cart')) ?>
    </span>
</button>
<?= $block->getChildHtml('', true) ?>
