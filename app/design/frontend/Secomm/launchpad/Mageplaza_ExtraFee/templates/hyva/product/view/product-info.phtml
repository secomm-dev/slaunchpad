/*
 * Secomm override (BUG-SDZPCD / ext ticket SLP-109):
 * Mageplaza_ExtraFee's layout (hyva_default.xml) forces
 * Mageplaza_ExtraFee::hyva/product/view/product-info.phtml onto the product.info block.
 * That module template is a stale copy of an older Hyvä default theme product-info.phtml
 * and does NOT render the product.info.title child — so the product name is invisible on
 * desktop PDP (the h1 page.main.title is md:sr-only by Hyva design).
 * This override is a verbatim copy of the CURRENT Hyva default theme template:
 * vendor/hyva-themes/magento2-default-theme/Magento_Catalog/templates/product/view/product-info.phtml
 * ExtraFee needs nothing from its own copy (fee UI lives in the product.info.addtocart
 * block, which stays in place). Re-sync this file whenever the Hyva default theme
 * template changes in a composer update.
 *
 * SLP-183 / BUG-KFJ49A (deviation from the verbatim copy): render #qty-messages-<productId>
 * below the price/qty/button row — message container cho validation qty (quantity.phtml trỏ
 * data-validation-container về đây). Không có container ngoài row này, hyva.formValidation
 * tự wrap input qty vào <div class="field field-reserved"> trong row → input lệch 4px so với
 * button (margin-top của .field) và message bị ép vào cột hẹp giữa giá và button.
 * quantity.phtml chỉ render trong block product.info.quantity (con của template này — cùng
 * duy nhất trên catalog_product_view, gồm cart configure), nên container luôn tồn tại khi
 * input qty có mặt.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductAttributes;
use Hyva\Theme\ViewModel\ProductCompare;
use Hyva\Theme\ViewModel\ProductPage;
use Hyva\Theme\ViewModel\Wishlist;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);

/** @var ProductAttributes $attributesViewModel */
$attributesViewModel = $viewModels->require(ProductAttributes::class);

/** @var Product $product */
$product = $productViewModel->getProduct();
$productType = $product->getTypeId();

?>
<div class="card mb-6">
    <?= $block->getChildHtml('product.info.title') ?>

    <div class="my-2 flex">
        <?= $block->getChildHtml('product.info.review') ?>
    </div>

    <?php if ($shortDescription = $productViewModel->getShortDescription()): ?>
        <div class="my-4 leading-relaxed product-description prose"><?= /* @noEscape */ $shortDescription ?></div>
    <?php endif; ?>

    <div class="flex flex-col sm:flex-row justify-between my-4">
        <div class="inline-flex flex-wrap items-center gap-x-6">
            <?= $block->getChildHtml("product.info.stockstatus") ?>
            <?= $block->getChildHtml("product.info.stockqty") ?>
        </div>
        <?= $block->getChildHtml("alert.urls") ?>
    </div>

    <dl id="product-details">
        <?php foreach ($block->getAttributes() as $attributeConfig):
            $attribute = $attributesViewModel->getAttributeFromLayoutConfig($attributeConfig); ?>
            <?php if ($value = $attribute['value'] ?? null): ?>
                <div class="flex border-t border-gray-300 py-2 last:mb-6 last:border-b attribute-<?=/* @noEscape */ $attribute['code'] ?: "" ?>">
                    <dt class="w-1/2 text-left text-gray-700 product-detail-label">
                        <?= $escaper->escapeHtml($attribute['label']) ?>
                    </dt>
                    <dd class="w-1/2 ml-2 text-left text-gray-900 product-detail-value">
                        <?= $escaper->escapeHtml($value) ?>
                    </dd>
                </div>
            <?php endif ?>
        <?php endforeach; ?>
    </dl>

    <?= $block->getChildHtml('product.info.form') ?>

    <div class="flex flex-col sm:flex-row items-end my-4">

        <?php if ($productType === 'bundle'): ?>
            <span class="sr-only">
                <?= $escaper->escapeHtml(__('The price depends on the chosen options')) ?>
            </span>
        <?php endif; ?>

        <div role="group" aria-label="<?= $escaper->escapeHtmlAttr('Price') ?>">
            <?= $block->getChildHtml("product.info.price") ?>
        </div>

        <div class="flex gap-2 mt-4 ml-auto sm:mt-0">
            <?php if ($product->isSaleable()): ?>
                <?= $block->getChildHtml("product.info.quantity") ?>
                <?= $block->getChildHtml("product.info.addtocart") ?>
            <?php endif; ?>
        </div>

    </div>

    <?php /* SLP-183 / BUG-KFJ49A: message container cho validation qty — see header comment */ ?>
    <?php if ($product->isSaleable()): ?>
        <div id="qty-messages-<?= (int) $product->getId() ?>"></div>
    <?php endif; ?>

    <?php /* BUG-SDZPCD / SLP-109: extra fee block full-width below the price row */ ?>
    <?= $block->getChildHtml('product.info.extrafee') ?>

    <?php if ($product->isSaleable() && $block->getChildHtml('addtocart.shortcut.buttons')): ?>
        <div class="flex mt-4 justify-end">
            <?= $block->getChildHtml('addtocart.shortcut.buttons') ?>
        </div>
    <?php endif; ?>

    <?php if ($additionalActions = $block->getChildHtml('product.info.additional.actions')): ?>
        <div class="flex mt-4 justify-end">
            <?= /** @noEscape */ $additionalActions; ?>
        </div>
    <?php endif; ?>

    <?php if ($tierPriceBlock = $block->getChildHtml("product.price.tier")): ?>
        <div class="py-4 my-2 tier-price-container">
            <?= /** @noEscape */ $tierPriceBlock ?>
        </div>
    <?php endif; ?>

    <?= $block->getChildHtml("product.info.additional") ?>
</div>
