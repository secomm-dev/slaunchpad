                this.onOpenPopup();
            }, 50);
        }.bind(this);

        window.hideMyDialog = function (event) {
            this.hide('my-dialog', event);
        }.bind(this);
    },
    onOpenPopup() {
      scrollButtonContent();
        document.body.classList.forEach(className => {
            if (className === 'overflow-hidden') {
                document.body.classList.remove('overflow-hidden');
            }
        });
    }
}" x-init="init()">
