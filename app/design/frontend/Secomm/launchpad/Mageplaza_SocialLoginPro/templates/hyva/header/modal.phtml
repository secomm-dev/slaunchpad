<div id="test" style="display: none; height: 100vh">
    <div id="social-login-popup" data-df="" style="transform: translateY(<?php /* @escapeNotVerified */
    echo $translateYvalue ?>)" class="white-popup mfp-with-anim"
         data-mage-init='{"socialPopupForm": <?= /* @noEscape */
         $block->getFormParams() ?>}'>
        <button title="Close (Esc)" type="button" class="mfp-close" onclick="closeModal()">×</button>

        <?= /* @noEscape */
        $block->getChildHtml('popup.email') ?>
        <div class="mp-social-popup col-mp mp-7" style="padding-top: <?= $popupLogin === 'popup_slide' ? '0px' : '15px' ?>;">
            <?= /* @noEscape */
            $block->getChildHtml('popup.authentication') ?>
            <?= /* @noEscape */
            $block->getChildHtml('popup.create') ?>
            <?= /* @noEscape */
            $block->getChildHtml('popup.forgot') ?>
        </div>
        <?= /* @noEscape */
        $block->getChildHtml('popup.authentication.social') ?>
        <?= /* @noEscape */
        $block->getChildHtml('popup.additional.info') ?>
