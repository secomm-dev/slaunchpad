</div>
<script type="text/javascript">
    let popup = ``;

    function showMyDialog () {
        const modal = document.querySelector('.wrap-modal-login');
        modal.classList.remove('hidden');
        modal.classList.remove('<?= /* @noEscape */ $popupEffect ?>-disappear');
        modal.classList.add('<?= /* @noEscape */ $popupEffect ?>-appear');
    }

    function handleHideModalClickOutSide () {
        let popup_test = document.getElementById("popup_test");
        let test       = document.getElementById("test");

        test.style.display = 'block';
        popup_test.append(test);

        popup_test.addEventListener('click', function (e) {
            if (e.target === test) {
                const modal = document.querySelector('.wrap-modal-login');
                modal.classList.remove('<?= /* @noEscape */ $popupEffect ?>-appear');
                modal.classList.add('<?= /* @noEscape */ $popupEffect ?>-disappear');
                setTimeout(() => {
                    modal.classList.remove('<?= /* @noEscape */ $popupEffect ?>-disappear');
                    hideMyDialog();
                }, <?= /* @noEscape */ $closeTime ?>);
            }
        });
        popup_test.addEventListener('click', function (e) {
            if (e.target === popup_test) {
                showMyDialog();
            }
        });
    }

    handleHideModalClickOutSide();

    function closeModal () {
        const modal = document.querySelector('.wrap-modal-login');
        modal.classList.remove('<?= /* @noEscape */ $popupEffect ?>-appear');
        modal.classList.add('<?= /* @noEscape */ $popupEffect ?>-disappear');
        setTimeout(() => {
            modal.classList.remove('<?= /* @noEscape */ $popupEffect ?>-disappear');
            hideMyDialog();
        }, <?= /* @noEscape */ $closeTime ?>);
    }

    function changePositionLeft (form) {
        form.classList.add('mp-7');
        form.classList.remove('mp-12');
        form.classList.add('login-right');
    }

    function changeResponsive (social, loginForms, socialBtns) {
        social.classList.add('mp-12');
        social.classList.remove('mp-6');
        loginForms.forEach(loginForm => {
            loginForm.classList.add('mp-12');
            loginForm.classList.remove('mp-7');
        });
        socialBtns.forEach(function (socialBtn) {
            if(window.innerWidth < 768){
                socialBtn.classList.add('col-mp');
                socialBtn.classList.add('mp-12');
            } else {
                socialBtn.classList.add('col-mp');
                socialBtn.classList.add('mp-6');
            }
            socialBtn.style.borderTopWidth = '0px';
            socialBtn.style.setProperty('border-top-width', '0px', 'important');
            socialBtn.style.setProperty('max-width', '260px', 'important');
        });
    }

    function initQuickLogin () {
        const modal = document.querySelector('.wrap-modal-login');
        modal.classList.add('quick-login');

        modal.querySelectorAll('.mp-5, .mp-3, .mp-7').forEach(el => {
            el.classList.remove('mp-5', 'mp-3', 'mp-7');
            el.classList.add('mp-12');
        });

        modal.querySelectorAll('.actions-toolbar.social-btn').forEach(el => {
            if(window.innerWidth < 768){
                if (!el.classList.contains('mp-12')) {
                    el.classList.add('mp-12');
                }
            } else {
                if (!el.classList.contains('mp-5')) {
                    el.classList.add('mp-5');
                }
            }
        });
        const fixedWrapper = modal.closest('.fixed');
        if (fixedWrapper) {
            fixedWrapper.classList.remove('fixed');
        }

        document.querySelectorAll('.white-popup').forEach(popupTop => {
            popupTop.style.setProperty("transform", "translateY(0%)", "important");
        })
        document.querySelector('.form-customer-create').classList.add('mp-12');
        document.querySelector('.form-customer-login').classList.add('mp-12');
    }


    function initModal (element, options) {
        element.classList.add(options.modalClass);

        let trigger = document.querySelector(options.trigger);
        if (trigger) {
            trigger.addEventListener("click", function () {
                element.style.display = "block";
            });
        }
    }

    function createPopupSlide () {
        let modal       = document.createElement("div");
        modal.className = options.modalClass;
        wrapper.appendChild(modal);

        document.querySelector(".social-login-btn").addEventListener("click", function () {
            wrapper.classList.add("active");
            modal.style.zIndex = 102;
        });

        document.addEventListener("click", function (event) {
            if (!wrapper.contains(event.target) && !document.querySelector(".social-login-btn").contains(event.target)) {
                wrapper.classList.remove("active");
            }
        });
    }

    function initPopupSlide () {
        const modal = document.querySelector('.wrap-modal-login');
        modal.classList.add('slider-modal');

        modal.querySelectorAll('.mp-5, .mp-3, .mp-7').forEach(el => {
            el.classList.remove('mp-5', 'mp-3', 'mp-7');
            el.classList.add('mp-12');
        });

        modal.querySelectorAll('.actions-toolbar.social-btn').forEach(el => {
            if(window.innerWidth < 768){
                if (!el.classList.contains('mp-12')) {
                    el.classList.add('mp-12');
                }
            } else {
                if (!el.classList.contains('mp-5')) {
                    el.classList.add('mp-5');
                }
            }
        });

        modal.querySelectorAll('.block-content').forEach(el => {
            if (!el.classList.contains('mp-12')) {
                el.classList.add('mp-12');
            }
        });
        let element = document.querySelector("#social-login-popup .block.social-login-authentication-channel .block-content");
        if (element) {
            element.style.display  = "flex";
            element.style.flexWrap = "wrap";
        }
        if(window.innerWidth < 768){
            document.querySelectorAll('.white-popup').forEach(popupTop => {
                popupTop.style.setProperty("transform", "translateY(0%)", "important");
            })
            document.querySelector(".white-popup").style.setProperty("bottom", "0%", "important");
        }
        modal.classList.remove('mfp-newspaper-appear', 'mfp-newspaper-disappear');
        modal.classList.add('mfp-newspaper-appear-slider');
    }

    function scrollButtonContent() {
        const blockContainers = document.querySelectorAll('.social-login.block-container');

        blockContainers.forEach(container => {
            if (window.getComputedStyle(container).display !== 'none') {
                const blockContent = container.querySelector('.block-content');
                const popupContent = document.querySelector('#mp-popup-social-content .block-content');

                let popupLogin = "<?= /* @noEscape */ $btnPosition ?>".trim();

                if (blockContent && popupContent) {
                    let blockContentHeight = blockContent.offsetHeight || blockContent.scrollHeight;

                    const isMobile = window.innerWidth <= 768;
                    const isLimited = isMobile || popupLogin === 'top' || popupLogin === 'bottom';
                    let popupType = '<?= /* @noEscape */ $popupLogin ?>';
                    if (isLimited) {
                        blockContentHeight = Math.min(blockContentHeight, 190);
                    }

                    if (blockContentHeight > 25) {
                        if (popupType === 'popup_slide' && window.innerWidth > 768) {
                            blockContentHeight= '300';
                        }
                        popupContent.style.maxHeight = `${blockContentHeight - 25}px`;
                        popupContent.style.overflow = 'auto';
                    }
                }
            }
        });
    }


    function changeSocialBtnPosition () {
        let btnPosition  = "<?= /* @noEscape */ $btnPosition ?>";
        let social       = document.querySelector("#social-login-popup .block.social-login-authentication-channel");
        let loginForms   = document.querySelectorAll("#social-login-popup .block.social-login-customer-authentication");
        let createForms  = document.querySelectorAll('.social-login.block-container.create .block');
        let forgotForms  = document.querySelectorAll('.social-login.block-container.forgot .block');
        let socialBtn    = document.querySelectorAll("#social-login-popup .actions-toolbar.social-btn");
        let socialPopups = document.querySelectorAll('.mp-social-popup');

        if (btnPosition !== "" && social && loginForms.length > 0) {
            document.querySelectorAll('.white-popup').forEach(popupTop => {
                popupTop.style.setProperty("transform", "translateY(7%)", "important");
            })
            switch (btnPosition){
                case "left":
                    if (window.innerWidth < 768) {
                        break;
                    }
                    document.querySelector('#mp-popup-social-content').classList.add('social-left');
                    social.classList.remove('mp-5');
                    loginForms.forEach(loginForm => {
                        changePositionLeft(loginForm);
                    });
                    createForms.forEach(createForm => {
                        changePositionLeft(createForm);
                    });
                    forgotForms.forEach(forgotForm => {
                        changePositionLeft(forgotForm);
                    });
                    socialPopups.forEach(socialPopup => {
                        socialPopup.classList.add('mp-12');
                    });
                    break;
                case "top":
                    if (window.innerWidth < 768) {
                        break;
                    }
                    social.classList.add('social-top');
                    loginForms.forEach(loginForm => {
                        loginForm.classList.add('login-bottom');
                    });
                    socialPopups.forEach(socialPopup => {
                        socialPopup.classList.add('mp-12');
                        socialPopup.classList.remove('mp-7');
                    });
                    createForms.forEach(createForm => {
                        createForm.classList.add('login-bottom');
                    });
                    forgotForms.forEach(forgotForm => {
                        forgotForm.classList.add('login-bottom');
                    });
                    changeResponsive(social, loginForms, socialBtn);
                    break;
                case "bottom":
                    if (window.innerWidth < 768) {
                        break;
                    }
                    if(window.innerWidth > 768){
                        document.querySelectorAll('.white-popup').forEach(popupTop => {
                            popupTop.style.setProperty("transform", "translateY(5%)", "important");
                        })
                    }
                    changeResponsive(social, loginForms, socialBtn);
                    break;
                default:
                    break;
            }
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        let popupLogin = "<?= /* @noEscape */ $popupLogin ?>";

        switch (popupLogin){
            case 'popup_login':
                changeSocialBtnPosition();
                break;
            case 'quick_login':
                initQuickLogin();
                break;
            case 'popup_slide':
                initPopupSlide();
                break;
            default:
                break;
        }
    });

</script>
