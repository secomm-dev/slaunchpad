 *
 * TASK-QX93G3 (SLP-158): Secomm/launchpad override of the vendor cart page root.
 * Verbatim copy of vendor/hyva-themes/magento2-default-theme/Magento_Checkout/templates/cart-main.phtml
 * with ONLY this addition: hyva.postCart dispatches `reload-customer-section-data`
 * in .finally, so the cart drawer picks up cart-page coupon/qty/gift changes
 * (vendor postCart replaces #maincontent without refreshing customer-data sections;
 * dispatched in finally because the replace can abort on pre-existing inline-script
 * conflicts on this page). The cart page coupon form itself is overridden separately
 * (php-cart/coupon.phtml) to a native submit round-trip for a deterministic sync.
 * Keep this file a minimal diff against the vendor template when upgrading Hyvä.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Cart\CheckoutConfig;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Checkout\Block\Cart;
use Magento\Framework\Escaper;

/** @var Cart $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

/** @var CheckoutConfig $checkoutConfigViewModel */
$checkoutConfigViewModel = $viewModels->require(CheckoutConfig::class);
$serializedCheckoutConfig =  $block->getItemsCount() ? $checkoutConfigViewModel->getSerializedCheckoutConfig() : 'false';

?>
<script>
    window.checkoutConfig = null;
    window.customerData = {};
    window.isCustomerLoggedIn = false;

    (function( hyva, undefined ) {

        let controller = new AbortController();

        /**
         * Takes a form element and submits it through fetch,
         * then replaces the result into the document without
         * refreshing the page
         */
        hyva.postCart = (form) => {
            if (!form.action) {
                return;
            }
            window.dispatchEvent(new CustomEvent("cart-is-loading", { detail: {
                isLoading: true
            }}));
            controller.abort();
            controller = new AbortController();

            const action = form.action;
            const formData = new FormData(form);

            if (!formData.uenc) {
                formData.append('uenc', hyva.getUenc());
            }

            formData.append('form_key', hyva.getFormKey());

            window.fetch(action, {
                method: 'POST',
                body: formData,
                signal: controller.signal
            }).then((result) => {
                return result.text()
            }).then((content) => {

                hyva.replaceDomElement('#maincontent', content)

            }).catch((error) => {
                if (error.name !== 'AbortError') {
                    console.error(error);
                    typeof window.dispatchMessages !== "undefined" && window.dispatchMessages(
                        [{
                            type: "error",
                            text: "<?= $escaper->escapeJs(__("Something went wrong. Please try again.")) ?>"
                        }], 10000
                    );
                }
            }).finally(() => {
                // Dispatched in finally (not after replaceDomElement): the drawer must
                // pick up cart-page coupon/qty changes even when the content replace
                // aborts on pre-existing inline-script conflicts.
                window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                window.dispatchEvent(new CustomEvent('cart-is-loading', {
                    detail: {isLoading: false}
                }))
            })
        }
    }( window.hyva = window.hyva || {} ));

    /*
     * TASK-K14RVZ (SLP-217): translate browser-native HTML5 validation messages
     * on cart item qty inputs. "Please fill out this field." / "Value must be
     * less than or equal to 10000." are generated by the BROWSER (locale of the
     * browser UI), not by Magento — CSV/js-translation.json can never cover
     * them. The `invalid` event does not bubble, so a capture-phase listener on
     * `document` swaps in a server-translated message (`__()` above) via
     * setCustomValidity, and `input`/`change` clear it again so a corrected
     * value submits normally. Hanging off `document` (guarded, idempotent)
     * keeps it alive across hyva.replaceDomElement('#maincontent').
     *
     * The handler must NOT preventDefault() and must NOT call reportValidity():
     * reportValidity() fires its own cancelable `invalid` event, which this
     * listener would cancel too — a canceled report shows no bubble, so the
     * user sees NO validation at all (regression found in live QC 09-16).
     * Instead: the browser fires `invalid` BEFORE rendering its bubble, so the
     * custom validity set here is what gets displayed (MDN constraint
     * validation pattern). Form submission stays blocked by the invalid
     * control regardless of event handling.
     */
    (function( hyva, undefined ) {
        if (window.secommCartQtyValidationMessages) return;
        window.secommCartQtyValidationMessages = true;

        const messages = {
            valueMissing: "<?= $escaper->escapeJs(__('Please fill out this field.')) ?>",
            rangeOverflow: "<?= $escaper->escapeJs(__('Value must be less than or equal to %1.')) ?>",
            rangeUnderflow: "<?= $escaper->escapeJs(__('Value must be greater than or equal to %1.')) ?>",
            patternMismatch: "<?= $escaper->escapeJs(__('Please match the format requested.')) ?>",
            stepMismatch: "<?= $escaper->escapeJs(__('Please enter a valid value.')) ?>",
            badInput: "<?= $escaper->escapeJs(__('Please enter a valid number.')) ?>"
        };

        const qtyInputMessage = (input) => {
            const validity = input.validity;
            if (validity.valueMissing) return messages.valueMissing;
            if (validity.rangeOverflow) return messages.rangeOverflow.replace('%1', input.max);
            if (validity.rangeUnderflow) return messages.rangeUnderflow.replace('%1', input.min);
            if (validity.patternMismatch) return messages.patternMismatch;
            if (validity.stepMismatch) return messages.stepMismatch;
            if (validity.badInput) return messages.badInput;
            return '';
        };

        const isQtyInput = (target) => target instanceof HTMLInputElement
            && target.matches('[data-role="cart-item-qty"]');

        document.addEventListener('invalid', (event) => {
            if (!isQtyInput(event.target)) return;
            const message = qtyInputMessage(event.target);
            if (!message) return;
            event.target.setCustomValidity(message);
        }, true);

        const clearCustomValidity = (event) => {
            if (isQtyInput(event.target)) event.target.setCustomValidity('');
        };
        document.addEventListener('input', clearCustomValidity);
        document.addEventListener('change', clearCustomValidity);
    }( window.hyva = window.hyva || {} ));

    function initCartForm() {
        let cartIsReloading = false;

        return {
            cartIsEmpty: true,
            isLoading: false,
            init() {
                window.checkoutConfig = JSON.parse(this.$root.dataset.checkoutConfig);
                window.customerData = window.checkoutConfig.customerData;
                window.isCustomerLoggedIn = window.checkoutConfig.isCustomerLoggedIn;

                this.cartIsEmpty = window.checkoutConfig === false;
            },
            checkCartShouldUpdate() {
                const cart = this.$event.detail.data.cart;
                if (!cart) return;

                const cartIsEmptyState = window.checkoutConfig === false;
                if (this.cartIsEmpty !== cartIsEmptyState) {
                    this.cartIsEmpty = cartIsEmptyState;
                    this.reloadCartContent();
                    return;
                }

                if (this.cartIsEmpty) return;

                if (!cart.items) {
                    this.reloadCartContent();
                    return;
                }

                if (!window.checkoutConfig && cart.items.length) {
                    this.reloadCartContent();
                    return;
                }

                const roundUp = (number) => Math.round(number * 1000);
                const decimalNumbersAreEqual = (number1, number2) => roundUp(number1) === roundUp(number2);

                if (decimalNumbersAreEqual(
                    cart.items.reduce((totalQty, cartItem) => totalQty + cartItem.qty, 0),
                        window.checkoutConfig.quoteData.items_qty
                    ) &&
                    decimalNumbersAreEqual(
                        cart.subtotalAmount,
                        window.checkoutConfig.totalsData.total_segments.find((segment) => segment.code === "subtotal").value
                    )
                ) {
                    return;
                }

                this.reloadCartContent();
            },
            reloadCartContent() {
                if (cartIsReloading) return;
                cartIsReloading = true;

                window.fetch(window.location.href, {
                    method: "GET"
                })
                .then((result) => result.text())
                .then((body) => {
                    hyva.setCookie('mage-cache-sessid', '', -1, true);
                    window.checkoutConfig = null;
                    hyva.replaceDomElement('#maincontent', body)

                })
                .catch(() => {
                    if (window.location.search.indexOf('reload=1') > -1) return;
                    window.location = window.location + (window.location.search.length < 1 ? '?' : '&') + 'reload=1'
                })
                .finally(() => {
                    cartIsReloading = false;
                })
            },
            onStorageChange() {
                if (this.$event.key === 'private_content_version') {
                    window.dispatchEvent(new CustomEvent("reload-customer-section-data"));
                }
            },
            onCartIsLoading() {
                this.isLoading = (this.$event.detail && this.$event.detail.isLoading) || false
            },
            proceedToCheckout() {
                this.$dispatch('toggle-authentication', { url: this.$el.href });
            },
            postCart() {
                hyva.postCart(this.$event.target)
            },
            removeItem() {
                hyva.postForm(JSON.parse(this.$el.dataset.deletePostJson));
                this.$dispatch('cart-item-removed', [JSON.parse(this.$el.dataset.cartItemRemovedPayload)]);
            },
            moveToWishlist() {
                hyva.postForm(JSON.parse(this.$el.dataset.postForm));
            }
        }
    }
    window.addEventListener('alpine:init', () => Alpine.data('initCartForm', initCartForm), { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>
<section
    x-data="initCartForm"
    class="cart-form"
    aria-label="<?= $escaper->escapeHtmlAttr(__('Shopping Cart')) ?>"
    @private-content-loaded.window="checkCartShouldUpdate"
    @storage.window="onStorageChange"
    @cart-is-loading.window="onCartIsLoading"
    data-checkout-config="<?= $escaper->escapeHtmlAttr($serializedCheckoutConfig) ?>"
>
    <?php if ($block->getItemsCount()): ?>
        <?= $block->getChildHtml('with-items') ?>
    <?php else: ?>
        <?= $block->getChildHtml('no-items') ?>
    <?php endif; ?>
    <?= $block->getChildHtml('loading') ?>
</section>
