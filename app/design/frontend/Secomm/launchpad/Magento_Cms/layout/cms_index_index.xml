<?xml version="1.0"?>
<!--
    Secomm Launchpad — Homepage (TASK-0NNZCW, SLP-213)
    Layout mock-up sections per design upload. Header/footer keep the current theme.
    Quick View modal (TASK-Z3DAH5, SLP-157) stays wired for product cards.
-->
<page xmlns:xsi="http://www.w3.org/2000/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove Hyv&auml; default-theme demo content (hero + demo product sliders) —
             replaced by the mock-up sections below (TASK-0NNZCW, SLP-213). -->
        <referenceBlock name="hero" remove="true"/>
        <referenceBlock name="slider-1" remove="true"/>
        <referenceBlock name="slider-2" remove="true"/>
        <referenceContainer name="content">
            <block
                class="Magento\Framework\View\Element\Template"
                name="quickview.modal"
                template="Magento_Theme::html/quickview/modal.phtml"
                after="-"
                ifconfig="hyva_theme_quickview/general/enabled"
            />
            <!--
              TASK-S0EZG9 (SLP-293): floating Back to Top button (bottom-right,
              appears past one viewport height). Homepage-only per ticket scope.
            -->
            <block
                class="Magento\Framework\View\Element\Template"
                name="back-to-top"
                template="Magento_Theme::html/back-to-top.phtml"
                after="-"
            />
        </referenceContainer></body>
</page>
