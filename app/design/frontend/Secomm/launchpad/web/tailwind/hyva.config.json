{
  "notice": [
    "This is a complementary config file for Tailwind v4 and is not a replacement for the Tailwind v3 config file.",
    "For usage, see the docs: https://docs.hyva.io/hyva-themes/working-with-tailwindcss/using-hyva-modules/"
  ],
  "tailwind": {
    "include": [
      {
        "comment": "Scan parent theme Hyva/default templates so Tailwind generates the md/lg utilities the storefront renders",
        "src": "vendor/hyva-themes/magento2-default-theme"
      },
      {
        "comment": "Scan Secomm VietQr templates",
        "src": "app/code/Secomm/VietQr"
      }
    ],
    "exclude": []
  },
  "tokens": {
    "values": {
      "color": {
        "primary": "var(--ds-bg-brand-solid-primary)",
        "primary-lighter": "var(--ds-bg-brand-solid-tertiary)",
        "primary-darker": "var(--ds-bg-brand-solid-quinary)",
        "secondary": "var(--ds-bg-brand-solid-secondary)",
        "on-primary": "var(--ds-text-white)",
        "on-secondary": "var(--ds-text-brand-primary)"
      }
    }
  }
}
