<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\StoreConfig;
use Hyva\Theme\ViewModel\SvgIcons;
use Launchpad\SnowdogMenu\ViewModel\Config as SnowdogNavigationConfig;
use Magento\Checkout\Block\Cart\Sidebar as SidebarCart;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Secomm\ThemeHelper\ViewModel\HeaderConfig;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$icons = $viewModels->require(SvgIcons::class);
$storeConfig = $viewModels->require(StoreConfig::class);
$headerConfig = $viewModels->require(HeaderConfig::class);
$snowdogNavigation = $viewModels->require(SnowdogNavigationConfig::class);
$showMiniCart = $storeConfig->getStoreConfig(SidebarCart::XML_PATH_CHECKOUT_SIDEBAR_DISPLAY);
$showWishlist = $block->getShowWishlist() !== null ? (bool) $block->getShowWishlist() : true;
$showLanguage = $block->getShowLanguage() !== null ? (bool) $block->getShowLanguage() : true;
$stickyEnabled = $headerConfig->isStickyEnabled();
$snowdogNavigationEnabled = $snowdogNavigation->isEnabled();
?>
<script>
    function initLaunchpadHeader() {
        return {
            searchOpen: false,
            cart: {},
            customer: {},
            isCartOpen: false,
            isHomepage: false,
            isScrolled: false,
            stickyEnabled: <?= $stickyEnabled ? 'true' : 'false' ?>,
            init() {
                this.isHomepage = document.body.classList.contains('cms-index-index')
                this.applyHeaderPosition()
                this.updateScrollState()
                this.$nextTick(() => this.applyMenuTriggerIcon())
            },
            applyHeaderPosition() {
                const pageHeader = this.$root.parentElement
                if (!pageHeader) return

                pageHeader.classList.add('top-0', 'z-50', 'w-full')
                if (this.isHomepage) {
                    pageHeader.classList.add(this.stickyEnabled ? 'fixed' : 'absolute')
                } else if (this.stickyEnabled) {
                    pageHeader.classList.add('sticky')
                }
            },
            globalMessage() {
                return [...document.querySelectorAll('.message.global')].find((message) => {
                    const style = window.getComputedStyle(message)
                    return style.display !== 'none' && style.visibility !== 'hidden' && message.offsetHeight > 0
                })
            },
            updateHeaderOffset(globalMessage = this.globalMessage()) {
                if (!this.isHomepage) return

                const pageHeader = this.$root.parentElement
                if (!pageHeader) return

                const offset = !globalMessage
                    ? 0
                    : (this.stickyEnabled
                        ? Math.max(0, globalMessage.getBoundingClientRect().bottom)
                        : globalMessage.offsetHeight)
                pageHeader.style.top = `${offset}px`
            },
            applyMenuTriggerIcon() {
                const trigger = this.$refs.menuHost?.querySelector(
                    '[x-ref="open-menu-button"], div.lg\\:hidden > button:first-of-type'
                )
                const icon = this.$refs.menuIcon?.content.firstElementChild?.cloneNode(true)
                if (trigger && icon) {
                    // Mobile/Tablet Header contract: every action is a 40x40
                    // target with a centered 24px glyph (node 2115:5849).
                    trigger.classList.add(
                        'flex',
                        'h-10',
                        'w-10',
                        'items-center',
                        'justify-center',
                        'btn-transparent',
                        '[--btn-icon-size:24px]!',
                        '[--btn-color:currentColor]!'
                    )
                    trigger.replaceChildren(icon)
                }
            },
            updateScrollState() {
                const globalMessage = this.globalMessage()
                const stickyThreshold = Math.max(8, globalMessage?.offsetHeight || 0)
                this.isScrolled = window.scrollY >= stickyThreshold
                this.updateHeaderOffset(globalMessage)
            },
            isContextual() {
                return this.isHomepage && !this.isScrolled
            },
            getData(data) {
                this.cart = data.cart ?? {}
                this.customer = data.customer ?? {}
            },
            summaryCount() {
                return this.cart.summary_count || 0
            },
            isCartEmpty() {
                return !this.summaryCount()
            },
            cartAriaLabel() {
                return '<?= $escaper->escapeJs($showMiniCart ? __('Toggle minicart') : __('View cart')) ?>, ' +
                    (this.isCartEmpty() ? '<?= $escaper->escapeJs(__('Cart is empty')) ?>' : (
                        Math.abs(this.summaryCount()) > 1
                            ? hyva.str('<?= $escaper->escapeJs(__('%1 items')) ?>', this.summaryCount())
                            : hyva.str('<?= $escaper->escapeJs(__('%1 item')) ?>', this.summaryCount())
                    ))
            },
            openCart() {
                this.isCartOpen = true
                this.$dispatch('toggle-cart', {isOpen: true})
            },
            syncCartState(event) {
                if (event.detail?.isOpen === undefined) return
                this.isCartOpen = event.detail.isOpen
                if (!this.isCartOpen) this.$nextTick(() => this.$refs.cartButton?.focus())
            },
            toggleSearch() {
                this.searchOpen = !this.searchOpen
                if (this.searchOpen) this.$dispatch('search-open')
            },
            closeSearch(restoreFocus = false) {
                this.searchOpen = false
                if (restoreFocus) this.$nextTick(() => this.$refs.searchButton?.focus())
            },
            isMac: /Mac|iPod|iPhone|iPad/.test(navigator.platform),
            searchShortcut(event) {
                if ((this.isMac ? event.metaKey : event.ctrlKey) && event.key === 'k') {
                    event.preventDefault()
                    this.searchOpen = true
                    this.$dispatch('search-open')
                }
            }
        }
    }

    function initWishlistHeader() {
        return {
            itemCount: 0,
            receiveWishlistData(data) {
                this.itemCount = data.wishlist?.items?.length || 0
            },
            linkAriaLabel() {
                const label = this.itemCount === 1
                    ? '<?= $escaper->escapeJs(__('%1 item')) ?>'
                    : '<?= $escaper->escapeJs(__('%1 items')) ?>'
                return `<?= $escaper->escapeJs(__('My Wish List')) ?>, ${hyva.str(label, this.itemCount)}`
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initLaunchpadHeader', initLaunchpadHeader)
        Alpine.data('initWishlistHeader', initWishlistHeader)
    }, {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>

