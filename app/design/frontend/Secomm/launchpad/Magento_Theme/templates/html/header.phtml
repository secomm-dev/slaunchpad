            </button>

            <?= $block->getChildHtml('additional') ?>
            <?= $block->getChildHtml('customer') ?>

            <?php if ($showWishlist): ?>
                <?= $block->getChildHtml('wishlist') ?>
            <?php endif; ?>

            <?php if ($showMiniCart): ?>
                <button
                    id="menu-cart-icon"
                    type="button"
                    class="btn btn-transparent relative h-10 shrink-0 px-2 [--btn-icon-size:24px]! [--btn-color:currentColor]!"
