            <?php else: ?>
                <a
                    id="menu-cart-icon"
                    class="btn btn-transparent relative h-10 shrink-0 px-2 [--btn-icon-size:24px]! [--btn-color:currentColor]!"
                    href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart/index')) ?>"
                    :aria-label="cartAriaLabel"
                    x-ref="cartButton"
                >
            <?php endif; ?>
                <?= $icons->renderHtml('outline/shopping-cart', '', 24, 24, ['aria-hidden' => 'true']) ?>
                <span
                    class="absolute end-0 top-0 min-w-4 rounded-full bg-primary px-1 text-center text-xs font-semibold leading-4 text-on-primary"
                    x-text="summaryCount"
                    x-show="summaryCount"
                    x-cloak
                    aria-hidden="true"
