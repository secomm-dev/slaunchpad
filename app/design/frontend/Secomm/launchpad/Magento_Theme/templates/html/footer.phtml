<script>
    function initFooterLinksAccordion() {
        return {
            init() {
                const section = this.$el;
                // Anchor classes first; structural fallback (data-content-type)
                // keeps the accordion working after a PageBuilder save strips
                // custom classes from the block content.
                let groups = Array.from(section.querySelectorAll('.footer-links-group'));
                if (!groups.length) {
                    groups = Array.from(section.querySelectorAll('[data-content-type="column"]'))
                        .filter((col) => col.querySelector('[data-content-type="heading"], h2, h3, h4'));
                }
                const anyOpen = groups.some((g) => g.classList.contains('footer-links-open'));
                groups.forEach((group, index) => {
                    const title = group.querySelector('.footer-links-title')
                        || group.querySelector('[data-content-type="heading"], h2, h3, h4');
                    const list = group.querySelector('.footer-links-list')
                        || (title ? title.nextElementSibling : null);
                    if (!title || !list) {
                        return;
                    }
                    if (!anyOpen && index === 0) {
                        group.classList.add('footer-links-open');
                    }
                    const isOpen = () => group.classList.contains('footer-links-open');
                    const toggle = () => {
                        group.classList.toggle('footer-links-open');
                        title.setAttribute('aria-expanded', isOpen() ? 'true' : 'false');
                    };
                    title.setAttribute('role', 'button');
                    title.setAttribute('tabindex', '0');
                    title.setAttribute('aria-expanded', isOpen() ? 'true' : 'false');
                    title.addEventListener('click', toggle);
                    title.addEventListener('keydown', (event) => {
                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            toggle();
                        }
                    });
                });
            }
        };
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initFooterLinksAccordion', initFooterLinksAccordion);
    }, { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
