 * strip-proof pattern); the blocks carry only content elements plus anchor
 * classes in their CSS Classes fields, with structural fallbacks in
 * theme/footer.css. The links section is wrapped in an Alpine component that
 * turns the PB columns into a mobile-only accordion.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

