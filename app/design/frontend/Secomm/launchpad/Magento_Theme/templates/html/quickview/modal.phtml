<script>
    document.addEventListener('alpine:init', () => {
        const OPEN_CART_AFTER_ADD = <?= $openCartAfterAdd ? 'true' : 'false' ?>;
        Alpine.data('initQuickView', () => ({
            isOpen: false,
            loading: false,
            loadError: '',
            cache: {},
            product: null,
            gallery: [],
            activeImage: 0,
            qty: 1,
            qtyError: '',
            selected: {},
            submitting: false,
            wishlistBusy: false,
            compareBusy: false,
            status: '',
            statusMessage: '',

            open(sku) {
                this.reset();
                this.isOpen = true;
                this.load(sku);
            },

            close() {
                this.isOpen = false;
            },

            reset() {
                this.loading = false;
                this.loadError = '';
                this.product = null;
                this.gallery = [];
                this.activeImage = 0;
                this.qty = 1;
                this.qtyError = '';
                this.selected = {};
                this.submitting = false;
                this.wishlistBusy = false;
                this.compareBusy = false;
                this.status = '';
                this.statusMessage = '';
            },

            async load(sku) {
                if (this.cache[sku]) {
                    this.applyProduct(this.cache[sku]);
                    return;
                }
                this.loading = true;
                this.loadError = '';
                try {
                    const response = await fetch(
                        '<?= $escaper->escapeJs($block->getUrl('graphql')) ?>',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Store': '<?= $escaper->escapeJs($storeCode) ?>'
                            },
                            body: JSON.stringify({ query: QUICKVIEW_GRAPHQL_QUERY, variables: { filter: { sku: { eq: sku } } } })
                        }
                    );
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    const data = await response.json();
                    if (data.errors && data.errors.length) {
                        throw new Error(data.errors[0].message);
                    }
                    const items = data.data.products.items || [];
                    // Magento may expand the result with the configurable/grouped PARENT
                    // when the sku is a child variant — pick the exact sku first.
                    const product = items.find(item => item.sku === sku) || items[0];
                    if (!product) {
                        throw new Error('Product not found');
                    }
                    this.cache[sku] = product;
                    this.applyProduct(product);
                } catch (error) {
                    console.warn('Quick view failed:', error);
                    this.loadError = '<?= $escaper->escapeJs(__('Unable to load the product. Please try again.')) ?>';
                } finally {
                    this.loading = false;
                }
            },

            applyProduct(product) {
                this.product = product;
                this.gallery = (product.media_gallery || [])
                    .filter(image => image.url && !image.disabled)
                    .sort((a, b) => (a.position || 0) - (b.position || 0));
                this.activeImage = 0;
            },

            // Brand ("manufacturer") and material labels come from
            // custom_attributesV2: the direct EAV fields only carry option IDs.
            // select/multiselect arrive as AttributeSelectedOptions with labels;
            // plain text attributes as AttributeValue.
            customAttribute(code) {
                return (this.product && this.product.custom_attributesV2 && this.product.custom_attributesV2.items || [])
                    .find(attribute => attribute.code === code);
            },

            get brandLabel() {
                const attribute = this.customAttribute('manufacturer');
                if (!attribute) {
                    return '';
                }
                if (attribute.selected_options && attribute.selected_options.length) {
                    return attribute.selected_options.map(option => option.label).join(', ');
                }
                return attribute.value || '';
            },

            get materialLabels() {
                const attribute = this.customAttribute('material');
                if (!attribute || !attribute.selected_options || !attribute.selected_options.length) {
                    return '';
                }
                return attribute.selected_options.map(option => option.label).join(', ');
            },

            // Card parity (SLP-235): no star row when the product has no review.
            // rating_summary is a 0-100 percentage; score = percent / 20.
            get ratingScore() {
                const percent = Number(this.product && this.product.rating_summary || 0);
                const count = Number(this.product && this.product.review_count || 0);
                if (!percent || !count) {
                    return null;
                }
                return Math.round((percent / 20) * 10) / 10;
            },

            get reviewCount() {
                return Number(this.product && this.product.review_count || 0);
            },

            get isConfigurable() {
                return !!(this.product && this.product.configurable_options);
            },

            get configurableOptions() {
                return this.isConfigurable ? this.product.configurable_options : [];
            },

            matchingVariants(selection) {
                if (!this.isConfigurable) {
                    return [];
                }
                const entries = Object.entries(selection)
                    .filter(([, valueIndex]) => valueIndex !== '' && valueIndex !== undefined && valueIndex !== null);
                return (this.product.variants || []).filter(variant =>
                    variant.product.stock_status === 'IN_STOCK'
                    && entries.every(([code, valueIndex]) =>
                        variant.attributes.some(attribute =>
                            attribute.code === code && String(attribute.value_index) === String(valueIndex)
                        )
                    )
                );
            },

            isValueAvailable(option, valueIndex) {
                const selection = { ...this.selected, [option.attribute_code]: valueIndex };
                return this.matchingVariants(selection).length > 0;
            },

            get selectedVariant() {
                if (!this.isConfigurable) {
                    return null;
                }
                const chosen = Object.entries(this.selected)
                    .filter(([, valueIndex]) => valueIndex !== '' && valueIndex !== undefined && valueIndex !== null);
                if (chosen.length !== this.configurableOptions.length) {
                    return null;
                }
                return this.matchingVariants(this.selected)[0] || null;
            },

            get priceRange() {
                if (this.selectedVariant) {
                    return this.selectedVariant.product.price_range.minimum_price;
                }
                return this.product ? this.product.price_range.minimum_price : null;
            },

            get finalPrice() {
                return this.priceRange ? this.priceRange.final_price.value : 0;
            },

            get regularPrice() {
                return this.priceRange ? this.priceRange.regular_price.value : 0;
            },

            get asLowAs() {
                if (this.selectedVariant || !this.product || !this.product.price_tiers || !this.product.price_tiers.length) {
                    return null;
                }
                const values = this.product.price_tiers.map(tier => tier.final_price.value);
                const lowest = Math.min(...values);
                return lowest < this.finalPrice ? lowest : null;
            },

            get inStock() {
                if (this.selectedVariant) {
                    return this.selectedVariant.product.stock_status === 'IN_STOCK';
                }
                return !!this.product && this.product.stock_status === 'IN_STOCK';
            },

            selectedLabel(option) {
                const chosen = this.selected[option.attribute_code];
                if (chosen === '' || chosen === undefined || chosen === null) {
                    return '';
                }
                const value = (option.values || []).find(v => String(v.value_index) === String(chosen));
                return value ? value.label : '';
            },

            swatchType(value) {
                const raw = value.swatch_data && value.swatch_data.value;
                if (!raw) return 'text';
                if (raw.startsWith('#')) return 'color';
                if (raw.startsWith('/') || raw.startsWith('http')) return 'image';
                return 'text';
            },

            get missingSelection() {
                return this.isConfigurable
                    && this.configurableOptions.some(option => !this.selected[option.attribute_code]);
            },

            incQty() {
                const current = parseInt(this.qty, 10);
                this.qty = (Number.isFinite(current) ? current : 1) + 1;
            },

            decQty() {
                const current = parseInt(this.qty, 10);
                this.qty = Math.max(1, Number.isFinite(current) ? current - 1 : 1);
            },

            // Qty rules the native constraints (min=1, step=1) used to enforce,
            // with store-translated messages instead of the browser bubble.
            validateQty() {
                const input = this.$refs.qty;
                const raw = input ? input.value.trim() : String(this.qty);
                if (input && input.validity.badInput) {
                    return '<?= $escaper->escapeJs(__('Please enter a valid number.')) ?>';
                }
                if (raw === '') {
                    return '<?= $escaper->escapeJs(__('This is a required field.')) ?>';
                }
                const qty = Number(raw);
                if (!Number.isFinite(qty)) {
                    return '<?= $escaper->escapeJs(__('Please enter a valid number.')) ?>';
                }
                if (qty < 1) {
                    return '<?= $escaper->escapeJs(__('Value must be greater than or equal to %1.')) ?>'.replace('%1', '1');
                }
                if (!Number.isInteger(qty)) {
                    return '<?= $escaper->escapeJs(__('Please enter a valid value.')) ?>';
                }
                return '';
            },

            // Messages go inside the modal: the <dialog> sits in the top layer,
            // so the page's global message bar would be hidden behind it.
            showStatus(type, message) {
                this.status = type;
                this.statusMessage = message;
            },

            actionParams() {
                const params = new URLSearchParams(new FormData(this.$refs.form));
                params.set('product', this.product.id);
                params.set('form_key', hyva.getFormKey());
                params.set('uenc', hyva.getUenc());
                return params;
            },

            async addToWishlist() {
                if (this.wishlistBusy || !this.product) {
                    return;
                }
                this.wishlistBusy = true;
                this.showStatus('', '');
                try {
                    // Same endpoint/payload as Hyvä initWishlist (product list):
                    // form data carries the chosen super_attribute options + qty.
                    const response = await fetch(BASE_URL + 'wishlist/index/add/', {
                        method: 'POST',
                        headers: { 'content-type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: this.actionParams().toString(),
                        credentials: 'include'
                    });
                    if (response.redirected) {
                        // Guest → customer login page (core wishlist behaviour).
                        window.location.href = response.url;
                        return;
                    }
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    const data = await response.json();
                    if (data.success) {
                        this.showStatus('success', '<?= $escaper->escapeJs(__('%1 has been added to your Wish List.', '%1')) ?>'.replace('%1', this.product.name));
                    } else {
                        this.showStatus('error', data.error_message || '<?= $escaper->escapeJs(__('Could not add item to wishlist.')) ?>');
                    }
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                } catch (error) {
                    console.warn('Quick view add to wishlist failed:', error);
                    this.showStatus('error', '<?= $escaper->escapeJs(__('Could not add item to wishlist.')) ?>');
                } finally {
                    this.wishlistBusy = false;
                }
            },

            async addToCompare() {
                if (this.compareBusy || !this.product) {
                    return;
                }
                this.compareBusy = true;
                this.showStatus('', '');
                try {
                    // Core compare/add always answers with a redirect to the referer;
                    // 'manual' keeps the shopper in the modal instead of reloading.
                    await fetch(BASE_URL + 'catalog/product_compare/add/', {
                        method: 'POST',
                        headers: { 'content-type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: new URLSearchParams({
                            form_key: hyva.getFormKey(),
                            product: this.product.id,
                            uenc: hyva.getUenc()
                        }).toString(),
                        credentials: 'include',
                        redirect: 'manual'
                    });
                    this.showStatus('success', '<?= $escaper->escapeJs(__('You added product %1 to the comparison list.', '%1')) ?>'.replace('%1', this.product.name));
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                } catch (error) {
                    console.warn('Quick view add to compare failed:', error);
                    this.showStatus('error', '<?= $escaper->escapeJs(__('Could not add item to compare.')) ?>');
                } finally {
                    this.compareBusy = false;
                }
            },

            addToCart(event) {
                if (this.submitting) {
                    return;
                }
                this.qtyError = this.validateQty();
                if (this.qtyError) {
                    this.status = '';
                    this.$refs.qty && this.$refs.qty.focus();
                    return;
                }
                const qty = parseInt(this.qty, 10);
                if (this.missingSelection) {
                    this.status = 'error';
                    this.statusMessage = '<?= $escaper->escapeJs(__('You need to choose options for your item.')) ?>';
                    return;
                }
                this.qty = qty;
                this.submitting = true;
                this.status = '';
                this.statusMessage = '';

                const form = event.target;
                const params = new URLSearchParams(new FormData(form));
                params.append('uenc', hyva.getUenc());
                const storeParam = new URLSearchParams(window.location.search).get('___store');
                const actionUrl = storeParam
                    ? form.action + (form.action.includes('?') ? '&' : '?') + '___store=' + encodeURIComponent(storeParam)
                    : form.action;

                fetch(actionUrl, {
                    method: 'POST',
                    body: params,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                })
                    .then(async response => {
                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }
                        if (!response.ok) {
                            throw new Error('HTTP ' + response.status);
                        }
                        const data = await response.json();
                        if (data.backUrl) {
                            window.location.href = data.backUrl;
                            return;
                        }
                        // SLP-264: xóa global message cũ để ATC liên tiếp không stack success message
                        window.dispatchEvent(new CustomEvent('clear-messages'));
                        window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        this.status = 'success';
                        this.statusMessage = '<?= $escaper->escapeJs(__('You added %1 to your shopping cart.')) ?>'.replace('%1', this.product.name);
                        if (OPEN_CART_AFTER_ADD) {
                            this.close();
                            window.dispatchEvent(new CustomEvent('toggle-cart', { detail: { isOpen: true } }));
                        }
                    })
                    .catch(error => {
                        console.warn('Quick view add to cart failed:', error);
                        this.status = 'error';
                        this.statusMessage = '<?= $escaper->escapeJs(__('There was a problem adding your item to the cart.')) ?>';
                    })
                    .finally(() => {
                        this.submitting = false;
                    });
            }
        }));
    });

