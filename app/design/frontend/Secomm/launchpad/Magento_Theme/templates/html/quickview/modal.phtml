        <div x-show="product" class="grid gap-6 p-6 md:grid-cols-2 md:gap-8">

            <?php /* Gallery: main image + thumbnails */ ?>
            <div class="flex flex-col gap-3">
                <img
                    x-show="gallery.length"
                    :src="gallery[activeImage] && gallery[activeImage].url"
                    :alt="gallery[activeImage] && (gallery[activeImage].label || product?.name)"
                    class="w-full aspect-square object-contain rounded-lg border border-gray-200 bg-white"
                    loading="lazy"
                />
                <div x-show="gallery.length > 1" class="flex flex-wrap gap-2">
                    <template x-for="(image, index) in gallery" :key="index">
                        <button
                            type="button"
                            @click="activeImage = index"
                            class="rounded overflow-hidden border"
                            :class="index === activeImage ? 'border-blue-600' : 'border-gray-200'"
