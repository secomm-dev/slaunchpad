$hyvaCsp = $viewModels->require(HyvaCsp::class);

/** @var StoreViewModel $storeViewModel */
$storeViewModel = $viewModels->require(StoreViewModel::class);

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$storeCode = $storeViewModel->getStoreCode();

/** @var \Launchpad\QuickView\ViewModel\Config $quickViewConfig */
$quickViewConfig = $viewModels->require(\Launchpad\QuickView\ViewModel\Config::class);
$openCartAfterAdd = $quickViewConfig->isOpenCartAfterAddToCart();
?>

<div x-data="initQuickView"
