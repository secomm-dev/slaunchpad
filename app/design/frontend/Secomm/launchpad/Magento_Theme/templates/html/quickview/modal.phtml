                        x-text="hyva.formatPrice(regularPrice)"
                    ></span>
                    <span class="text-xl font-semibold" x-text="hyva.formatPrice(finalPrice)"></span>
                </div>
                <p x-show="asLowAs !== null" class="text-sm text-gray-600 mb-1">
                    <?= $escaper->escapeHtml(__('As low as')) ?>
                    <span class="font-medium" x-text="hyva.formatPrice(asLowAs)"></span>
                </p>

                <p
                    class="text-sm mb-2"
                    :class="inStock ? 'text-green-700' : 'text-red-600'"
                    x-text="inStock ? '<?= $escaper->escapeJs(__('In stock')) ?>' : '<?= $escaper->escapeJs(__('Out of stock')) ?>'"
                ></p>
                <p class="text-sm text-gray-600 mb-3">
                    <?= $escaper->escapeHtml(__('SKU')) ?>:
                    <span class="font-medium text-gray-800" x-text="product?.sku"></span>
                </p>
                <?php /* Short description + More Information (description) — same content sources as the PDP tabs. */ ?>
                <div x-show="product?.short_description?.html" class="prose-sm text-gray-700 mb-3 [&_p]:mb-2" x-html="product?.short_description?.html"></div>
                <div x-show="product?.description?.html" class="border-t border-gray-200 pt-3 mb-3">
                    <h3 class="text-sm font-semibold mb-1"><?= $escaper->escapeHtml(__('More Information')) ?></h3>
                    <div class="prose-sm text-gray-700 [&_p]:mb-2" x-html="product?.description?.html"></div>
                </div>

                <form
                    action="<?= $escaper->escapeUrl($block->getUrl('checkout/cart/add')) ?>"
                    method="post"
                    @submit.prevent="addToCart($event)"
                >
                    <?= $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="product" :value="product?.id" />
                    <?php /* Swatch options rendered like the PDP
                           (Magento_Swatches::product/view/renderer.phtml pattern). */ ?>
                    <template x-for="option in configurableOptions" :key="option.attribute_id">
                        <fieldset class="mt-0 mb-4">
                            <legend class="mb-1 text-base font-normal">
                                <span x-text="option.label"></span>:
                                <span class="font-medium" x-text="selectedLabel(option)"></span>
                            </legend>
                            <div class="flex flex-wrap gap-2">
                                <template x-for="value in option.values" :key="value.value_index">
                                    <label
                                        class="swatch-option my-0 cursor-pointer"
                                        :class="!isValueAvailable(option, value.value_index) && 'opacity-40 pointer-events-none'"
                                        :data-swatch-type="swatchType(value) === 'text' ? 'text' : 'visual'"
                                    >
                                        <span
                                            x-show="swatchType(value) === 'text'"
                                            x-text="value.label"
                                        ></span>
                                        <?php /* Visual swatch — same inline-size pattern as Magento_Swatches::swatch-item.phtml */ ?>
                                        <span
                                            class="block"
                                            x-show="swatchType(value) === 'color'"
                                            :style="'width:30px;height:30px;background-color:' + value.swatch_data.value"
