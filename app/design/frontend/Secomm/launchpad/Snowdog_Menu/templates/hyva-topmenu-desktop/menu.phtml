<?php
/**
 * TASK-DWW34M (SLP-246): Launchpad Header desktop level-1 navigation row.
 *
 * Theme-local override of the Snowdog_Menu desktop topmenu template — the
 * vendor template under app/code/Snowdog/Menu is not modified.
 *
 * Only the level-1 row is restyled to the Header master (node 2151:9517):
 * - one non-wrapping row, 24px item gaps, horizontal scroll inside the Header
 *   navigation region with a visually hidden scrollbar (wheel, trackpad,
 *   touch and keyboard scrolling stay available; tabindex keeps the scroll
 *   region keyboard-reachable),
 * - Label M typography (Inter Medium 14/20), 8px vertical padding, 4px
 *   label-chevron gap, exact 12px theme chevron, contextual currentColor,
 * - the vendor `container`, 80px height, `justify-between`, per-item `px-6`,
 *   forced primary color, uppercase transform and selected-panel styling are
 *   intentionally not used.
 *
 * The submenu panel is rendered by the theme-local
 * `menu/desktop-sub-menu.phtml` (wired through the `subMenuTemplate` block
 * argument): a full-width composition below the Header shell (feature image +
 * copy and up to three selection-driven navigation columns). The panel is
 * absolutely positioned, so its containing block is the Header grid shell
 * (position: relative on the grid in Magento_Theme::html/header.phtml): it
 * renders full width below the shell and escapes the scroll viewport's
 * clipping. Activation follows HMF-04: hover enhancement on fine pointers,
 * deterministic click/Enter/Space toggle, delayed mouseleave, outside click
 * and Escape close with focus restoration.
 */

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Snowdog\Menu\Block\Menu;

/** @var Menu $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var SvgIcons $icons */
$icons = $viewModels->require(SvgIcons::class);

$menu = $block->getMenu();
$uniqueId = '_' . uniqid();
?>

<?php if ($menu): ?>
    <script>
        'use strict';

        const initTopmenuDesktop<?= $escaper->escapeHtml($uniqueId) ?> = () => ({
            openSubmenuId: null,
            branchSelection: {},
            hoverCloseTimer: null,
            canHover() {
                return window.matchMedia('(hover: hover) and (pointer: fine)').matches
            },
            activateSubmenu(menuNode, { trapFocus = true } = {}) {
                this.openSubmenuId = menuNode
                this.branchSelection = { ...this.branchSelection, [menuNode]: { l1: null, l2: null } }
                if (!trapFocus) return
                this.$nextTick(() => {
                    hyva.releaseFocus()
                    hyva.trapFocus(this.$refs['submenu-' + menuNode])
                })
            },
            toggleSubmenu(menuNode) {
                if (menuNode === this.openSubmenuId) {
                    this.closeSubmenu()
                } else {
                    this.activateSubmenu(menuNode)
                }
            },
            closeSubmenu() {
                this.clearCloseTimer()
                const panel = this.openSubmenuId ? this.$refs['submenu-' + this.openSubmenuId] : null
                this.openSubmenuId = null
                hyva.releaseFocus()
                if (panel && panel.contains(document.activeElement)) {
                    this.$refs['sr-button-' + (panel.getAttribute('x-ref') || '').replace('submenu-', '')]?.focus()
                }
            },
            openSubmenuOnHover(menuNode) {
                if (!this.canHover()) return
                this.clearCloseTimer()
                if (menuNode !== this.openSubmenuId) this.activateSubmenu(menuNode, { trapFocus: false })
            },
            scheduleSubmenuClose() {
                if (!this.canHover()) return
                this.clearCloseTimer()
                this.hoverCloseTimer = setTimeout(() => {
                    this.openSubmenuId = null
                    hyva.releaseFocus()
                }, 300)
            },
            clearCloseTimer() {
                if (this.hoverCloseTimer) {
                    clearTimeout(this.hoverCloseTimer)
                    this.hoverCloseTimer = null
                }
            },
            selectBranch(topId, level, nodeId) {
                const branch = { ...(this.branchSelection[topId] || {}) }
                if (level === 1) {
                    branch.l1 = branch.l1 === nodeId ? null : nodeId
                    branch.l2 = null
                } else {
                    branch.l2 = branch.l2 === nodeId ? null : nodeId
                }
                this.branchSelection = { ...this.branchSelection, [topId]: branch }
            },
            onSubmenuEscape(event) {
                event.stopPropagation()
                const activeTop = this.openSubmenuId
                this.openSubmenuId = null
                hyva.releaseFocus()
                this.$refs['sr-button-' + activeTop]?.focus()
            }
        })
    </script>

    <div x-data="initTopmenuDesktop<?= $escaper->escapeHtml($uniqueId) ?>()"
        class="
            <?= $escaper->escapeHtmlAttr($menu->getCssClass()) ?>
            navigation hidden w-full lg:block
        "
        @resize.window.passive="if (window.innerWidth < 1024 && openSubmenuId) closeSubmenu()"
    >
        <nav
            class="snowdog-topmenu-desktop min-w-0 overflow-x-auto scrollbar-none [&::-webkit-scrollbar]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Main menu')) ?>"
            tabindex="0"
        >
            <ul
                class="flex w-max items-center gap-6"
                @mouseleave="scheduleSubmenuClose()"
            >
                <?php foreach ($block->getNodes() as $node): ?>
                    <?php
                    $childrenLevel = $node->getLevel() + 1;
                    $children = $block->getNodes($childrenLevel, $node);
                    $node->setIsParent((bool) $children);
                    $additionalClasses = $node->getClasses() ? ' ' . $node->getClasses() : '';
                    $nodeId = $node->getId();
                    $title = $node->getTitle();
                    $nodeType = $node->getType();
                    $nodeClasses = $node->getClasses();
                    ?>
                    <li class="flex items-center gap-1 <?= /* @noEscape */ (string) $nodeType === 'wrapper' ? $escaper->escapeHtmlAttr($nodeClasses) : '' ?>"
                        @mouseenter="openSubmenuOnHover('<?= /* @noEscape */ (string) $nodeId ?>')"
                        @mouseleave="scheduleSubmenuClose()"
                        @click.outside="if (openSubmenuId === '<?= /* @noEscape */ (string) $nodeId ?>') closeSubmenu()"
                        @keydown.escape="onSubmenuEscape"
                    >
                        <div class="[&>a]:flex [&>a]:items-center [&>a]:py-2 [&>a]:text-label-m [&>a]:leading-5! [&>a]:font-medium [&>a]:text-current [&>a]:whitespace-nowrap [&>a:not(:last-child)]:hidden [&>a]:hover:text-current! [&>a]:hover:opacity-80 [&>a]:focus-visible:outline [&>a]:focus-visible:outline-2 [&>a]:focus-visible:outline-offset-2 [&>a]:focus-visible:outline-focus">
                            <?= /* @noEscape */ $block->renderMenuNode($node) ?>
                        </div>
                        <?php if ($children): ?>
                            <button
                                type="button"
                                class="-m-1 shrink-0 rounded-sm p-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-transform motion-safe:duration-300"
                                :class="{
                                    'rotate-180' : openSubmenuId === '<?= /* @noEscape */ (string) $nodeId ?>'
                                }"
                                x-ref="sr-button-<?= /* @noEscape */ (string) $nodeId ?>"
                                :aria-expanded="openSubmenuId === '<?= /* @noEscape */ (string) $nodeId ?>' ? 'true' : 'false'"
                                @click="toggleSubmenu('<?= /* @noEscape */ (string) $nodeId ?>')"
                            >
                                <?= $icons->renderHtml('outline/chevron-down', '', 12, 12, ['aria-hidden' => 'true']) ?>
                                <span class="sr-only">
                                    <?= $escaper->escapeHtml(__('Toggle submenu for %1', $title)) ?>
                                </span>
                            </button>
                        <?php endif; ?>
                        <?= /* @noEscape */ $block->renderSubmenu($children, $node, $childrenLevel) ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </nav>
    </div>
<?php endif; ?>
