<?xml version="1.0"?>
<!--
  TASK-SXW5RB (SLP-129): place Snowdog's desktop navigation inside the custom
  header. Magento_Theme/default.xml owns the uniquely named native fallbacks;
  header.phtml selects Snowdog or native output from the admin configuration.

  TASK-08343C (FEAT-ZNJ4KF): desktop/mobile identifiers come from store config;
  blank mobile falls back to desktop. Both default to one managed
  `hyva-topmenu-desktop` hierarchy. The frontend TemplateResolver plugin maps
  either configured header menu to the canonical theme-local template folder,
  while the mobile block receives its own drawer renderer arguments.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="footer-static-links" remove="false"/>
        <referenceBlock name="menu-footer" remove="true"/>

        <referenceBlock name="topmenu-desktop">
            <arguments>
                <argument name="menu" xsi:type="helper" helper="Launchpad\SnowdogMenu\ViewModel\Config::getDesktopMenuIdentifier"/>
                <argument name="template" xsi:type="string">Snowdog_Menu::menu.phtml</argument>
                <argument name="subMenuTemplate" xsi:type="string">Snowdog_Menu::menu/desktop-sub-menu.phtml</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="topmenu-mobile">
            <arguments>
                <argument name="menu" xsi:type="helper" helper="Launchpad\SnowdogMenu\ViewModel\Config::getMobileMenuIdentifier"/>
                <argument name="template" xsi:type="string">Snowdog_Menu::menu-mobile.phtml</argument>
                <argument name="subMenuTemplate" xsi:type="string">Snowdog_Menu::menu/mobile-sub-menu.phtml</argument>
            </arguments>
            <block name="launchpad.topmenu.mobile.logo"
                   template="Magento_Theme::html/header/menu-drawer-logo.phtml"/>
            <block name="launchpad.topmenu.mobile.search"
                   template="Magento_Theme::html/header/menu-drawer-search.phtml"/>
            <block name="launchpad.topmenu.mobile.languages"
                   template="Magento_Store::header/menu/languages-drawer.phtml"/>
        </referenceBlock>

        <move element="topmenu-desktop"
              destination="header-content"
              as="snowdog-topmenu-desktop"
              before="topmenu_generic"/>
    </body>
</page>
