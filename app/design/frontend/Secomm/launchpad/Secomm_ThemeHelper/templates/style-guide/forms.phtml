                $textareaStates = [
                    'default' => [__('Default textarea'), __('Textarea hint text.')],
                    'error' => [__('Textarea error'), __('Correct the content before continuing.')],
                    'warning' => [__('Textarea warning'), __('Review this content before continuing.')],
                    'success' => [__('Textarea success'), __('The content has been validated.')],
                ];
                foreach ($textareaStates as $state => [$label, $message]):
                    $isError = $state === 'error';
                    $feedback = in_array($state, ['warning', 'success'], true) ? $state : null;
                    ?>
                    <div class="field<?= $isError ? ' field-error' : '' ?>"
                         <?= $feedback ? 'data-feedback="' . $escaper->escapeHtmlAttr($feedback) . '"' : '' ?>>
