                                  class="form-textarea w-full<?= $isError ? ' mage-error' : '' ?>" rows="5"
                                  <?= $isError ? 'aria-invalid="true"' : '' ?>
                                  placeholder="<?= $escaper->escapeHtmlAttr(__('Placeholder')) ?>"></textarea>
                        <p class="<?= $isError ? 'messages' : 'note' ?>"><?= $escaper->escapeHtml($message) ?></p>
