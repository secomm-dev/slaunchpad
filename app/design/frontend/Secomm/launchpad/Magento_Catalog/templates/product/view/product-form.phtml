 *
 * SLP-183 / BUG-KFJ49A: copy của Hyva_default/Magento_Catalog/templates/product/view/product-form.phtml.
 * Đổi khác: wire hyva.formValidation trên form add-to-cart PDP (component tự set novalidate —
 * tắt HTML5 native validation; message render VI/EN theo theme CSV thay vì native bubble
 * theo locale trình duyệt) và đăng ký 2 custom rule:
 *   - validate-number: bắt badInput của <input type="number"> (bubble cũ "Please enter a number.").
 *   - validate-one-required: bắt buộc chọn 1 option trong nhóm radio super_attribute
 *     (bubble cũ "Please select one of these options."; message dùng key có sẵn
 *     "Please select one of the options." trong theme CSV).
 * SLP-264 / TASK-Y23EMS: override onSubmit của component hyva.formValidation (vendor
 * advanced-form-validation.phtml hard-code event.target.submit() = native POST) — khi
 * validate pass gọi window.ajaxSubmitCart(form) (Monsoon theme-override, AJAX) thay vì
 * submit native; helper vắng mặt (flag enable_ajax_add_to_cart=0) → fallback native.
 * isSubmitting reset trên nhánh AJAX vì page không navigate; chống double-submit lúc
 * in-flight do ajaxSubmitCart disable button đồng bộ trước fetch đầu tiên.
 * SLP-278: bọc rule `required` cho radio/checkbox — option bundle render ngoài <form> (gắn qua
 * attribute form="product_addtocart_form") nên vendor getCheckedValues() (form.querySelectorAll)
 * không thấy option đã chọn → báo "bắt buộc" và chặn add to cart. Value tính lại qua
 * form.elements (gồm cả form-associated element); message/rule vendor giữ nguyên.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Catalog\Block\Product\View;
use Magento\Catalog\Model\Product;
use Magento\Catalog\Model\Product\Option;
use Magento\Framework\Escaper;

// phpcs:disable Generic.WhiteSpace.ScopeIndent

/** @var View $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$hyvaCsp = $viewModels->require(HyvaCsp::class);

/** @var Product $product */
$product = $block->getProduct();

/**
 * Add to cart url is set on 'product.info' block by
 * @see \Magento\Checkout\Block\Cart\Item\Configure::_prepareLayout
 */
$productInfoBlock = $block->getLayout()->getBlock('product.info');

$productOptions = $product->getOptions() ?? [];
$hasMultiFormInputOption = (bool) array_filter($productOptions, fn($o) => $o->getType() === Option::OPTION_TYPE_FILE);
?>
<?php if ($product->isSaleable()): ?>
    <form method="post"
          action="<?= $escaper->escapeUrl($productInfoBlock->getSubmitUrl($product)) ?>"
          class="mb-6"
          id="product_addtocart_form"
          x-data="initProductCartForm"
          @submit="onSubmit"
          <?php if ($hasMultiFormInputOption): ?>
              enctype="multipart/form-data"
          <?php endif; ?>
          <?php foreach ($block->getData('product_data_attributes') ?? [] as $attribute => $include): ?>
              <?php if ($include): ?>
                  <?php /** Append data-* attributes based on layout XML arguments */ ?>
                  <?= $escaper->escapeHtml(sprintf('data-%s', $attribute)); ?>="<?= $escaper->escapeHtmlAttr($product->getData($attribute)); ?>"
              <?php endif; ?>
          <?php endforeach; ?>
    >
        <input type="hidden" name="product" value="<?= (int)$product->getId() ?>">
        <input type="hidden" name="selected_configurable_option" value="">
        <input type="hidden" name="related_product" id="related-products-field" value="">
        <input type="hidden" name="item"  value="<?= (int)$block->getRequest()->getParam('id') ?>">
        <?= $block->getBlockHtml('formkey') ?>
        <?= $block->getChildHtml() ?>
    </form>
    <script>
        function initProductCartForm() {
            hyva.formValidation.addRule('validate-number', (value, options, field) => {
                return field.element.checkValidity && field.element.validity.badInput
                    ? '<?= $escaper->escapeJs(__('Please enter a number.')) ?>'
                    : true;
            });

            hyva.formValidation.addRule('validate-one-required', (value, options, field) => {
                const name = field.element.name.replace(/([\\"])/g, '\\$1');
                const checked = field.element.form.querySelectorAll('input[name="' + name + '"]:checked');
                return checked.length
                    ? true
                    : '<?= $escaper->escapeJs(__('Please select one of the options.')) ?>';
            });

            // SLP-278: vendor getCheckedValues() (advanced-form-validation.phtml:316-320) query
            // form.querySelectorAll → bỏ sót radio/checkbox bundle nằm ngoài <form> (attribute form=).
            // Tính lại value qua form.elements rồi giao cho rule vendor (giữ nguyên message).
            // Guard để không bọc lồng nhiều lần nếu component init lại.
            if (!hyva.formValidation.rules.required.includesFormAssociated) {
                const vendorRequired = hyva.formValidation.rules.required;
                const required = (value, options, field, context) => {
                    const el = field.element;
                    if ((el.type === 'radio' || el.type === 'checkbox') && el.form) {
                        const items = el.form.elements.namedItem(el.name);
                        const checked = (items instanceof RadioNodeList ? Array.from(items) : [items || el])
                            .filter(item => item.checked)
                            .map(item => item.value);
                        value = el.type === 'radio' ? checked[0] : checked;
                    }
                    return vendorRequired(value, options, field, context);
                };
                required.includesFormAssociated = true;
                hyva.formValidation.addRule('required', required);
            }

            const component = hyva.formValidation(this.$el);

            // SLP-264 / TASK-Y23EMS: override onSubmit của hyva.formValidation (vendor
            // advanced-form-validation.phtml:402-412 hard-code event.target.submit() = native POST).
            // Validate pass → window.ajaxSubmitCart(form) (Monsoon theme-override) thay vì native;
            // helper vắng (flag enable_ajax_add_to_cart=0) → fallback native submit.
            // isSubmitting reset trên nhánh AJAX vì page không navigate; chống double-submit lúc
            // in-flight do ajaxSubmitCart disable button đồng bộ trước fetch đầu tiên.
            component.onSubmit = function (event) {
                if (event.target.tagName !== 'FORM') {
                    return;
                }
                event.preventDefault();
                if (this.isSubmitting) {
                    return;
                }
                this.isSubmitting = true;
                this.validate()
                    .then(() => {
                        this.isSubmitting = false;
                        if (typeof window.ajaxSubmitCart === 'function') {
                            window.ajaxSubmitCart(event.target);
                        } else {
                            event.target.submit();
                            return;
                        }
                    })
                    .catch(() => {
                        this.isSubmitting = false;
                    });
            };

            return component;
        }

        window.addEventListener('alpine:init', () => {
            Alpine.data('initProductCartForm', initProductCartForm)
        }, { once: true })
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
