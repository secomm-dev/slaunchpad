 * Copy của Hyva_default/Magento_Catalog/templates/product/list.phtml (TASK-NAMVVC, SLP-235).
 * Đổi khác so với bản gốc:
 *  1. Grid columns theo design Figma 2330-39642 / mobile 2330-39378: 2 cột mobile,
 *     3 cột từ lg (bản gốc 1/2/1/2/3 — lệch design), gap 24/40.
 *  2. Empty state (Figma 2330-39793): icon + "No products found" + description +
 *     "Clear filters" (URL category sạch) + "Back to %1" (category cha, ẩn khi
 *     không có). Bản gốc: message info empty 1 dòng.
 *  3. List mode: gap-y-8 (32px, design row gap).
 * Toàn bộ phần còn lại (toolbar calls, eager loading, item pipeline) giữ nguyên.
 */
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\CurrentCategory;
use Hyva\Theme\ViewModel\LucideIcons;
use Hyva\Theme\ViewModel\ProductListItem;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Catalog\Block\Product\ListProduct;
use Magento\Framework\Escaper;

/** @var ListProduct $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var ProductPage $productViewModel */
/** @var CurrentCategory $currentCategoryViewModel */
/** @var LucideIcons $lucideIcons */

$productViewModel         = $viewModels->require(ProductPage::class);
$productListItemViewModel = $viewModels->require(ProductListItem::class);
$currentCategoryViewModel = $viewModels->require(CurrentCategory::class);
$lucideIcons              = $viewModels->require(LucideIcons::class);

$eagerLoadImagesCount = (int) ($block->getData('eager_load_images_count') ?? 3);
$productCollection = $block->getLoadedProductCollection();

?>
<?php if (!$productCollection->count()): ?>
    <?php
        // SLP-235 empty state actions. "Clear filters" = category URL without
        // query params; "Back to %1" = parent category, hidden when the current
        // category is (or sits directly under) the tree root. Category comes
        // from the block layer (the CurrentCategory viewmodel is never set() on
        // this page — get() would always throw).
        $clearFiltersUrl = '';
        $backUrl = '';
        $backLabel = '';
        try {
            $currentCategory = $block->getLayer()->getCurrentCategory();
            if ($currentCategory && $currentCategory->getId()) {
                $clearFiltersUrl = $currentCategory->getUrl();
                $parent = $currentCategory->getParentCategory();
                if ($parent && $parent->getId() && (int) $parent->getLevel() > 1) {
                    $backUrl = $parent->getUrl();
                    $backLabel = (string) $parent->getName();
                }
            }
        } catch (\Throwable $e) {
            // No category context — render the message without the action buttons.
        }
    ?>
    <div class="lp-empty flex flex-col items-center justify-center px-4 py-16 text-center" id="product-list">
        <span class="flex h-24 w-24 items-center justify-center rounded-full bg-hp-soft text-hp-brand" aria-hidden="true">
            <?= /* @noEscape */ $lucideIcons->imageHtml('', 32, 32) ?>
        </span>
        <h2 class="mt-6 text-3xl font-bold leading-10 tracking-tight text-[#293e2d] lg:text-4xl">
            <?= $escaper->escapeHtml(__('No products found')) ?>
        </h2>
        <p class="mt-3 max-w-md text-base leading-6 text-[#6a7282]">
            <?= $escaper->escapeHtml(__('We couldn\'t find any products that matches your current filters. Try adjusting your selection to discover more products.')) ?>
        </p>
        <?php if ($clearFiltersUrl || $backUrl): ?>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
                <?php if ($clearFiltersUrl): ?>
                    <a href="<?= $escaper->escapeUrl($clearFiltersUrl) ?>"
                       class="btn btn-primary lp-empty-btn h-11 rounded-md bg-hp-brand-dark px-6 text-sm font-medium leading-5 text-white hover:bg-hp-brand-dark hover:brightness-90"
                    >
                        <?= $escaper->escapeHtml(__('Clear filters')) ?>
                    </a>
                <?php endif; ?>
                <?php if ($backUrl && $backLabel !== ''): ?>
                    <a href="<?= $escaper->escapeUrl($backUrl) ?>"
                       class="btn lp-empty-btn h-11 rounded-md border border-[#d1d5dc] bg-white px-6 text-sm font-medium leading-5 text-[#1e2939] hover:bg-hp-soft"
                    >
                        <?= $escaper->escapeHtml(__('Back to %1', $backLabel)) ?>
                    </a>
                <?php endif; ?>
            </div>
        <?php endif; ?>
    </div>
<?php else: ?>
    <section class="md:pt-10 md:pb-8" id="product-list" aria-label="<?= $escaper->escapeHtmlAttr(__('Product list')) ?>" tabindex="-1">
        <?= $block->getToolbarHtml() ?>
        <?= $block->getAdditionalHtml() ?>
        <?php
        if ($block->getMode() == 'grid') {
            $viewMode         = 'grid';
            $imageDisplayArea = 'category_page_grid';
            $showDescription  = false;
            $templateType     = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
        } else {
            $viewMode         = 'list';
            $imageDisplayArea = 'category_page_list';
            $showDescription  = true;
            $templateType     = \Magento\Catalog\Block\Product\ReviewRendererInterface::FULL_VIEW;
        }
        /**
         * Position for actions regarding image size changing in vde if needed
         */
        $pos = $block->getPositioned();
        ?>
        <div class="products wrapper mode-<?= /* @noEscape */$viewMode ?> products-<?= /* @noEscape */$viewMode ?>">
            <ul
                role="list"
                class="mx-auto pt-4 pb-12 grid <?= /* @noEscape */$viewMode === 'grid'
                    ? 'grid-cols-2 gap-x-3 gap-y-4 md:gap-x-6 md:gap-y-10 lg:grid-cols-3'
                    : 'grid-cols-1 gap-y-8' ?>"
            >
                <?php
                /** @var \Magento\Catalog\Model\Product $product */
                foreach (array_values($productCollection->getItems()) as $i => $product):
                    if ($i < $eagerLoadImagesCount) {
                        $product->setData('image_custom_attributes', ['loading' => 'eager', 'fetchpriority' => 'high']);
                    }
                    ?>
                    <li class="flex flex-col">
                        <?= $productListItemViewModel->getItemHtml(
                            $product,
                            $block,
                            $viewMode,
                            $templateType,
                            $imageDisplayArea,
                            $showDescription
                        ); ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
        <?= $block->getChildBlock('toolbar')->setIsBottom(true)->toHtml() ?>
    </section>
<?php endif; ?>
