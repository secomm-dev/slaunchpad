declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Customer\Block\Account\Customer;
use Magento\Framework\Escaper;

/** @var Customer $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

/** @var SvgIcons $icons */
$icons = $viewModels->require(SvgIcons::class);

/**
 * Secomm Launchpad theme override of Magento_Customer::header/customer-menu.phtml
 *
 * BUG-H929MC (SLP-129): on <sm viewports the account icon sits near the left edge
 * (header flex-wrap puts the icon row below the logo), so the stock `right-0` anchoring
 * extends the dropdown past the left viewport edge and clips the links.
 * Mobile opens the dropdown from the icon's left edge (over-constrained left/right
 * resolution ignores `right` in LTR); `sm:` and up keep the stock right-side anchoring.
 */
?>
<div
    class="relative inline-block"
    x-data="initCustomerMenu"
    x-bind="eventListeners"
>
    <button
        type="button"
        id="customer-menu"
        class="btn btn-transparent h-10 shrink-0 gap-1 px-2 [--btn-icon-size:24px]! [--btn-color:currentColor]!"
        @click="toggleOpen"
        :aria-expanded="open"
        aria-label="<?= $escaper->escapeHtmlAttr(__('My Account')) ?>"
        aria-haspopup="true"
    >
        <?= $icons->renderHtml('outline/user', '', 24, 24, ['aria-hidden' => 'true']) ?>
        <span class="hidden text-label-m lg:inline" x-show="customer?.firstname" x-cloak>
            <?= $escaper->escapeHtml(__('Hi,')) ?>
            <span x-text="customer.firstname"></span>
        </span>
    </button>
    <nav
        class="absolute right-0 z-30 mt-2 w-48 overflow-auto rounded-md bg-white px-1 py-2 text-ink shadow-lg lg:mt-3"
        aria-labelledby="customer-menu"
        x-show="open"
        x-transition
        x-cloak
    >
        <?php if ($block->customerLoggedIn()): ?>
            <?= $block->getChildHtml('header.customer.logged.in.links') ?>
        <?php else: ?>
            <?= $block->getChildHtml('header.customer.logged.out.links') ?>
        <?php endif; ?>
    </nav>
</div>
<script>
    function initCustomerMenu() {
        return hyva.createBooleanObject('open', false, {
            eventListeners: {
                ['@pageshow.window'](event) {
                    if (event.persisted) {
                        this.setOpenFalse()
                    }
                },
                ['@keyup.escape']() {
                    this.setOpenFalse()
                },
                ['@click.outside']() {
                    this.setOpenFalse()
                }
            }
        })
    }
    window.addEventListener('alpine:init', () => Alpine.data('initCustomerMenu', initCustomerMenu), {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>
