<?xml version="1.0"?>
<!--
    Secomm Launchpad — Snowdog Menu toggle module (TASK-SXW5RB, SLP-129)
    Admin switch: Stores > Configuration > Hyva Theme > Snowdog Navigation
    (tab `hyva_themes` is declared by Hyva_ThemeModule).
    Scope: default / website / store view.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="snowdog_navigation" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Snowdog Navigation</label>
            <tab>hyva_themes</tab>
            <resource>Magento_Config::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Snowdog Menu Navigation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
