<?xml version="1.0"?>
<!--
    Secomm Launchpad — Snowdog Menu module DI (frontend scope).

    - launchpad_snowdog_navigation_toggle (TASK-SXW5RB): renders every
      Snowdog\Menu\Block\Menu empty while the storefront navigation config
      selects the native Hyvä navigation; frontend scope only so the plugin
      is never invoked when the Snowdog_Menu module is disabled.
    - Banner persistence plugins for TASK-08343C live in the global
      etc/di.xml (they must fire in every area).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Snowdog\Menu\Block\Menu">
        <plugin name="launchpad_snowdog_navigation_toggle"
                type="Launchpad\SnowdogMenu\Plugin\Snowdog\Menu\Block\Menu"
                sortOrder="10"/>
    </type>
    <type name="Snowdog\Menu\Model\TemplateResolver">
        <plugin name="launchpad_snowdog_configured_menu_templates"
                type="Launchpad\SnowdogMenu\Plugin\TemplateResolverPlugin"
                sortOrder="10"/>
    </type>
</config>
