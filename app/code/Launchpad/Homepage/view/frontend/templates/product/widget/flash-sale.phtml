<?php
/**
 * Flash Sale slider widget (TASK-0NNZCW v4, SLP-213).
 *
 * "Sale ending in" countdown + product snap-slider (dots on mobile per design;
 * desktop shows no pager). Card pipeline = product_list_item (PLP parity).
 *
 * @var \Launchpad\Homepage\Block\Product\FlashSaleList $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\ProductListItem;
use Magento\Catalog\Block\Product\ReviewRendererInterface;

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var ProductListItem $productListItem */
$productListItem = $viewModels->require(ProductListItem::class);

$collection = $block->getProductCollection();
// Batch gallery AFTER createCollection (Elasticsuite plugin) has finished —
// see FlashSaleList::createCollection note.
if ($collection && !$collection->isLoaded()) {
    $collection->load();
}
if ($collection) {
    $collection->addMediaGalleryData();
}
$items = $collection ? $collection->getItems() : [];
$endMillis = (int) $block->getSaleEndMillis();
?>
<?php if ($items): ?>
    <div class="lp-flash relative">
        <div class="lp-flash-countdown" x-data="lpFlashCountdown(<?= (int) $endMillis ?>)">
            <div class="lp-countdown-pill">
                <span class="lp-countdown-label">
                    <svg class="h-6 w-6 shrink-0 text-[#293e2d]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                    </svg>
                    <span><?= $escaper->escapeHtml(__('Sale ending in')) ?></span>
                </span>
                <span class="lp-countdown-value" x-text="left">00:00:00</span>
            </div>
        </div>
        <div data-lp-slider class="hp-pb-slider">
            <div data-track class="snap-track hp-pb-track lp-flash-track">
                <?php foreach ($items as $product) : ?>
                    <div class="w-full">
                        <?= /* @noEscape */ $productListItem->getItemHtml(
                            $product,
                            $block,
                            'grid',
                            ReviewRendererInterface::SHORT_VIEW,
                            'new_products_content_widget_grid',
                            false
                        ) ?>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
    <script>
        'use strict';
        function lpFlashCountdown(endMillis) {
            return {
                end: endMillis,
                left: '00:00:00',
                tick() {
                    const diff = Math.max(0, Math.floor((this.end - Date.now()) / 1000));
                    this.left = [Math.floor(diff / 3600), Math.floor((diff % 3600) / 60), diff % 60]
                        .map((n) => String(n).padStart(2, '0'))
                        .join(':');
                },
                init() {
                    this.tick();
                    this.timer = window.setInterval(() => {
                        this.tick();
                        if (this.end <= Date.now()) {
                            window.clearInterval(this.timer);
                            this.hide();
                        }
                    }, 1000);
                },
                hide() {
                    const row = this.$el.closest('[data-content-type="row"]');
                    if (row) row.style.display = 'none';
                }
            };
        }
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
