<?php
/**
 * Newsletter subscribe form — LAUNCHPAD CORE (TASK-0NNZCW v4.3, restyled TASK-7EYJ4C).
 * Design 2151:17272 (homepage) + footer 2717:85933/2717:86177 (SLP-275): one-line
 * form (input + brand button) on desktop, stacked full-width on mobile.
 *
 * Styling lives directly on the markup as Tailwind utilities (TASK-7EYJ4C decision:
 * no dependency on the homepage.css lp-* classes — the form renders in the global
 * footer now). The `.field.field-reserved` wrapper is the validation message
 * container — without it the component wraps the input in an unstyled div inside
 * the flex row.
 *
 * SLP-306: the form is `lg:items-start`, NOT `lg:items-center` — hyva.formValidation
 * appends the error <ul class="messages"> INSIDE .field.field-reserved, growing the
 * field; with items-center the h-11 button re-centers against the taller field and
 * visibly drops below the input on desktop (SLP-306 screenshot: +11px). items-start
 * pins both to the top; the field then carries `lg:mt-0` to cancel forms.css
 * `.field { @apply mt-1 }` (4px) so input and button tops align exactly.
 *
 * @var \Launchpad\CmsContent\Block\Newsletter\Subscribe $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<form class="mx-auto flex w-full max-w-[1184px] flex-col gap-2 lg:flex-row lg:items-start lg:gap-2"
      action="<?= $escaper->escapeUrl($block->getFormActionUrl()) ?>"
      method="post"
      id="homepage-newsletter-form"
      x-data="initHomepageNewsletterForm"
      @submit="onSubmit"
      @change="onChange"
      aria-label="<?= $escaper->escapeHtmlAttr(__('Subscribe to our newsletter')) ?>">
    <label class="sr-only" for="homepage-newsletter-email">
        <?= $escaper->escapeHtml(__('Email Address')) ?>
    </label>
    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>">
    <div class="field field-reserved w-full lg:flex-1 lg:mt-0">
        <input class="h-11 w-full rounded-md border border-[#d1d5dc] bg-white px-3.5 text-[16px] leading-6 text-[#101828] placeholder:text-[#364153] focus:border-[#588f60] focus:outline-none"
               id="homepage-newsletter-email"
               name="email"
               type="email"
               required
               autocomplete="email"
               placeholder="<?= $escaper->escapeHtmlAttr(__('Enter your email address')) ?>">
    </div>
    <button class="h-11 w-full shrink-0 rounded-md bg-[#45744c] px-5 text-[16px] font-medium leading-6 text-white transition hover:bg-[#35573a] lg:w-[118px]"
            type="submit">
        <?= $escaper->escapeHtml(__('Subscribe')) ?>
    </button>
</form>
<script>
    function initHomepageNewsletterForm() {
        return hyva.formValidation(this.$el);
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHomepageNewsletterForm', initHomepageNewsletterForm);
    }, { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
