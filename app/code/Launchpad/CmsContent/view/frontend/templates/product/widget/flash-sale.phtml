<?php
/**
 * Flash Sale slider widget (TASK-0NNZCW v4, SLP-213).
 *
 * hr/min/sec box countdown (SLP-297: pill "Sale ending in" retired per Figma
 * 2151:17103) + product snap-slider (dots on mobile per design; desktop shows
 * no pager). Card pipeline = product_list_item (PLP parity).
 * Optional `title` option renders the heading in the recommended layout: with
 * title set, the widget IS the whole section — when the sale ends the
 * server-side gate renders nothing (BUG-9X14Y1), so heading + countdown +
 * slider disappear together. A widget WITHOUT a title leaves a dangling PB
 * heading behind when the sale ends. Optional `sale_end` (store-local
 * datetime): when it has passed, render nothing server-side; the Alpine
 * countdown's hide() stays as a client-side FPC-staleness guard, scoped to
 * the widget root only (never a Page Builder row — BUG-9X14Y1).
 *
 * @var \Launchpad\CmsContent\Block\Product\FlashSaleList $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\ProductListItem;
use Magento\Catalog\Block\Product\ReviewRendererInterface;

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var ProductListItem $productListItem */
$productListItem = $viewModels->require(ProductListItem::class);

$collection = $block->getProductCollection();
// Batch gallery AFTER createCollection (Elasticsuite plugin) has finished —
// see FlashSaleList::createCollection note.
if ($collection && !$collection->isLoaded()) {
    $collection->load();
}
if ($collection) {
    $collection->addMediaGalleryData();
}
$items = $collection ? $collection->getItems() : [];
$endMillis = (int) $block->getSaleEndMillis();
$title = trim((string) $block->getTitle());
?>
<?php if ($items && !$block->isSaleEnded()): ?>
    <div class="lp-flash relative">
        <?php if ($title !== ''): ?>
        <div class="lp-flash-head">
            <h2 class="lp-flash-title"><?= $escaper->escapeHtml($title) ?></h2>
        <?php endif; ?>
        <div class="lp-flash-countdown" x-data="lpFlashCountdown(<?= (int) $endMillis ?>)">
            <div class="lp-countdown-box">
                <span class="lp-countdown-cell">
                    <span class="lp-countdown-num" x-text="h">00</span>
                    <span class="lp-countdown-unit"><?= $escaper->escapeHtml(__('hr')) ?></span>
                </span>
                <span class="lp-countdown-sep" aria-hidden="true">:</span>
                <span class="lp-countdown-cell">
                    <span class="lp-countdown-num" x-text="m">00</span>
                    <span class="lp-countdown-unit"><?= $escaper->escapeHtml(__('min')) ?></span>
                </span>
                <span class="lp-countdown-sep" aria-hidden="true">:</span>
                <span class="lp-countdown-cell">
                    <span class="lp-countdown-num" x-text="s">00</span>
                    <span class="lp-countdown-unit"><?= $escaper->escapeHtml(__('sec')) ?></span>
                </span>
            </div>
        </div>
        <?php if ($title !== ''): ?>
        </div>
        <?php endif; ?>
        <div data-lp-slider data-lp-drag class="hp-pb-slider">
            <div data-track class="snap-track hp-pb-track lp-flash-track">
                <?php foreach ($items as $product) : ?>
                    <div class="w-full">
                        <?= /* @noEscape */ $productListItem->getItemHtml(
                            $product,
                            $block,
                            'grid',
                            ReviewRendererInterface::SHORT_VIEW,
                            'new_products_content_widget_grid',
                            false
                        ) ?>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
    <script>
        'use strict';
        function lpFlashCountdown(endMillis) {
            return {
                end: endMillis,
                h: '00',
                m: '00',
                s: '00',
                tick() {
                    const diff = Math.max(0, Math.floor((this.end - Date.now()) / 1000));
                    this.h = String(Math.floor(diff / 3600)).padStart(2, '0');
                    this.m = String(Math.floor((diff % 3600) / 60)).padStart(2, '0');
                    this.s = String(diff % 60).padStart(2, '0');
                },
                init() {
                    this.tick();
                    if (this.end <= Date.now()) {
                        // Sale already over (e.g. stale FPC page cache): hide
                        // the widget root immediately — never a PB row, other
                        // page content must survive (BUG-9X14Y1).
                        this.hide();
                        return;
                    }
                    this.timer = window.setInterval(() => {
                        this.tick();
                        if (this.end <= Date.now()) {
                            window.clearInterval(this.timer);
                            this.hide();
                        }
                    }, 1000);
                },
                hide() {
                    const root = this.$el.closest('.lp-flash');
                    if (root) root.style.display = 'none';
                }
            };
        }
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
