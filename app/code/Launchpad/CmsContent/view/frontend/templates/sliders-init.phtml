<?php
/**
 * One shared SnapSlider init (TASK-0NNZCW v4.3): card gallery sliders
 * ([data-lp-card-slider], auto pager = design mini dots) and section sliders
 * ([data-lp-slider], auto pager + grouped markers). Idempotent per element.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<script>
    'use strict';
    window.addEventListener('DOMContentLoaded', () => {
        if (typeof SnapSlider === 'undefined') return;
        // SLP-267: kéo chuột để cuộn category slider (scroll gốc chỉ nhận
        // touch/trackpad). Tắt snap khi kéo, thả ra thì trượt mượt về tile gần
        // nhất; chặn click link + native image drag sau khi đã kéo.
        // Dùng chung cho slider có [data-lp-drag] (flash sale, PB products
        // carousel — carousel do widget PB khởi tạo SnapSlider, không qua đây).
        const enableMouseDrag = (track) => {
            if (!track || track.dataset.lpMouseDrag) return;
            track.dataset.lpMouseDrag = '1';
            let startX = 0;
            let startLeft = 0;
            let dragging = false;
            let moved = false;
            track.addEventListener('pointerdown', (event) => {
                if (event.pointerType !== 'mouse' || event.button !== 0) return;
                dragging = true;
                moved = false;
                startX = event.clientX;
                startLeft = track.scrollLeft;
            });
            track.addEventListener('pointermove', (event) => {
                if (!dragging) return;
                // Nhả chuột ngoài track trước khi kịp kéo (chưa capture) →
                // không nhận pointerup; bỏ drag để hover sau đó không cuộn track.
                if (!(event.buttons & 1)) {
                    dragging = false;
                    return;
                }
                const dx = event.clientX - startX;
                if (!moved && Math.abs(dx) < 5) return;
                if (!moved) {
                    moved = true;
                    track.classList.add('is-dragging');
                    track.setPointerCapture(event.pointerId);
                }
                track.scrollLeft = startLeft - dx;
            });
            const endDrag = () => {
                if (!dragging) return;
                dragging = false;
                if (!moved) return;
                const base = track.firstElementChild ? track.firstElementChild.offsetLeft : 0;
                const target = Array.from(track.children)
                    .map((tile) => tile.offsetLeft - base)
                    .reduce((best, left) => (Math.abs(left - track.scrollLeft) < Math.abs(best - track.scrollLeft) ? left : best), 0);
                track.scrollTo({ left: target, behavior: 'smooth' });
                setTimeout(() => track.classList.remove('is-dragging'), 450);
            };
            track.addEventListener('pointerup', endDrag);
            track.addEventListener('pointercancel', endDrag);
            track.addEventListener('click', (event) => {
                if (!moved) return;
                event.preventDefault();
                event.stopPropagation();
                moved = false;
            }, true);
            track.addEventListener('dragstart', (event) => event.preventDefault());
        };
        // TASK-375K58 (SLP-267): auto_slide = marquee chạy liên tục vô hạn.
        // Clone đủ bộ tile (aria-hidden) rồi rAF tăng scrollLeft đều — qua mốc
        // 1 cycle thì trừ đi → quay vòng liền mạch (nội dung tại x ≡ x mod
        // cycle vì mọi bộ tile giống nhau). Track giữ nguyên scroll container
        // + bleed mép phải nên clip đúng vùng content → viewport edge. Pause
        // khi hover/focus; reduced-motion thì init loop chính giữ slider thường.
        const enableCatMarquee = (root, track) => {
            if (!root || !track || track.dataset.lpMarquee) return;
            track.dataset.lpMarquee = '1';
            const baseTiles = Array.from(track.children);
            if (baseTiles.length < 2) return;
            const duration = Math.max(5, Math.min(120, parseFloat(root.dataset.lpMarquee) || 30));
            // cycle = bề rộng 1 bộ tile + gap nối sang bộ kế (nối mạch khi wrap).
            const cycleWidth = () => {
                const first = baseTiles[0];
                const last = baseTiles[baseTiles.length - 1];
                const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
                return last.offsetLeft + last.offsetWidth - first.offsetLeft + gap;
            };
            let cycle = cycleWidth();
            const cloneSet = () => {
                baseTiles.forEach((tile) => {
                    const clone = tile.cloneNode(true);
                    clone.setAttribute('aria-hidden', 'true');
                    if (clone.tagName.toLowerCase() === 'a') {
                        clone.setAttribute('tabindex', '-1');
                    }
                    clone.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
                    track.appendChild(clone);
                });
            };
            // Đủ nội dung cho biên wrap: tại x = cycle vẫn thấy đầy khung
            // [cycle, cycle + clientWidth] → scrollWidth ≥ cycle + clientWidth.
            const ensureCoverage = () => {
                cycle = cycleWidth();
                let guard = 24;
                while (track.scrollWidth < cycle + track.clientWidth && guard--) cloneSet();
            };
            ensureCoverage();
            let paused = false;
            let last = performance.now();
            const tick = (now) => {
                // rAF dừng khi tab ẩn → dt lớn lúc quay lại, clamp để không nhảy.
                const dt = Math.min((now - last) / 1000, 0.05);
                last = now;
                if (!paused && dt > 0) {
                    track.scrollLeft += (cycle / duration) * dt;
                    if (track.scrollLeft >= cycle) track.scrollLeft -= cycle;
                }
                requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
            // Pause khi hover/focus (nội dung tự chạy phải dừng được).
            root.addEventListener('pointerenter', () => { paused = true; });
            root.addEventListener('pointerleave', () => { paused = false; });
            root.addEventListener('focusin', () => { paused = true; });
            root.addEventListener('focusout', (event) => {
                if (!root.contains(event.relatedTarget)) paused = false;
            });
            // Breakpoint đổi → tile width đổi → cycle đổi: đo lại, đưa
            // scrollLeft về biên mới, clone thêm nếu thiếu coverage.
            if ('ResizeObserver' in window) {
                new ResizeObserver(() => {
                    ensureCoverage();
                    if (track.scrollLeft >= cycle) track.scrollLeft %= cycle;
                }).observe(track);
            }
        };
        document.querySelectorAll('[data-lp-slider], [data-lp-card-slider], [data-lp-tiles-slider]').forEach((el) => {
            if (el.dataset.lpSliderInit) return;
            el.dataset.lpSliderInit = '1';
            // TASK-375K58: section [data-lp-marquee] (categories_a auto_slide)
            // = marquee thay hoàn toàn SnapSlider + kéo chuột. Reduced-motion
            // bỏ marquee → init slider thường như config Off.
            const marqueeRoot = el.closest('[data-lp-marquee]');
            if (marqueeRoot && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                enableCatMarquee(marqueeRoot, el.querySelector('[data-track]'));
                return;
            }
            // SLP-267: category tiles = 1 dot / tile (design) — không group.
            new SnapSlider(el, { autoPager: true, groupPager: !el.matches('[data-lp-tiles-slider]') });
            if (el.matches('[data-lp-tiles-slider]')) {
                enableMouseDrag(el.querySelector('[data-track]'));
            }
            // TASK-NAMVVC feedback r1 (SLP-235): card gallery kéo được bằng chuột
            // (dots chỉ là click; touch vẫn native). enableMouseDrag đã nuốt
            // click sau kéo + chặn native image drag.
            if (el.matches('[data-lp-card-slider]')) {
                enableMouseDrag(el.querySelector('[data-track]'));
            }
            // v4.9.2 (user): bấm dot của card gallery làm trượt cả product slider
            // ngoài. 2 nguyên nhân: (1) click bubble lên root slider ngoài,
            // SnapSlider ngoài cũng xử lý pager; (2) SnapSlider scroll bằng
            // `scrollIntoView` — cuộn MỌI ancestor cuộn được, kể cả track ngoài.
            // stopPropagation không chặn được (2) → chặn ở CAPTURE phase trên
            // root gallery, tự scroll track gallery bằng scrollTo (chỉ cuộn đúng
            // element đó), để SnapSlider không chạy handler gốc.
            if (el.matches('[data-lp-card-slider]')) {
                const scrollToSlide = (slideId) => {
                    const track = el.querySelector('[data-track]');
                    const slide = slideId && el.querySelector(`[id="${CSS.escape(slideId)}"]`);
                    if (!track || !slide) return;
                    const delta = slide.getBoundingClientRect().left - track.getBoundingClientRect().left;
                    track.scrollTo({ left: track.scrollLeft + delta, behavior: 'smooth' });
                };
                el.addEventListener('click', (event) => {
                    const marker = event.target.closest('[data-pager] a, [data-pager] button');
                    if (!marker) return;
                    event.preventDefault();
                    event.stopPropagation();
                    scrollToSlide(marker.getAttribute('href')?.slice(1) || marker.getAttribute('data-target-id'));
                }, true);
                el.addEventListener('keydown', (event) => {
                    if (!event.target.closest('[data-pager]')) return;
                    const keys = { ArrowRight: 'next', ArrowDown: 'next', ArrowLeft: 'prev', ArrowUp: 'prev' };
                    if (!keys[event.key]) return;
                    event.preventDefault();
                    event.stopPropagation();
                    const markers = Array.from(el.querySelectorAll('[data-pager] a, [data-pager] button'));
                    const current = markers.findIndex((m) => m.getAttribute('aria-current') === 'true');
                    const next = keys[event.key] === 'next' ? Math.min(current + 1, markers.length - 1) : Math.max(current - 1, 0);
                    if (markers[next]) scrollToSlide(markers[next].getAttribute('href')?.slice(1) || markers[next].getAttribute('data-target-id'));
                }, true);
            }
        });
        document.querySelectorAll('[data-lp-drag] > [data-track]').forEach(enableMouseDrag);
    });

    // SLP-269 (BUG-KATJXW): "Everyday more value" = rail PB columns
    // (overflow-x + scroll-snap) — touch vuốt native, chuột thì không kéo được.
    // Drag-to-scroll cho chuột; thả → trượt tới mép card kế tiếp theo hướng
    // kéo; đã kéo thì nuốt click để không mở link "→".
    window.addEventListener('DOMContentLoaded', () => {
        const firstCard = document.querySelector('.lp-promo-card');
        const rail = firstCard && firstCard.parentElement;
        if (!rail || rail.dataset.lpDrag) return;
        rail.dataset.lpDrag = '1';
        let drag = null;
        let moved = false;
        const cardOffsets = () => {
            const start = rail.getBoundingClientRect().left + rail.clientLeft;
            return Array.from(rail.children)
                .filter((c) => c.classList.contains('lp-promo-card'))
                .map((c) => c.getBoundingClientRect().left - start + rail.scrollLeft);
        };
        const settle = (target) => {
            const done = () => drag || rail.classList.remove('lp-promo-dragging');
            if (Math.abs(rail.scrollLeft - target) < 1) return done();
            rail.addEventListener('scrollend', done, { once: true });
            setTimeout(done, 700);
            rail.scrollTo({ left: target, behavior: 'smooth' });
        };
        rail.addEventListener('pointerdown', (event) => {
            if (event.pointerType !== 'mouse' || event.button !== 0) return;
            drag = { x: event.clientX, left: rail.scrollLeft };
            moved = false;
        });
        rail.addEventListener('pointermove', (event) => {
            if (!drag) return;
            const dx = event.clientX - drag.x;
            if (!moved && Math.abs(dx) < 5) return;
            if (!moved) {
                moved = true;
                rail.setPointerCapture(event.pointerId);
                rail.classList.add('lp-promo-dragging');
            }
            rail.scrollLeft = drag.left - dx;
        });
        const release = () => {
            if (!drag) return;
            const from = drag.left;
            drag = null;
            if (!moved) return;
            const current = rail.scrollLeft;
            const offsets = cardOffsets();
            const next = current > from
                ? offsets.find((o) => o > current + 1)
                : offsets.reverse().find((o) => o < current - 1);
            const max = rail.scrollWidth - rail.clientWidth;
            settle(Math.max(0, Math.min(next ?? current, max)));
        };
        rail.addEventListener('pointerup', release);
        rail.addEventListener('pointercancel', release);
        rail.addEventListener('dragstart', (event) => event.preventDefault());
        rail.addEventListener('click', (event) => {
            if (!moved) return;
            moved = false;
            event.preventDefault();
            event.stopPropagation();
        }, true);
    });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
