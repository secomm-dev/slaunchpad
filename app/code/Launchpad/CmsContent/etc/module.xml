<?xml version="1.0"?>
<!--
    Launchpad_CmsContent — homepage custom widgets + blocks (TASK-0NNZCW, SLP-213).
    Data patch only seeds CMS content (no schema changes).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module:etc/module.xsd">
    <module name="Launchpad_CmsContent">
        <sequence>
            <module name="Magento_CatalogWidget"/>
            <module name="Magento_Newsletter"/>
            <module name="Magefan_Blog"/>
        </sequence>
    </module>
</config>
