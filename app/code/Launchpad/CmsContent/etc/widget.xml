<?xml version="1.0"?>
<!--
    Flash Sale Products widget (TASK-0NNZCW v4): product slider with a
    "Sale ending in" countdown. sale_end accepts a store-local datetime
    (YYYY-MM-DD HH:MM:SS); when empty the countdown targets the next midnight.
-->
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="launchpad_flash_sale_products"
            class="Launchpad\CmsContent\Block\Product\FlashSaleList"
            is_email_compatible="true"
            ttl="86400">
        <label translate="true">Flash Sale Products (slider + countdown)</label>
        <description translate="true">Product slider with sale countdown for the LAUNCHPAD homepage</description>
        <parameters>
            <parameter name="products_count" xsi:type="text" required="true" visible="true">
                <label translate="true">Number of Products to Display</label>
                <value>8</value>
            </parameter>
            <parameter name="sale_end" xsi:type="text" required="false" visible="true">
                <label translate="true">Sale End (YYYY-MM-DD HH:MM:SS, store time)</label>
                <description translate="true">Countdown target. Leave empty to count down to the next midnight.</description>
            </parameter>
            <parameter name="cache_lifetime" xsi:type="text" visible="true">
                <label translate="true">Cache Lifetime (Seconds)</label>
            </parameter>
            <parameter name="condition" xsi:type="conditions" visible="true" required="true" sort_order="10"
                       class="Magento\CatalogWidget\Block\Product\Widget\Conditions">
                <label translate="true">Conditions</label>
            </parameter>
        </parameters>
        <containers>
            <container name="content">
                <template name="flash-sale" value="default"/>
            </container>
        </containers>
    </widget>
</widgets>
