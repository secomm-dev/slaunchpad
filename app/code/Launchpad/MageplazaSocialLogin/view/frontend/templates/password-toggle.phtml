<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsSolid;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\View\Element\Template;

/**
 * Show/hide toggle (eye icon) for every password input inside the configured
 * roots (TASK-YHCJ79). Rendered on Hyvä pages for the Mageplaza popups and on
 * the OSC checkout page, which runs in the luma scope (LL-0011) — so the script
 * is plain JS (no Alpine / KO / jQuery) and the styles carry the token fallbacks
 * of social-login-checkout.css. Vendor templates stay untouched: the toggle is
 * inserted next to each input, and inputs rendered later (KO checkout forms,
 * Alpine x-if popups) are picked up by a MutationObserver.
 */

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp|null $hyvaCsp Hyvä themes only — not set on the luma OSC page */

$heroicons = $viewModels->require(HeroiconsSolid::class);
$rootSelectors = array_values((array) $block->getData('root_selectors'));
$config = [
    'roots' => $rootSelectors,
    'labels' => ['show' => (string) __('Show Password'), 'hide' => (string) __('Hide Password')],
    'icons' => [
        'show' => $heroicons->eyeHtml('', 20, 20, ['aria-hidden' => 'true']),
        'hide' => $heroicons->eyeOffHtml('', 20, 20, ['aria-hidden' => 'true']),
    ],
];
?>
<style>
    .lp-password-toggle-host {
        position: relative;
        isolation: isolate;
    }
    .lp-password-toggle-host input.lp-password-toggle-input {
        padding-right: 44px;
    }
    .lp-password-toggle-host > .lp-password-toggle {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        color: var(--color-ink-muted, #4a5565);
        cursor: pointer;
        user-select: none;
    }
    .lp-password-toggle-host > .lp-password-toggle:hover {
        color: var(--color-ink, #101828);
    }
    .lp-password-toggle-host > .lp-password-toggle:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: -4px;
    }
    .lp-password-toggle-host > .lp-password-toggle svg {
        display: block;
        width: 20px;
        height: 20px;
    }
</style>
<script>
    (() => {
        const config = <?= /* @noEscape */ json_encode($config, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
        const toggles = new WeakMap();

        // Pinned to the input's own box, not to the host: Hyvä validation may
        // wrap the input in a new div.field-reserved after the first submit, and
        // some OSC inputs are narrower than their .control. Layout offsets, not
        // getBoundingClientRect(): the popups open with a scale transition.
        const place = (input, toggle) => {
            const host = toggle.offsetParent;
            let top = 0;
            let left = 0;
            let node = input;
            while (node && node !== host) {
                top += node.offsetTop;
                left += node.offsetLeft;
                node = node.offsetParent;
            }
            if (!host || node !== host) {
                return;
            }
            toggle.style.top = top + 'px';
            toggle.style.left = (left + input.offsetWidth - toggle.offsetWidth) + 'px';
            toggle.style.height = input.offsetHeight + 'px';
        };

        const setShown = (input, toggle, shown) => {
            input.type = shown ? 'text' : 'password';
            toggle.innerHTML = shown ? config.icons.hide : config.icons.show;
            toggle.setAttribute('aria-pressed', shown ? 'true' : 'false');
            toggle.setAttribute('aria-label', shown ? config.labels.hide : config.labels.show);
            toggle.title = shown ? config.labels.hide : config.labels.show;
        };

        const resizeObserver = new ResizeObserver(entries => {
            entries.forEach(entry => place(entry.target, toggles.get(entry.target)));
        });

        // A span with role="button", not a <button>: both host pages style every
        // button by tag (Hyvä popup `#popup_test button`, OSC design color
        // `.checkout-container button:not(...) !important`).
        const enhance = input => {
            if (input.dataset.lpPasswordToggle || !input.parentElement) {
                return;
            }
            input.dataset.lpPasswordToggle = '1';
            const toggle = document.createElement('span');
            toggle.className = 'lp-password-toggle';
            toggle.setAttribute('role', 'button');
            toggle.tabIndex = 0;
            if (input.id) {
                toggle.setAttribute('aria-controls', input.id);
            }
            input.classList.add('lp-password-toggle-input');
            input.parentElement.classList.add('lp-password-toggle-host');
            input.insertAdjacentElement('afterend', toggle);
            setShown(input, toggle, false);
            const flip = () => {
                setShown(input, toggle, input.type === 'password');
                place(input, toggle);
            };
            toggle.addEventListener('click', flip);
            toggle.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    flip();
                }
            });
            toggles.set(input, toggle);
            resizeObserver.observe(input);
        };

        const scan = node => {
            if (node.matches('input[type="password"]')) {
                enhance(node);
            }
            node.querySelectorAll('input[type="password"]').forEach(enhance);
        };

        const init = () => config.roots.forEach(selector => {
            document.querySelectorAll(selector).forEach(root => {
                scan(root);
                new MutationObserver(records => records.forEach(record => {
                    record.addedNodes.forEach(node => node.nodeType === Node.ELEMENT_NODE && scan(node));
                })).observe(root, {childList: true, subtree: true});
            });
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
<?php if (isset($hyvaCsp)): ?>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
