<?xml version="1.0"?>
<!--
/**
 * Launchpad_MageplazaSocialLogin — Hyvä pages wiring. The hyva_default handle
 * only exists on Hyvä themes, so the luma popup of the OSC checkout (LL-0011)
 * is untouched.
 *
 * - Show/hide password toggle (TASK-YHCJ79) on the password inputs of the
 *   Mageplaza popups: the sign-in / create / request-info modal and the
 *   checkout authentication popup.
 * - Popup login redirect (BUG-C97F09 / SLP-207): swaps the vendor Hyvä sign-in
 *   form template for the module copy that honors
 *   customer/startup/redirect_dashboard after a successful popup login.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block name="launchpad.sociallogin.password.toggle"
                   template="Launchpad_MageplazaSocialLogin::password-toggle.phtml">
                <arguments>
                    <argument name="root_selectors" xsi:type="array">
                        <item name="popup" xsi:type="string">#social-login-popup</item>
                        <item name="checkout_auth" xsi:type="string">#authentication-popup</item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="social-login-popup-authentication"
                        template="Launchpad_MageplazaSocialLogin::hyva/popup/form/authentication.phtml"/>
    </body>
</page>
