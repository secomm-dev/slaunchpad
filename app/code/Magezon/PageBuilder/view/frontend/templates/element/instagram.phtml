/** @var $block \Magezon\PageBuilder\Block\Element\Instagram */

$element = $this->getElement();
$options = [
    'onclick'       => $element->getOnclick(),
    'html_id'       => $element->getHtmlId(),
    'swipe_options' => [],
    'token'         => $block->getInstagramToken(),
    'max_items'     => (int)$element->getMaxItems()
];
?>
<div class="mgz-block">
    <?php if ($block->getElementTitle() || $block->getElementDescription()) { ?>
    <div class="mgz-block-heading mgz-block-heading-align-<?= $block->escapeHtmlAttr($element->getTitleAlign()) ?><?= $element->getShowLine() ? ' mgz-block-heading-line' : '' ?> mgz-block-heading-line-position-<?= $block->escapeHtmlAttr($element->getLinePosition()) ?>">
        <?php if ($block->getElementTitle()) { ?>
        <<?= $block->escapeHtmlAttr($block->getTitleTag()) ?> class="title"><?= /* @noEscape */ $block->getElementTitle() ?></<?= $block->escapeHtmlAttr($block->getTitleTag()) ?>>
<?php } ?>
    <?php if ($block->getElementDescription()) { ?>
        <div class="info"><?= /* @noEscape */ $block->getElementDescription() ?></div>
    <?php } ?>
</div>
<?php } ?>
<div class="mgz-block-content">
    <div id="instagram-api-data" class="mgz-grid <?= $block->escapeHtmlAttr($element->getHoverEffect() ? 'mgz-image-hovers' : '') ?> <?= ($element->getOnclick()=='photoswipe') ? 'mgz-photoswipe' : '' ?> mgz-instagram <?= ($element->getOnclick() == 'magnific') ? 'mgz-magnific-gallery' : '' ?>  mgz-grid-col-xl-<?= $block->escapeHtmlAttr($element->getItemXl()) ?> mgz-grid-col-lg-<?= $block->escapeHtmlAttr($element->getItemLg()) ?> mgz-grid-col-md-<?= $block->escapeHtmlAttr($element->getItemMd()) ?> mgz-grid-col-sm-<?= $block->escapeHtmlAttr($element->getItemSm()) ?> mgz-grid-col-xs-<?= $block->escapeHtmlAttr($element->getItemXs()) ?>"  <?php if($element->getOnclick()=='photoswipe') { ?>data-pswp-uid="1"<?php } ?> data-type="gallery" data-mage-init='{"Magezon_PageBuilder/js/instagram":<?= $block->escapeHtmlAttr(json_encode($options)) ?>}'>
    </div>
    <?php if ($element->getLinkText()) { ?>
        <a href="<?= $block->escapeUrl($block->getFollowLink($element->getInstagramUsername())) ?>" target="_blank"><?= $block->escapeHtml($element->getLinkText()) ?></a>
    <?php } ?>

    <script id="instagram-items" type="text/x-magento-template" data-template="instagram-gallery">
        <div id="<%- item.id %>" class="<?= ($element->getOnclick()=='photoswipe') ? 'mgz-photoswipe-item' : '' ?> mgz-grid-item">
            <?php if ($element->getOnclick()) { ?>
                a href="<%- item.media_url %>" class="mgz-flex-position-middle-center <?= $block->escapeHtmlAttr($element->getHoverEffect() ? 'hover-type-' . $element->getHoverEffect() : '') ?>" data-size="<?= $block->escapeHtmlAttr($block->getDataSize()) ?>" title="<%- item.caption %>" target="<?= $block->escapeHtmlAttr($element->getLinkTarget()) ?>">
            <?php } ?>
                    <img src="<%- item.media_url %>"/>
                    <figure><%- item.caption %></figure>
            <?php if ($element->getOnclick()) { ?>
                </a>
            <?php } ?>
        </div>
    </script>
</div>
