$availableSocials = $block->getAvailableSocials();
if (sizeof($availableSocials)) :
    ?>
    <div class="block social-login-authentication-channel account-social-login">
        <strong class="box-title">
            <span>You also can log-in via Social Account</span>
        </strong>
        <div class="block-content">
            <?php /** @var array $availableSocials */
            foreach ($availableSocials as $key => $social) : ?>
                <div class="actions-toolbar social-btn social-btn-actions-toolbar <?= /* @noEscape */ $key ?>-login">
                    <a class="btn btn-block btn-social btn-<?= /* @noEscape */ $block->getBtnKey($key) ?>"
                       data-mage-init='{"socialProviderAd": {"url": "<?= $escaper->escapeUrl($social['login_url']) ?>", "label": "<?= /* @noEscape */ __(
                           'Login By %1',
                           $social['label']
                       ) ?>"}}'>
                        <span class="fa fa-<?= /* @noEscape */ $block->getBtnKey($key) ?>"></span>
                        <?= /* @noEscape */ __($social['label']) ?>
                    </a>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
