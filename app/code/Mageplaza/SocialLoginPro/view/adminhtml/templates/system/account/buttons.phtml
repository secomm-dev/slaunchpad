use Mageplaza\SocialLoginPro\Block\Adminhtml\Social;

/**
 * @var Social $block
 */
/** @var \Magento\Framework\Escaper $escaper */

$availableSocials = $block->getAvailableSocials();

if (sizeof($availableSocials)) :
    ?>
    <div class="block social-login-authentication-channel account-social-login">
        <div class="block-content">
            <?php foreach ($availableSocials as $key => $social) : ?>
                <div class="actions-toolbar social-btn social-btn-actions-toolbar <?= /* @noEscape */ /* @noEscape */ $key ?>-login">
                    <a class="btn btn-block btn-social btn-<?= /* @noEscape */ $block->getBtnKey($key) ?>" data-mage-init='{"socialProviderAd": {
                        "url": "<?= /* @noEscape */ $escaper->escapeHtml($social['login_url']) ?>",
                        "label": "<?= /* @noEscape */ __('Login By %1', $social['label']) ?>",
                        "type" : "<?= /* @noEscape */ $social['label'] ?>",
                        "status" : "<?= /* @noEscape */ $social['connected'] ?>",
                        "disconnect_url" : "<?= $escaper->escapeUrl($social['disconnect_url']) ?>",
                        "pd_url" : "<?= $escaper->escapeUrl($social['pd_url']) ?>",
                        "id" : "<?= /* @noEscape */ $social['id'] ?>"
                    }}'>
                        <span class="fa fa-<?= /* @noEscape */ $block->getBtnKey($key) ?>"></span>
                        <span class="state"><?= $escaper->escapeUrl(__($social['connected'] ? 'Disconnect' : $social['label'])) ?></span>
                    </a>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
