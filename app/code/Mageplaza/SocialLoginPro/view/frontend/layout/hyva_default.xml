<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="modal-dialog">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Mageplaza_SocialLoginPro::hyva/header/modal.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="customer.header.sign.in.link">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Mageplaza_SocialLoginPro::hyva/header/link/sign-in.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="customer.header.register.link">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Mageplaza_SocialLoginPro::hyva/header/link/register.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="social-quick-login" remove="true"/>
    </body>
</page>
