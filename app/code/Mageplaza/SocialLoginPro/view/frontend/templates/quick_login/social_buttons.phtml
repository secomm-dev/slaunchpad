use Mageplaza\SocialLogin\Model\System\Config\Source\Position;
?>
<?php
/** @var \Mageplaza\SocialLogin\Block\Popup\Social $block */
$availableSocials = $block->getAvailableSocials();
?>
<?php if ($block->canShow(Position::PAGE_POPUP) && sizeof($availableSocials)) : ?>
    <div class="block social-login-authentication-channel col-mp mp-12">
        <div class="block-content-social">
            <?php foreach ($availableSocials as $key => $social) : ?>
                <div class="actions-toolbar social-btn <?= /* @noEscape */ $key ?>-login col-mp mp-6 mp-xs-6">
                    <a class="btn btn-block btn-social btn-<?= /* @noEscape */ $block->getBtnKey($key) ?>"
                       data-mage-init='{"socialProvider": {"url": "<?= $escaper->escapeUrl($social['login_url']) ?>", "label": "<?= /* @noEscape */ __('Login By %1', $social['label']) ?>"}}'>
                        <span class="fa fa-<?= /* @noEscape */ $block->getBtnKey($key) ?>"></span>
                        <?= /* @noEscape */ __($social['label']) ?>
                    </a>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>

<?php $authenConfig = $block->getSocialButtonsConfig();?>
<?php if ($block->canShow(Position::PAGE_AUTHEN) && sizeof($availableSocials)) : ?>
    <script>
        window.socialAuthenticationPopup = <?= /* @noEscape */  \Mageplaza\Core\Helper\AbstractData::jsonEncode($authenConfig); ?>;
    </script>
<?php endif; ?>

