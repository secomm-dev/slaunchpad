/** @var ThreeColumns $block */

use Mageplaza\OscUltimate\Block\Adminhtml\Layout\ManageBlock\ThreeColumns;

$data = [];

foreach ($block->getSortedFields() as $value) {
    $data[$value[0]] = $value[1];
}

?>
<ul class="sortable-list ui-sortable mp-col-1">
    <?php foreach ($data['mp-col-1'] as $item): ?>
        <li class="sortable-item "
            data-code="<?= /* @noEscape */ $item ?>">
            <i class="fa fa-grip-vertical"></i>
            <?php if ($item === 'addressInformation'): ?>
                <i class="fa fa-home"></i>
                <span><?= $block->escapeHtml(__('Address Information')) ?></span>
            <?php elseif ($item === 'shippingMethod'): ?>
                <i class="fa fa-truck"></i>
                <span><?= $block->escapeHtml(__('Shipping Method')) ?></span>
