<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Mageplaza_Lookbook::lookbookslider" title="Mageplaza Lookbook" translate="title"
                              sortOrder="100">
                        <resource id="Mageplaza_Lookbook::lookbook" title="Manage Lookbook" translate="title"
                                  sortOrder="10"/>
                        <resource id="Mageplaza_Lookbook::lookbookedit" title="Create/Edit Lookbook" translate="title"
                                  sortOrder="15"/>
                        <resource id="Mageplaza_Lookbook::slider" title="Manage Lookbook Slider" translate="title"
                                  sortOrder="20"/>
                        <resource id="Mageplaza_Lookbook::slideredit" title="Create/Edit Slider" translate="title"
                                  sortOrder="25"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mageplaza_Lookbook::configuration" title="Mageplaza Lookbook"
                                      sortOrder="100"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>