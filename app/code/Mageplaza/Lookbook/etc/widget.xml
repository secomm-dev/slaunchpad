<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget class="Mageplaza\Lookbook\Block\Widget" id="mageplaza_lookbook_slider_widget">
        <label translate="true">Mageplaza Lookbook Slider</label>
        <description translate="true">Mageplaza Lookbook Slider List</description>
        <parameters>
            <parameter name="slider_id" xsi:type="block" visible="true" required="true" sort_order="20">
                <label translate="true">Slider</label>
                <block class="Mageplaza\Lookbook\Block\Adminhtml\Slider\Widget\Chooser">
                    <data>
                        <item name="button" xsi:type="array">
                            <item name="open" xsi:type="string" translate="true">Select Slider...</item>
                        </item>
                    </data>
                </block>
            </parameter>
        </parameters>
    </widget>
    <widget class="Mageplaza\Lookbook\Block\Lookbook" id="mageplaza_lookbook_widget">
        <label translate="true">Mageplaza Lookbook</label>
        <description translate="true">Mageplaza Lookbook List</description>
        <parameters>
            <parameter name="lookbook_id" xsi:type="block" visible="true" required="true" sort_order="20">
                <label translate="true">Lookbook</label>
                <block class="Mageplaza\Lookbook\Block\Adminhtml\Lookbook\Widget\Chooser">
                    <data>
                        <item name="button" xsi:type="array">
                            <item name="open" xsi:type="string" translate="true">Select Lookbook...</item>
                        </item>
                    </data>
                </block>
            </parameter>
        </parameters>
    </widget>
</widgets>
