                <block class="Mageplaza\ThankYouPage\Block\Adminhtml\Template\Edit\Tab\Condition" name="mpthankyoupage_template_edit_tab_condition" as="condition"/>
                <block class="Mageplaza\ThankYouPage\Block\Adminhtml\Template\Edit\Tab\Display" name="mpthankyoupage_template_edit_tab_display" as="display"/>
            </block>
        </referenceContainer>
    </body>
