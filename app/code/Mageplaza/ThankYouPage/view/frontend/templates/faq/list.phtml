/** @var Mageplaza\ThankYouPage\Block\Faq $block */
/** @var \Mageplaza\Faqs\Model\ResourceModel\Article\Collection $articles */

?>

<?php
if ($block->getType() === 'order' && $block->isOrderSuccessPageEnable()) {
    $title    = $block->getOrderFaqTitle();
    $articles = $block->getOrderFaqs();
    $limit    = $block->getOrderFaqLimit();
} elseif ($block->getType() === 'newsletter') {
    $title    = $block->getNewsletterFaqTitle();
    $articles = $block->getNewsletterFaqs();
    $limit    = $block->getNewsletterFaqLimit();
} else {
    $title    = 'FAQs';
    $articles = null;
    $limit    = null;
} ?>
<?php if ($articles != null && $limit != null && $limit != 0): ?>
    <div id="mpfaqs-list-container" class="col-mp mp-12 mpfaqs-list mpfaqs">
        <div class="mpfaqs-list__block">
            <div class="section grey lighten-5 row">
                <div class="faq-title">
                    <h4><?= /** @noEscape */ __($title) ?></h4>
                </div>
                <?php $iterator = 1; ?>
                <ul class="mpfaqs-list__block__question collapsible">
                    <?php foreach ($articles as $article): ?>
                        <?php $isOverLimit = $iterator++ > $limit ? 'style="display: none"' : ''; ?>
                        <li class="mpfaqs-item" <?= /** @noEscape */ $isOverLimit ?>>
                            <div class="collapsible-header in-active"
                                 data-id="<?= /** @noEscape */ $article->getId() ?>">
                                <span>
                            <?php if ($block->isCollapsible()): ?>
                                <i class="far fa-file-alt"></i>
                                <?= /** @noEscape */ $article->getName(); ?>
                            <?php else: ?>
                                <a href="<?= $block->escapeUrl($article->getUrl()) ?>">
                                        <i class="far fa-file-alt"></i>
                                        <?= /** @noEscape */ $article->getName() ?>
                                    </a>
                            <?php endif; ?>
                                </span>
                            </div>
                            <div id="mpfaqs-list__block__question__content--<?= /** @noEscape  */ $article->getId() ?>"
                                 class="collapsible-body">
                                <?php if ($article->getShortAnswer()): ?>
                                    <?php if ($block->getHelperData()->isEnabledDetailPage()): ?>
                                        <p><?= /** @noEscape */ $block->getHelperData()->getPageFilter($article->getShortAnswer()) ?>
                                            <br>
                                            <a href="<?= $block->escapeUrl($article->getUrl()) ?>"><?= /** @noEscape */ __('Read more') ?></a>
                                        </p>
                                    <?php else: ?>
                                        <p><?= /** @noEscape */ $block->getHelperData()->getPageFilter($article->getArticleContent()) ?></p>
                                    <?php endif; ?>
                                <?php else: ?>
                                    <p><?= /** @noEscape */ __('There is no answer for this question.') ?></p>
                                <?php endif; ?>
                            </div>
                        </li>
                    <?php endforeach; ?>
                    <div class="view-all-faq"><i class="fas fa-angle-double-down"></i>
                        <a class="load-more"> <?= /** @noEscape */ __('View all') ?></a>
                    </div>
                </ul>
            </div>
        </div>

        <script type="text/javascript">
            require(['jquery'], function ($) {
                var faqCount;
                var hiddenfaqItem;
                var visiblefaqItem;
                var limitCount    = '<?= /** @noEscape */ $limit; ?>';
                var isCollapsible = '<?= /** @noEscape */ $block->isCollapsible()?>';

                $('.mpfaqs-list__block').each(function () {
                    var el   = this;
                    faqCount = $(el).find('.mpfaqs-list__block__question li.mpfaqs-item').length;
                    $(el).find('.mpfaqs-list__block__question li.mpfaqs-item').slice(0, limitCount).show();
                    if (faqCount <= limitCount) {
                        $(el).find('.view-all-faq').hide();
                    } else {
                        $(el).find('.view-all-faq a').on('click', function () {
                            hiddenfaqItem  = $(el).find('.mpfaqs-list__block__question li.mpfaqs-item:hidden');
                            visiblefaqItem = $(el).find('.mpfaqs-list__block__question li.mpfaqs-item');
                            if ($(this).hasClass("load-more")) {
                                hiddenfaqItem.slideDown('fast');
                                $(this).parent().find('i').removeClass('fa-angle-double-down').addClass('fa-angle-double-up');
                                $(this).removeClass('load-more').addClass('back-to-top');
                                $(this).html('<a> <?= /** @noEscape */ __('Collapse') ?></a>');
                            } else {
                                visiblefaqItem.slice(limitCount, visiblefaqItem.length).slideUp('fast');
                                $(this).parent().find('i').removeClass('fa-angle-double-up').addClass('fa-angle-double-down');
                                $(this).removeClass('back-to-top').addClass('load-more');
                                $(this).html('<a> <?= /** @noEscape */ __('View all') ?></a>');
                            }
                        });
                    }
                });
                if (isCollapsible) {
                    //collapsible
                    $('.mpfaqs-list__block__question li .collapsible-header').each(function () {
                        $(this).on('click', function () {
                            if ($(this).hasClass('in-active')) {
                                $(this).removeClass('in-active').addClass('active');
                                $('#mpfaqs-list__block__question__content--' + $(this).attr('data-id')).slideDown('fast');
                            } else {
                                $(this).removeClass('active').addClass('in-active');
                                $('#mpfaqs-list__block__question__content--' + $(this).attr('data-id')).slideUp('fast');
                            }
                        });
                    });
                }
            });
        </script>
    </div>
    <style type="text/css">
        .collapsible-body {
            display: none;
        }

        li.mpfaqs-item {
            list-style: none;
        }

        .mpfaqs-list__block__question .collapsible-header a {
            color: inherit;
        }

        .mpfaqs a {
            text-decoration: none;
        }

        .mpfaqs .collapsible-header i {
            width: 2rem;
            font-size: 1.6rem;
            display: inline-block;
            text-align: center;
            margin-right: 1rem;
        }

        .mpfaqs-list__block__question .collapsible-header i {
            color: #ccc;
        }
    </style>
<?php endif; ?>

