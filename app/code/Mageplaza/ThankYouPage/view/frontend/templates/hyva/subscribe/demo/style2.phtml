<div class="mp-container style2">
    <div class="mp-content">
        <div class="title"><?= /** @noEscape */ $block->getPageTitle() ?></div>
        <div class="subtitle"><?= /** @noEscape */ $block->getPageSubTitle() ?></div>
        <div class="description"><?= /** @noEscape */ $block->getPageDescription() ?></div>
        <div class="additional" style="text-align: center;">
            <?php if ($block->checkEnableCoupon()): ?>
                <div class="order-coupons mp-gray">
                    <p><?= $block->getCouponHtml(); ?></p>
                </div>
            <?php endif; ?>
            <?php if ($block->checkEnableSocialShare()): ?>
                <div class="sharethis-button">
                    <div class="sharethis-inline-share-buttons"></div>
                    <script type="text/javascript">
                        document.addEventListener('DOMContentLoaded', function() {
                            var script = document.createElement('script');
                            script.src = "https://platform-api.sharethis.com/js/sharethis.js#property=<?= /* @noEscape */ $block->getSharethisKey() ?>&product=inline-share-buttons&source=platform";
                            script.async = true;
                            document.body.appendChild(script);
                        });
                    </script>
                </div>
            <?php endif; ?>
        </div>
        <div class="flex justify-center">
            <a class="action primary continue mp-xs-3 font-semibold btn" href="<?= /* @noEscape */ $block->getContinueUrl() ?>">
