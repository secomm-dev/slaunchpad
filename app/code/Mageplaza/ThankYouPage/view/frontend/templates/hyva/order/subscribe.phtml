/** @var Mageplaza\ThankYouPage\Block\OrderSuccess $block */
?>
<?php
if (!$block->checkCustom() && $block->checkEnableBlock('subscribe')):?>
    <div class="mp-newsletter mp-xs-12 col-mp mp-5 relative z-10">
        <p class="font-bold"><?= $block->escapeHtml(__('Sign Up for Our Newsletter')) ?></p>
        <p><?= $block->escapeHtml(__("For every updated news, events, promotion or loyalty programs")); ?></p>
        <div class="content">
            <form class="form subscribe"
                  action="<?= $block->escapeUrl($block->getFormActionUrl()) ?>"
                  method="post"
                  x-data="{...initSubscribeForm(), ...hyva.formValidation($el)}"
                  @submit="formSubmit"
                  id="newsletter-validate-detail">
                <div class="field newsletter">
                    <div class="control">
                        <label for="newsletter"></label>
                        <input name="email" type="email" id="newsletter" class="form-input w-full"
                               value="<?= /** @noEscape */ $block->getEmailAddress() ?>"
                               @change="onChange"
                               data-validate='{"required":true}'/>
                    </div>
                </div>
                <div class="actions">
                    <button class="action subscribe primary" title="<?= $block->escapeHtml(__('Subscribe')) ?>"
                            type="submit">
                        <span><?= $block->escapeHtml(__('Subscribe')) ?></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script>
        function initSubscribeForm () {
            return {
                formSubmit: function (e) {
                    e.preventDefault();
                    const formAction = e.target.getAttribute('action');
                    const formData = new FormData(e.target);
                    formData.append('form_key', hyva.getFormKey());

                    this.validate().then(() => {
                        fetch(formAction, {
                            method: 'POST',
                            body: formData
                        }).then(response => {
                            if (response.ok && response.redirected) {
                                window.location.href = response.url;
                            }
                        })

                    })
                }
            }
        }
    </script>
<?php endif; ?>
