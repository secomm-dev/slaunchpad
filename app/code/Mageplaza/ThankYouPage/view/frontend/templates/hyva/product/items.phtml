/** @var \Mageplaza\ThankYouPage\Block\Product\CrossSell $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Hyva\Theme\Model\ViewModelRegistry $viewModels */

use Hyva\Theme\ViewModel\Slider;
use Mageplaza\ThankYouPage\Model\Config\Source\Additional;

/** @var Slider $sliderViewModel */
$sliderViewModel   = $viewModels->require(Slider::class);
$itemTemplate      = 'Mageplaza_ThankYouPage::hyva/product/item.phtml';
$containerTemplate = 'Mageplaza_ThankYouPage::hyva/product/product-slider-container.phtml';
?>
<?php if ($block->isOrderSuccessPageEnable()): ?>
    <?php
    $mode  = 'grid';
    $title = $block->getTitleProductSlider();

    $showCart          = $block->canShow(Additional::SHOW_CART);
    $showAddToWishlist = $block->canShow(Additional::SHOW_WISHLIST);
    $showAddToCompare  = $block->canShow(Additional::SHOW_COMPARE);
    $showReview        = $block->canShow(Additional::SHOW_REVIEW);
    $items             = $block->getProductCollection();
    if (!empty($items)): ?>
        <?=
        $sliderHtml = $sliderViewModel->getSliderForItems($itemTemplate,
            $items, $containerTemplate)
            ->setData('title', $title)
            ->setData('hide_rating_summary', !$showReview)
            ->setData('show_cart', $showCart)
            ->setData('show_add_to_wishlist', $showAddToWishlist)
            ->setData('show_add_to_compare', $showAddToCompare)
            ->toHtml();
        ?>
    <?php endif; ?>
<?php endif; ?>

