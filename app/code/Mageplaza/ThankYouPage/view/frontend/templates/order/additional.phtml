<?php /** @var Mageplaza\ThankYouPage\Block\OrderSuccess $block */
if ($block->getStyle() == Mageplaza\ThankYouPage\Model\Config\Source\OrderPageStyle::SIMPLE): ?>
    <div class="mp-simple">
        <div class="additional">
            <?php if ($block->checkEnableBlock('social_sharing')): ?>
                <div class="sharethis-button">
                    <div class="sharethis-inline-share-buttons"></div>
                    <script type="text/javascript">
                        document.addEventListener('DOMContentLoaded', function() {
                            var script = document.createElement('script');
                            script.src = "https://platform-api.sharethis.com/js/sharethis.js#property=<?= /* @noEscape */ $block->getSharethisKey() ?>&product=inline-share-buttons&source=platform";
                            script.async = true;
                            document.body.appendChild(script);
                        });
                    </script>
                </div>
            <?php endif; ?>

            <?= /** @noEscape */ $block->getCouponHtml() ?>

            <?php if ($block->getContinueUrl()): ?>
                <div class="mp-actions-toolbar">
                    <div class="primary" style="float: none;">
                        <a class="action primary continue mp-xs-3" href="<?= /** @noEscape */ $block->getContinueUrl() ?>">
                            <span><?= /** @noEscape */ __('Continue Shopping') ?></span>
                        </a>
                    </div>
                </div>
            <?php endif; ?>
        </div>
    </div>
<?php else: ?>
    <div class="mp-complex">
        <div class="additional">
            <?php if ($block->checkEnableBlock('social_sharing')): ?>
                <div class="sharethis-button">
                    <div class="sharethis-inline-share-buttons"></div>
                    <script type="text/javascript">
                        document.addEventListener('DOMContentLoaded', function() {
                            var script = document.createElement('script');
                            script.src = "https://platform-api.sharethis.com/js/sharethis.js#property=<?= /* @noEscape */ $block->getSharethisKey() ?>&product=inline-share-buttons&source=platform";
                            script.async = true;
                            document.body.appendChild(script);
                        });
                    </script>
                </div>
            <?php endif; ?>

            <div class="order-coupons">
                <p><?= /** @noEscape */ $block->getCouponHtml() ?></p>
            </div>

            <?php if ($block->getContinueUrl()): ?>
                <div class="mp-actions-toolbar">
                    <div class="primary" style="float: none;">
                        <a class="action primary continue mp-xs-3"
                           href="<?= /** @noEscape */ $block->getContinueUrl() ?>"><span><?= /** @noEscape */ __('Continue Shopping') ?></span></a>
                    </div>
                </div>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>
