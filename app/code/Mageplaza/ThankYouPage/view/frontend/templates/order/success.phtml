/** @var \Mageplaza\ThankYouPage\Block\OrderSuccess $block */
if ($block->isEnable()): ?>
    <div class="mp-checkout-success">
        <?php if (!$block->checkCustom()
            && $block->getStyle() === Mageplaza\ThankYouPage\Model\Config\Source\OrderPageStyle::SIMPLE): ?>
            <?= /** @noEscape */ $block->getChildHtml($block->getStyle()) ?>
            <?= /** @noEscape */ $block->getChildHtml('static_block_1') ?>
            <?= /** @noEscape */ $block->getChildHtml('order_detail') ?>
            <?= /** @noEscape */ $block->getChildHtml('additional') ?>
            <?= /** @noEscape */ $block->getChildHtml('mp_registration') ?>
            <?= /** @noEscape */ $block->getChildHtml('mp_subscribe') ?>
            <?= /** @noEscape */ $block->getChildHtml('static_block_2') ?>
        <?php elseif (!$block->checkCustom()
            && $block->getStyle() === Mageplaza\ThankYouPage\Model\Config\Source\OrderPageStyle::COMPLEX): ?>
            <?php if (!empty($block->getStaticBlock2()) || $block->getStaticBlock2() != 0): ?>
                <div class="col-mp mp-7">
                    <?= /** @noEscap
                     * e */ $block->getChildHtml($block->getStyle()) ?>
                </div>
                <div class="col-mp mp-5">
                    <?= /** @noEscape */ $block->getChildHtml('additional') ?>
                </div>
                <div class="col-mp mp-7">
                    <?= /** @noEscape */ $block->getChildHtml('order_detail') ?>
                    <div class="col-mp">
                        <?= /** @noEscape */ $block->getChildHtml('mp_registration') ?>
                        <?= /** @noEscape */ $block->getChildHtml('mp_subscribe') ?>
                    </div>
                    <div class="col-mp">
                        <?= /** @noEscape */ $block->getChildHtml('static_block_1') ?>
                    </div>
                </div>
                <div class="col-mp mp-5">
                    <?= /** @noEscape */ $block->getChildHtml('static_block_2') ?>
                </div>
            <?php else: ?>
                <div class="col-mp mp-7">
                    <?= /** @noEscape */ $block->getChildHtml($block->getStyle()) ?>
                </div>
                <div class="col-mp mp-5">
                    <?= /** @noEscape */ $block->getChildHtml('additional') ?>
                </div>
                <div class="col-mp mp-12">
                    <?= /** @noEscape */ $block->getChildHtml('order_detail') ?>
                </div>
                <div class="col-mp mp-12">
                    <?= /** @noEscape */ $block->getChildHtml('mp_registration') ?>
                    <?= /** @noEscape */ $block->getChildHtml('mp_subscribe') ?>
                </div>
                <div class="col-mp">
                    <?= /** @noEscape */ $block->getChildHtml('static_block_1') ?>
                </div>
            <?php endif; ?>
        <?php else: echo $block->getCustomHtml(); ?>
        <?php endif; ?>
    </div>
<?php endif; ?>
