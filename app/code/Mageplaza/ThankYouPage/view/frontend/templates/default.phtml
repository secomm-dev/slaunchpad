<?php /** @var \Mageplaza\ThankYouPage\Helper\Data $helper */
$helper = $this->helper(\Mageplaza\ThankYouPage\Helper\Data::class);
if (!$helper->isOrderSuccessPageEnable() || $helper->getTemplateData('order') === null):?>
    <?php /** @var $block \Magento\Checkout\Block\Onepage\Success */ ?>
<div class="page-title-wrapper">
    <h1 class="page-title">
        <span class="base" data-ui-id="page-title-wrapper">Thank you for your purchase!</span>
    </h1>
</div>
<div class="checkout-success">
    <?php if ($block->getOrderId()):?>
        <?php if ($block->getCanViewOrder()):?>
            <p><?= /** @noEscape */ __('Your order number is: %1.', sprintf('<a href="%s" class="order-number"><strong>%s</strong></a>', $block->escapeHtml($block->getViewOrderUrl()), $block->escapeHtml($block->getOrderId()))) ?></p>
        <?php  else:?>
            <p><?= /** @noEscape */ __('Your order # is: <span>%1</span>.', $block->escapeHtml($block->getOrderId())) ?></p>
        <?php endif;?>
        <p><?= /** @noEscape */ __('We\'ll email you an order confirmation with details and tracking info.') ?></p>
    <?php endif;?>

    <?= $block->getAdditionalInfoHtml() ?>

    <div class="actions-toolbar">
        <div class="primary">
            <a class="action primary continue" href="<?= /** @noEscape */ $block->getContinueUrl() ?>"><span><?= /** @noEscape */ __('Continue Shopping') ?></span></a>
        </div>
    </div>
</div>
<?php endif; ?>
