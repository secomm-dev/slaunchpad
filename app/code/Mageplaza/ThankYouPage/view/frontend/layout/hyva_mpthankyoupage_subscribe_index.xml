<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="Mageplaza_Core::css/owl.carousel.css"/>
        <remove src="Mageplaza_Core::css/owl.theme.css"/>
        <remove src="Mageplaza_Core::css/font-awesome.min.css"/>
        <remove src="Mageplaza_Core::css/colors.css"/>
        <remove src="https://use.fontawesome.com/releases/v5.2.0/css/all.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.subscribe.success" template="Mageplaza_ThankYouPage::subscribe/success.phtml" cacheable="false">
                <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.subscribe.success.style1" as="style1" template="Mageplaza_ThankYouPage::hyva/subscribe/demo/style1.phtml" cacheable="false"/>
                <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.subscribe.success.style2" as="style2" template="Mageplaza_ThankYouPage::hyva/subscribe/demo/style2.phtml" cacheable="false"/>
                <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.subscribe.success.style3" as="style3" template="Mageplaza_ThankYouPage::hyva/subscribe/demo/style3.phtml" cacheable="false"/>
            </block>
            <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.subscribe.staticblock" as="subscribe_static_block" template="Mageplaza_ThankYouPage::subscribe/block2.phtml" cacheable="false"/>
            <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.subscribe.productslider" as="subscribe_product_slider" template="Mageplaza_ThankYouPage::subscribe/slider.phtml" cacheable="false"/>
            <block class="Mageplaza\ThankYouPage\Block\Faq" name="mpthankyoupage.newsletter.faq.list" as="newsletter_faq_list" template="Mageplaza_ThankYouPage::hyva/faq/list.phtml" ifconfig="faqs/general/enabled">
                <arguments>
                    <argument name="type" xsi:type="string">newsletter</argument>
                </arguments>
            </block>
            <block class="Mageplaza\Faqs\Block\Design" name="mpthankyoupage.newsletter.mpfaqs.design" template="Mageplaza_Faqs::design.phtml" ifconfig="faqs/general/enabled" cacheable="false"/>
            <block class="Mageplaza\ThankYouPage\Block\Subscribe" name="mpthankyoupage.newsletter.design" template="Mageplaza_ThankYouPage::hyva/subscribe/design.phtml" cacheable="false"/>
        </referenceContainer>
    </body>
</page>
