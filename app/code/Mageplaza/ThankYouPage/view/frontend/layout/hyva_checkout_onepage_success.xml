<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="Mageplaza_Core::css/owl.carousel.css"/>
        <remove src="Mageplaza_Core::css/owl.theme.css"/>
        <remove src="Mageplaza_Core::css/grid-mageplaza.css"/>
        <remove src="Mageplaza_Core::css/colors.css"/>
        <remove src="https://use.fontawesome.com/releases/v5.2.0/css/all.css"/>
        <title>Order Success Page</title>
    </head>
    <update handle="hyva_mp_add_js_css"/>
    <update handle="hyva_form_validation"/>
    <body>
        <referenceBlock name="checkout.registration" remove="true"/>
        <referenceBlock name="mp_add_js_css">
            <action method="setFiles">
                <argument name="files" xsi:type="array">
                    <item name="mpthankyoupage_grid" xsi:type="string">Mageplaza_Core::css/grid-mageplaza.css</item>
                </argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.success" template="Mageplaza_ThankYouPage::hyva/order/success.phtml" cacheable="false">
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.success.simple" as="simple" template="Mageplaza_ThankYouPage::order/simple.phtml"/>
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.success.complex" as="complex" template="Mageplaza_ThankYouPage::order/complex.phtml"/>
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.additional" as="additional" template="Mageplaza_ThankYouPage::order/additional.phtml"/>
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.detail" as="order_detail" template="Mageplaza_ThankYouPage::order/detail.phtml"/>
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.static_block1" as="static_block_1" template="Mageplaza_ThankYouPage::order/block1.phtml"/>
                <block class="Mageplaza\ThankYouPage\Block\ProcessAccount" name="mpthankyoupage.order.registration." as="mp_registration" template="Mageplaza_ThankYouPage::hyva/order/form.phtml" cacheable="false"/>
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.subscribe" as="mp_subscribe" template="Mageplaza_ThankYouPage::hyva/order/subscribe.phtml"/>
                <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.order.static_block2" as="static_block_2" template="Mageplaza_ThankYouPage::order/block2.phtml"/>
            </block>
            <block class="Mageplaza\ThankYouPage\Block\Product\CrossSell" name="mpthankyoupage.order.crosssell" as="mp_crossell_product" template="Mageplaza_ThankYouPage::hyva/product/items.phtml"/>
            <block class="Mageplaza\ThankYouPage\Block\Faq" name="mpthankyoupage.faq.list" as="faq_list" template="Mageplaza_ThankYouPage::hyva/faq/list.phtml" ifconfig="faqs/general/enabled">
                <arguments>
                    <argument name="type" xsi:type="string">order</argument>
                </arguments>
            </block>
            <block class="Mageplaza\ThankYouPage\Block\OrderSuccess" name="mpthankyoupage.design" template="Mageplaza_ThankYouPage::hyva/design.phtml"/>
            <block class="Mageplaza\Faqs\Block\Design" name="mpthankyoupage.mpfaqs.design" template="Mageplaza_Faqs::design.phtml" ifconfig="faqs/general/enabled"/>
        </referenceContainer>
        <referenceBlock name="page.main.title" display="false"/>
        <referenceBlock name="checkout.success" template="Mageplaza_ThankYouPage::default.phtml"/>
    </body>
</page>
