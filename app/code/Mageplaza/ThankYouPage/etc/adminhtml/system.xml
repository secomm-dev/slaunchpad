<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mpthankyoupage" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Thank You Page</label>
            <tab>mageplaza</tab>
            <resource>Mageplaza_ThankYouPage::configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Configuration</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Select Yes to enable this module.</comment>
                </field>
                <field id="sharethis_id" translate="label comment" type='obscure' sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sharethis Property ID</label>
                    <comment><![CDATA[Used for adding social share buttons. Visit <a href="https://sharethis.com/" target="_bank">Sharethis.com</a> to create an account then get the property ID.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="order_success_page" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Order Success Page</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="newsletter_success_page" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Newsletter Success Page</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="route" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Route</label>
                    <comment>Leave empty to use default URL route. Default: subscribe</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <validate>validate-alphanum</validate>
                </field>
            </group>
        </section>
    </system>
</config>
