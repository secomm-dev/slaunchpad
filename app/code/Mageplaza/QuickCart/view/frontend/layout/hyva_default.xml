<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="Mageplaza_QuickCart::css/minicart.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block class="Mageplaza\QuickCart\Block\Cart\Design" name="mpquickcart.design"
                   template="Mageplaza_QuickCart::hyva/cart/design.phtml" ifconfig="mpquickcart/general/enabled"/>
        </referenceBlock>
        <referenceBlock name="header-content">
            <block class="Mageplaza\QuickCart\Block\Cart\CartDrawer" name="cart-drawer">
                <block name="cart-drawer-loading" as="loading" template="Hyva_Theme::ui/loading.phtml"/>
                <container name="extra_actions"/>
                <container name="cart-drawer.top"/>
                <container name="cart-drawer.items.before"/>
                <container name="cart-drawer.mpquickcart.coupon">
                    <block class="Magento\Framework\View\Element\Template" name="mpquickcart.coupon" ifconfig="mpquickcart/general/enabled"
                           template="Mageplaza_QuickCart::hyva/cart/coupon.phtml"/>
                </container>
                <container name="cart-drawer.mpquickcart.totals">
                    <block name="mpquickcart.totals" ifconfig="mpquickcart/general/enabled" template="Mageplaza_QuickCart::hyva/cart/totals.phtml"/>
                </container>
                <container name="cart-drawer.totals.before"/>
                <container name="cart-drawer.bottom"/>
            </block>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block template="Mageplaza_QuickCart::hyva/cart/ajaxcart.phtml" ifconfig="mpquickcart/general/enabled">
                <block name="loading" template="Hyva_Theme::ui/loading.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
