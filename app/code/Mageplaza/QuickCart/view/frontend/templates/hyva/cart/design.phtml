/** @var \Magento\Framework\Escaper $escaper */
/** @var \Mageplaza\QuickCart\Block\Cart\Design $block */

/** @var \Mageplaza\QuickCart\Helper\Data $helper */
$helper = $block->getHelper();

$isEnable = $helper->getConfigGeneral('enabled', $block->getStoreId());
?>
<?php if ($isEnable): ?>
    <style>
    .mpquickcart-totals {
        background-color: <?= /* @noEscape */ $helper->getSubtotalBackground() ?>;
        color: <?= /* @noEscape */ $helper->getSubtotalText() ?>;
    }
    #cart-drawer header {
        color: <?= /* @noEscape */ $helper->getHeaderText() ?>;
        background-color: <?= /* @noEscape */ $helper->getHeaderBackground() ?>;
    }
    #cart-drawer .cart-item:not(:last-child) {
        border-bottom-width: 1px;
        border-color: #e7e7e7;
    }
    #cart-drawer btn.btn-secondary:focus {
        outline: none;
    }
    <?= /* @noEscape */ $helper->getCustomCss() ?>
    </style>
    <?php if ($helper->isFixedIcon()): ?>
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
                const miniCartIcon = document.getElementById('menu-cart-icon');
                if (miniCartIcon) {
                    let stickyTop = miniCartIcon.offsetTop;

                    window.onscroll = function () {
                        if (window.pageYOffset > stickyTop) {
                            miniCartIcon.classList.remove('relative');
                            miniCartIcon.style.cssText = 'position: fixed; right: 20px; top: 20px;';
                        } else {
                            miniCartIcon.style.cssText = '';
                            miniCartIcon.classList.add('relative');
                        }
                    };
                }
            });
        </script>
    <?php endif; ?>
    <?php if ($helper->isHover()): ?>
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', () => {
                const miniCartIcon = document.getElementById('menu-cart-icon');
                if (!miniCartIcon) return;

                miniCartIcon.addEventListener('mouseover', () => {
                    window.dispatchEvent(new Event('toggle-cart'));
                });
            });
        </script>
    <?php endif; ?>
<?php endif; ?>
