<script type="text/javascript">
    require(['jquery'], function ($) {
        var modalEl      = $('#smtp-block-autofill'),
            hostEl       = $('#smtp_configuration_option_host'),
            portEl       = $('#smtp_configuration_option_port'),
            protocolEl   = $('#smtp_configuration_option_protocol'),
            authEl       = $('#smtp_configuration_option_authentication'),
            authName     = authEl.attr('name'),
            authHiddenId = authEl.attr('id') + '_force',
            oauthFields  = [
                '#row_smtp_configuration_option_oauth_tenant_id',
                '#row_smtp_configuration_option_oauth_client_id',
                '#row_smtp_configuration_option_oauth_client_secret',
                '#row_smtp_configuration_option_oauth_help'
            ],
            basicFields  = [
                '#row_smtp_configuration_option_username',
                '#row_smtp_configuration_option_password'
            ];

        function setHiddenAuth (force) {
            var hidden = $('#' + authHiddenId);
            if (force) {
                if (!hidden.length) {
                    hidden = $('<input/>', {type: 'hidden', id: authHiddenId, name: authName});
                    authEl.after(hidden);
                }
                hidden.val('oauth2');
            } else {
                hidden.remove();
            }
        }

        function toggleOauth (forceOauth) {
            if (forceOauth) {
                authEl.val('oauth2').prop('disabled', true).trigger('change');
                setHiddenAuth(true);
                // Force show OAuth fields and enable all inputs (override depends logic)
                oauthFields.forEach(function (id) {
                    var $row = $(id);
                    $row.removeAttr('style').css('display', 'table-row').show();
                    // Find all inputs/selects/textareas and force enable them
                    $row.find('input, select, textarea').each(function () {
                        $(this).removeAttr('style').removeAttr('disabled').show();
                    });
                });
                // Hide basic auth fields
                basicFields.forEach(function (id) {
                    $(id).hide();
                });
            } else {
                authEl.prop('disabled', false).trigger('change');
                setHiddenAuth(false);
                // Hide OAuth fields when not Office365
                oauthFields.forEach(function (id) {
                    $(id).hide();
                });
                // Show basic auth fields
                basicFields.forEach(function (id) {
                    $(id).show();
                });
            }
        }

        function isOffice365Host (host) {
            return (host || '').toLowerCase().trim() === 'smtp.office365.com';
        }

        function disableOAuth2Option (disable) {
            var oauth2Option = authEl.find('option[value="oauth2"]');
            if (oauth2Option.length) {
                if (disable) {
                    oauth2Option.prop('disabled', true);
                    if (authEl.val() === 'oauth2') {
                        authEl.val('smtp').trigger('change');
                    }
                } else {
                    oauth2Option.prop('disabled', false);
                }
            }
        }

        function syncState () {
            var isOffice365 = isOffice365Host(hostEl.val());
            toggleOauth(isOffice365);
            disableOAuth2Option(!isOffice365);
        }

        hostEl.on('change keyup', syncState);

        $('.button-actions-apply-autofill').on('click', function () {
            var hostVal     = $(this).data('host'),
                portVal     = $(this).data('port'),
                protocolVal = $(this).data('protocol');
            hostEl.val(hostVal);
            portEl.val(portVal);
            protocolEl.val(protocolVal);
            syncState();
            modalEl.modal('closeModal');
        });

        // Initial hide of OAuth fields on page load, syncState will show if needed
        oauthFields.forEach(function (id) {
            $(id).hide();
        });

        syncState();
    });
</script>
