<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="checkout.price-summary.section">
            <block class="Mageplaza\ExtraFee\Block\Cart\ExtraFee" name="mp.checkout.order.summary.extra.fee"
                   template="Mageplaza_ExtraFee::hyva/checkout/order-summary/extra-fee.phtml"
                   ifconfig="mp_extra_fee/general/enabled" after="checkout.quote-summary.title">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Mageplaza\ExtraFee\Magewire\Checkout\OrderSummary\ExtraFee
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="checkout.shipping.section">
            <block class="Mageplaza\ExtraFee\Block\Cart\ExtraFee" name="mp.checkout.shipping.extra.fee"
                   template="Mageplaza_ExtraFee::hyva/checkout/shipping/shipping-extra-fee.phtml"
                   ifconfig="mp_extra_fee/general/enabled" after="checkout.shipping.methods">
                <arguments>
                    <argument name="magewire" xsi:type="object">Mageplaza\ExtraFee\Magewire\Checkout\Shipping\ExtraFee
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="checkout.payment.section">
            <block class="Mageplaza\ExtraFee\Block\Cart\ExtraFee" name="mp.checkout.payment.extra.fee"
                   template="Mageplaza_ExtraFee::hyva/checkout/payment/payment-extra-fee.phtml"
                   ifconfig="mp_extra_fee/general/enabled" after="checkout.payment.methods">
                <arguments>
                    <argument name="magewire" xsi:type="object">Mageplaza\ExtraFee\Magewire\Checkout\Payment\ExtraFee
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="price-summary.total-segments">
            <action method="setTemplate" ifconfig="mp_extra_fee/general/enabled">
                <argument name="template" xsi:type="string">
                    Mageplaza_ExtraFee::hyva/checkout/price-summary/total-segments.phtml
                </argument>
            </action>
        </referenceBlock>
    </body>
</page>
