<div>
    <div x-data="initExtraFeeShipping($wire)">
        <template x-if="checkRender()">
            <div class=" flex flex-col pb-2 my-2 border-b-2 border-gray-300 ">
                <div class="card block shipping" >
                    <div id="block-extrafee-summary"  style="position: relative">
                        <form id="mp-extra-fee-shipping" style="margin-bottom: 20px">
                            <fieldset class="fieldset rate">
                                <template x-for="rule in getRuleConfig()">
                                    <dl class="fieldset items methods" >
                                        <dt class="item-title field">
                                            <div><label class="label font-semibold"><span x-html="getTitle(rule)"></span></label></div>
                                            <div class="mp-description my-2">
                                                <label class="label" style="font-weight: 400">
                                                    <span x-html="getDescription(rule)"></span>
                                                </label>
                                            </div>
                                        </dt>
                                        <template x-if="rule.display_type !== '3'">
                                            <div x-init="$nextTick(() => {afterRenderOptions($el)});" class="rule-parent" :class="rule.is_required == '1' ? 'mp-extra-fee-required' : ''">
                                                <template x-for="option in getOptions(rule)" >
                                                    <div class="rule">
                                                        <template x-if="rule.display_type === '1'">
                                                            <div>
                                                                <input type="radio"
                                                                       class="form-radio"
                                                                       :name="'rule[' + option.rule_id + ']'"
                                                                       :value="option.value"
                                                                       :id="'s_rule_' + option.rule_id + '_' + option.value"
                                                                       :ruleId="option.rule_id"
                                                                       x-on:click="selectOption($el)"
                                                                >
                                                                <label class="label inline-block"
                                                                       x-html="option.title"
                                                                       :for="'s_rule_' + option.rule_id + '_' + option.value"
                                                                >
                                                                </label>
                                                            </div>
                                                        </template>
                                                        <template x-if="rule.display_type === '2'">
                                                            <div>
                                                                <input type="checkbox"
                                                                       class="checkbox"
                                                                       :name="'rule[' + option.rule_id + '][' + option.value + ']'"
                                                                       :value="option.value"
                                                                       :id="'s_rule_' + option.rule_id + '_' + option.value"
                                                                       :ruleId="option.rule_id"
                                                                       :required="rule.is_required ? 'required' : false"
                                                                       @click="selectOption($el)"
                                                                >
                                                                <label class="label inline-block"
                                                                       :for="'s_rule_' + option.rule_id + '_' + option.value"
                                                                       x-html="option.title">
                                                                </label>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>
                                        <template x-if="rule.display_type === '3'">
                                            <div>
                                                <select class="form-select select item-options type-3"
                                                        :id="'select_rule_' + rule.rule_id"
                                                        :ruleId="rule.rule_id"
                                                        :name="'rule[' + rule.rule_id + ']'"
                                                        @change="changeOption($el)"
                                                        wire:ignore
                                                >
                                                    <template x-for="option in getOptions(rule)">
                                                        <option :value="option.value"  x-html="option.title" x-init="$nextTick(() => {afterRenderOptions($el,option)});">
                                                        </option>
                                                    </template>
                                                </select>
                                            </div>
                                        </template>
                                        <template x-if="isAllowNote(rule)">
                                            <div class="mt-3">
                                                <label x-html="getNoteTitle(rule)" :for="'mp-extrafee-note-' + rule.rule_id"></label>
                                                <textarea
                                                        x-init="$nextTick(() => {getNoteMessage('mp-extrafee-note-' + rule.rule_id)});"
                                                        cols="30"
                                                        rows="2"
                                                        :id="'mp-extrafee-note-' + rule.rule_id"
                                                        :name="'mp-extrafee-note-' + rule.rule_id"
                                                        x-on:keyup.debounce.700ms="changeOption($el)"
                                                        class="input input-light w-full"
                                                ></textarea>
                                            </div>
                                        </template>
                                        <template x-if="rule.display_type !== '3'">
                                            <form id="shipping"
                                                  x-data="initAddressForm($el, $wire)"
                                                  x-init="initialize()" wire:ignore>
                                                <input :required="rule.is_required == '1' ? 'required' : false" type="text"
                                                       name="mp_extra_fee" class="mp_extra_fee invisible absolute">
                                            </form>
                                        </template>
                                    </dl>
                                </template>
                            </fieldset>
                        </form>
                    </div>
                </div>
            </div>
        </template>
    </div>
</div>