/** @var \Mageplaza\RMA\Block\Request $block */
?>
<form class="form form-orders-search" id="mprma-widget-orders-and-returns-form"
      x-data="{...hyva.formValidation($el), ...initForm()}"
      @submit.prevent="myFormSubmit"
      action="<?= /* @noEscape */ $block->getUrl('mprma/request/index') ?><?= /* @noEscape */ $block->getFormKey() ?>"
      method="post" name="guest_post">
    <fieldset class="fieldset">
        <legend class="admin__legend">
            <span><?= $block->escapeHtml(__('Order Information')) ?></span>
        </legend>
        <br>
        <input data-bind='attr: {value: getFormKey()}' type="hidden" name="form_key"/>
        <div class="field id required">
            <label class="label" for="mprma-order-id">
                <span><?= $block->escapeHtml(__('Order ID')) ?></span>
            </label>
            <div class="control">
                <input type="text"
                       class="input-text w-50"
                       id="mprma-order-id"
                       name="mprma_order_id"
                       data-validate='{"required": true}'/>
            </div>
        </div>
        <div class="field lastname required">
            <label class="label" for="mprma-billing-lastname">
                <span><?= $block->escapeHtml(__('Billing Last Name')) ?></span>
            </label>
            <div class="control">
                <input type="text"
                       class="input-text w-50"
                       id="mprma-billing-lastname"
                       name="mprma_billing_lastname"
                       data-validate='{"required": true}'
                       <?php if($block->checkLogin()): ?> value="<?= /** noEscape */ $block->getLastName(); endif; ?>"/>
            </div>
        </div>
        <div class="field find required">
            <label class="label" for="quick-search-type-id">
                <span><?= $block->escapeHtml(__('Find Order By')) ?></span>
            </label>
            <div class="control">
                <select name="mprma_type" id="quick-search-type-id" class="select w-50">
                    <?php foreach ($block->getFindOrderTypes() as $type) :
                        /** @var array $type */ ?>
                        <option value="<?= $block->escapeHtml($type['value']) ?>">
                            <?= $block->escapeHtml($type['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div id="mprma-email" class="field email required">
            <label class="label" for="mprma_email">
                <span><?= $block->escapeHtml(__('Email')) ?></span>
            </label>
            <div class="control">
                <input type="email"
                       class="input-text w-50"
                       id="mprma_email"
                       name="mprma_email"
                       data-validate='{ "required": true, "email": true }'
                       <?php if($block->checkLogin()): ?> value="<?= /** noEscape */ $block->getEmail();endif; ?>"/>
            </div>
        </div>
        <div id="mprma-zip" class="field zip required">
            <label class="label" for="mprma_zip">
                <span><?= $block->escapeHtml(__('Billing ZIP Code')) ?></span>
            </label>
            <div class="control">
                <input type="text" class="input-text w-50" id="mprma_zip" name="mprma_zip" data-validate='{"required": true}'/>
            </div>
        </div>
    </fieldset>
    <div class="actions-toolbar">
        <div class="primary">
            <button type="submit"
                    title="<?= $block->escapeHtml(__('Continue')) ?>"
                    class="action submit primary">
                <span><?= $block->escapeHtml(__('Continue')) ?></span>
            </button>
        </div>
    </div>
</form>
<style>
    .w-50 {
        width: 50% !important;
    }
</style>
