    <script>
        function initDataOrder(element) {
            return {
                options: {
                    fileMessage: element.querySelector('form#mp-edit-rma-form .mp-rma-message.files-message'),
                    fileLoader: element.querySelector('form#mp-edit-rma-form .mp-image .loader'),
                    fileWrapper: element.querySelector('form#mp-edit-rma-form .request-image-wrapper i'),
                    itemContainer: element.querySelector('form#mp-edit-rma-form .mp-rma-information-container'),
                    itemLoader: element.querySelector('form#mp-edit-rma-form .mp-rma-image-loader.order-loader'),
                    orderIdVal: element.querySelector('form#mp-edit-rma-form .mp-field-order-id select[name="order[order_id]"]').value,
                    requestOrderID: element.querySelector('form#mp-edit-rma-form input[name="request[order_id]"]'),
                    requestCuzEmail: element.querySelector('form#mp-edit-rma-form input[name="request[customer_email]"]'),
                    requestStoreId: element.querySelector('form#mp-edit-rma-form input[name="request[store_id]"]'),
                    requestOrderIncrementID: element.querySelector('form#mp-edit-rma-form input[name="request[order_increment_id]"]'),
                    orderLastName: element.querySelector('form#mp-edit-rma-form input[name="order[bill_lastname]"]'),
                    orderEmail: element.querySelector('form#mp-edit-rma-form input[name="order[email]"]'),
                    uploadUrl: '<?= /* @noEscape */ $block->getUploadUrl() ?>',
                    loadOrderInfoUrl: '<?= /* @noEscape */ $block->getLoadOrderInformationUrl() ?>'
                },
                init: function () {
                    this._bind();
                    this._initOrderInformation();
                },
                myFormSubmit(event) {
                    event.preventDefault();

                    hyva.formValidation.addRule('no-only-whitespace', function(value, options, field, context) {
                        if (value !== "" && value.trim().length === 0) {
                            return 'This field cannot be only whitespace';
                        }
                        return true;
                    });

                    this.validate()
                        .then(() => {
                            let recaptchaResponse = true;
                            if (document.querySelectorAll('.g-recaptcha').length > 0) {
                                recaptchaResponse = (typeof grecaptcha !== "undefined" && grecaptcha.getResponse)
                                    ? grecaptcha.getResponse()
                                    : true;
                            }

                            if (!recaptchaResponse) {
                                event.preventDefault();
                                event.stopPropagation();
                                event.stopImmediatePropagation();
                            } else {
                                event.target.submit();
                            }
                        })
                        .catch((invalid) => {
                            if (invalid.length > 0) {
                                invalid[0].focus();
                            }
                            event.preventDefault();
                            event.stopPropagation();
                            event.stopImmediatePropagation();
                        });
                },
                _bind: function () {
                    var uploadInput = element.querySelector('input[data-role=upload-files]');
                    var orderSelect = element.querySelector('select[data-role=load-order]');

                    if (uploadInput) {
                        uploadInput.addEventListener('change', function (event) {
                            this._uploadFile(event);
                        }.bind(this));
                    }

                    document.addEventListener('click', function(event) {
                        if (event.target.matches('i[data-role="delete-button"]')) {
                            this._remove(event);
                        }
                    });


                    orderSelect.addEventListener('change', function (event) {
                        this.options.orderIdVal = event.target.value;
                        this._initOrderInformation();
                    }.bind(this));
                },
                _uploadFile: function (event) {
                    var el = this,
                        formData = new FormData(),
                        files = event.target.files;

                    Array.from(files).forEach(function (file) {
                        var d = new Date(),
                            fileId = d.getTime() + '_' + d.getMilliseconds();

                        el.options.fileLoader.style.display = 'block';
                        el.options.fileWrapper.style.display = 'none';

                        if (formData) {
                            formData.delete('file');
                            formData.delete('position');
                            formData.delete('file_id');
                            formData.append('file', file);
                            const prevElement = document.querySelector('#mp-image-place-holder')?.previousElementSibling;
                            const positionInput = prevElement?.querySelector('input.position');

                            formData.append('position', positionInput ? positionInput.value : '');

                            formData.append('file_id', fileId);
                            fetch(el.options.uploadUrl, {
                                method: 'POST',
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: formData
                            })
                                .then(function (response) {
                                    return response.json();
                                })
                                .then(function (response) {
                                    el.options.fileLoader.style.display = 'none';
                                    el.options.fileWrapper.style.display = 'block';
                                    if (response.status) {
                                        var placeholder = document.querySelector('#mp-image-place-holder');
                                        placeholder.insertAdjacentHTML('beforebegin', response.request_files);
                                        hyva.activateScripts(placeholder);

                                        let removeSelection = placeholder.previousElementSibling.querySelectorAll(".actions i")

                                        removeSelection.forEach(function (element) {
                                            element.addEventListener('click', function () {
                                                let fileContainer = element.parentElement.parentElement.parentElement;
                                                if (fileContainer) {
                                                    fileContainer.remove();
                                                }
                                            });
                                        });
                                    } else {
                                        el.options.fileMessage.querySelector('.files-message-content div').textContent = response.errorSize;
                                        el.options.fileMessage.style.display = 'block';
                                    }
                                })
                                .catch(function () {
                                    console.log('Error')
                                });
                        }
                    });
                    event.target.value = '';
                },
                _initOrderInformation: function () {
                    var el = this;
                    el.options.itemLoader.style.display = 'block';
                    const formData = new FormData();
                    formData.set('order_id', el.options.orderIdVal);
                    fetch(this.options.loadOrderInfoUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(function (response) {
                            return response.json();
                        })
                        .then(function (response) {
                            var itemList = el.options.itemContainer.querySelector('div.control');

                            if (response.status) {
                                el.options.requestOrderID.value = el.options.orderIdVal;
                                el.options.requestCuzEmail.value = response.customer_email;
                                el.options.requestStoreId.value = response.store_id;
                                el.options.orderLastName.value = response.billing_lastname;
                                el.options.orderEmail.value = response.customer_email;
                                el.options.requestOrderIncrementID.value = response.order_increment_id;

                                itemList.innerHTML = response.request_products;
                                hyva.activateScripts(itemList);

                                var event = new Event('contentUpdated');
                                itemList.dispatchEvent(event);
                            } else {
                                itemList.innerHTML = response.error_message;
                            }
                        })
                        .catch(function (error) {
                            console.error('Error:', error);
                        })
                        .finally(function () {
                            el.options.itemLoader.style.display = 'none';
                        });
                }
            }
        }
    </script>

