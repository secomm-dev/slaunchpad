/** @var \Mageplaza\RMA\Block\Request\ShippingLabel $block */
/** @var \Mageplaza\RMA\Model\Request $_request */
$_request = $block->getRmaRequest();
/** @var \Mageplaza\RMA\Model\ShippingLabel $_shippingLabel */
$_shippingLabel = $_request->getShippingLabel();
/** @var array $shippingLabelInformation */
$shippingLabelInformation = $block->getShippingLabelInformation($_shippingLabel);
/** @var \Magento\Sales\Model\Order $_order */
$_order = $_request->getOrder();
?>
<div id="mp-shipping-label-container">
    <div class="mp-header">
        <?php if ($_shippingLabel->getImage() && in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::LOGO, $shippingLabelInformation, true)): ?>
            <img src="<?= /* @noEscape */ $block->getShippingLabelImageUrl($_shippingLabel->getImage()) ?>"
                 alt="<?= /* @noEscape */ $_shippingLabel->getName() ?>">
        <?php endif; ?>
        <h1><?= $block->escapeHtml($_shippingLabel->getStoreLabel()) ?></h1>
    </div>
    <div class="mp-body">
        <div class="block mp-ship-from-information">
            <div class="block-title">
                <strong><?= /* @noEscape */ __('From') ?></strong>
            </div>
            <div class="block-content">
                <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::ORDER_SHIPPING_ADDRESS, $shippingLabelInformation, true)): ?>
                    <div class="shipping-from-address">
                        <span><?= /* @noEscape */ $block->renderBillingAddress($_order) ?></span>
                    </div>
                <?php endif; ?>
                <div class="request-date-info">
                    <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::ORDER_INCREMENT_ID, $shippingLabelInformation, true)): ?>
                        <span><?= /* @noEscape */ __('Order ID: ') . $_order->getIncrementId() ?></span>
                    <?php endif; ?><br>
                    <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::RMA_INCREMENT_ID, $shippingLabelInformation, true)): ?>
                        <span><?= /* @noEscape */ __('RMA ID: ') . $_request->getIncrementId() ?></span>
                    <?php endif; ?><br>
                    <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::PRINT_DATE, $shippingLabelInformation, true)): ?>
                        <span><?= /* @noEscape */ __('Print Date: ') . $block->helperData->getConvertedDate($block->helperData->getCurrentDate())->format('F j, Y') ?></span>
                    <?php endif; ?><br>
                    <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::REQUEST_DATE, $shippingLabelInformation, true)): ?>
                        <span><?= /* @noEscape */ __('Request Date: ') . $block->helperData->getConvertedDate($_request->getCreatedAt())->format('F j, Y') ?></span>
                    <?php endif; ?><br>
                </div>
            </div>
        </div>
        <div class="block mp-rma-information">
            <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::RMA_INFORMATION, $shippingLabelInformation, true)): ?>
                <div class="block-title">
                    <strong><?= /* @noEscape */ __('RMA Information') ?></strong>
                </div>
                <div class="block-content"><?= /* @noEscape */ $block->renderRequestItems($_request) ?></div>
            <?php endif; ?>
        </div>
        <div class="block ship-to-information">
            <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::RETURN_SHIPPING_ADDRESS, $shippingLabelInformation, true)): ?>
                <div class="block-title">
                    <strong><?= /* @noEscape */ __('Ship To') ?></strong>
                </div>
                <div class="block-content">
                    <div class="shipping-to-address">
                        <span><?= /* @noEscape */ $_shippingLabel->getReturnAddress() ?></span>
                    </div>
                </div>
            <?php endif; ?>
        </div>
        <div class="barcode-information">
            <?php if (in_array(\Mageplaza\RMA\Model\Config\Source\RMAShippingLabel\Information::BARCODE, $shippingLabelInformation, true)): ?>
                <?= /* @noEscape */ $block->generateBarcode($_request) ?>
            <?php endif; ?>
        </div>
    </div>
    <div class="mp-footer"></div>
</div>
