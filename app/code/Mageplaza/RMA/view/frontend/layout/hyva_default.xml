<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyva_modal"/>
    <body>
        <referenceBlock name="header.customer.logged.in.links">
            <block name="mprma_header_link" ifconfig="mprma/general/enabled"
                   class="Mageplaza\RMA\Block\Link\Request\Top">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">RMA Request</argument>
                    <argument name="path" xsi:type="string">mprma/request/form</argument>
                    <argument name="sort_order" xsi:type="number">70</argument>
                </arguments>
            </block>
            <block name="mprma_policy_top_link_logged_in" ifconfig="mprma/general/enabled"
                   class="Mageplaza\RMA\Block\Link\Policy\Top">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">RMA Terms And Conditions</argument>
                    <argument name="sort_order" xsi:type="number">80</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="footer-static-links">
            <action method="setTemplate" ifconfig="mprma/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_RMA::hyva/html/footer/links.phtml</argument>
            </action>
            <block class="Mageplaza\RMA\Block\Link\Request\Footer" name="mprma_footer_link" ifconfig="mprma/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">RMA Request</argument>
                    <argument name="path" xsi:type="string">mprma/request/form</argument>
                </arguments>
            </block>
            <block class="Mageplaza\RMA\Block\Link\Policy\Footer" name="mprma_policy_footer_link" ifconfig="mprma/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">RMA Terms And Conditions</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
