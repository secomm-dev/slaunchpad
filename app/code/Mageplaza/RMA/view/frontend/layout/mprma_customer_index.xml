<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <css src="Mageplaza_RMA::css/style.css"/>
    </head>
    <body>
        <referenceContainer name="page.main.title">
            <block class="Mageplaza\RMA\Block\Customer\Button" name="mp_rma_request_button" template="Mageplaza_RMA::customer/request/button.phtml"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Mageplaza\RMA\Block\Customer\Request" name="mp_rma_request" template="Mageplaza_RMA::customer/request.phtml" after="-" cacheable="false"/>
        </referenceContainer>
    </body>
</page>
