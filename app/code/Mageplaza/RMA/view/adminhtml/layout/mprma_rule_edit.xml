<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="editor"/>
    <head>
        <css src="Mageplaza_RMA::css/style.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\RMA\Block\Adminhtml\Rule\Edit" name="mageplaza_rma_rule_edit"/>
        </referenceContainer>
        <referenceContainer name="left">
            <block class="Mageplaza\RMA\Block\Adminhtml\Rule\Edit\Tabs" name="mageplaza_rma_rule_tabs">
                <block class="Mageplaza\RMA\Block\Adminhtml\Rule\Edit\Tab\General" name="mageplaza_rma_rule_edit_tab_general"/>
                <block class="Mageplaza\RMA\Block\Adminhtml\Rule\Edit\Tab\Condition" name="mageplaza_rma_rule_edit_tab_condition"/>
                <block class="Mageplaza\RMA\Block\Adminhtml\Rule\Edit\Tab\RMA" name="mageplaza_rma_rule_edit_tab_rma"/>
                <action method="addTab">
                    <argument name="name" xsi:type="string">general</argument>
                    <argument name="block" xsi:type="string">mageplaza_rma_rule_edit_tab_general</argument>
                </action>
                <action method="addTab">
                    <argument name="name" xsi:type="string">condition</argument>
                    <argument name="block" xsi:type="string">mageplaza_rma_rule_edit_tab_condition</argument>
                </action>
                <action method="addTab">
                    <argument name="name" xsi:type="string">rma</argument>
                    <argument name="block" xsi:type="string">mageplaza_rma_rule_edit_tab_rma</argument>
                </action>
            </block>
        </referenceContainer>
    </body>
</page>
