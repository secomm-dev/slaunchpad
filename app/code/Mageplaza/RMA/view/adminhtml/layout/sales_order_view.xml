<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sales_order_tabs">
            <block class="Mageplaza\RMA\Block\Adminhtml\Order\View\Tab\Requests" name="mprma_order_request.grid.container"/>
            <action method="addTab">
                <argument name="name" xsi:type="string">request</argument>
                <argument name="block" xsi:type="string">mprma_order_request.grid.container</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="mprma_order_request.grid.container">
            <uiComponent name="mageplaza_rma_order_view_request_grid"/>
        </referenceBlock>
    </body>
</page>
