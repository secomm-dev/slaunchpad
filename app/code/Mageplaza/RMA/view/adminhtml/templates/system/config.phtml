<script type="text/javascript">
    require(['jquery'], function ($) {
        var policyPage    = $('#row_mprma_general_policy select#mprma_general_policy'),
            policyLinkCtn = $('#row_mprma_general_policy_location');
        isEnablePolicyLink();
        policyPage.on('change', function () {
            isEnablePolicyLink();
        });

        /** Is enable policy link container */
        function isEnablePolicyLink () {
            if (policyPage.val() === '0') {
                policyLinkCtn.hide();
            } else {
                policyLinkCtn.show();
            }
        }
    });
</script>
