<script type="text/javascript">
    require([
        'jquery',
        'mage/template'
    ], function ($, mageTemplate) {
        if ($('#mprma_request_rma_additional_field_inherit').prop('checked') === true) {
            $('#row_mprma_request_rma_additional_field input.input-text').prop('disabled', true);
        }

        mpRMAAdditional = {
            add: function (event) {
                var d       = new Date();
                var tBody   = $(event.target).parents('#mp-rma-additional-field')
                    .find('#mp_additional-field_row_container'),
                    rowHtml = mageTemplate(
                        '#mp_additional_field_row_template',
                        {
                            data: {
                                id: 'F_' + d.getTime() + '_' + d.getMilliseconds()
                            }
                        }
                    );
                tBody.append(rowHtml);
            },

            deleteRow: function (event) {
                $(event.target).closest('tr').remove();
            },

            expandItem: function (event) {
                var itemTable = $(event.target).parents('tr.mp_additional-field_row')
                .find('table.mp-rma-additional-field-item');
                if ($(event.target).hasClass('fa-angle-double-down')) {
                    itemTable.find('tr.field-item-row-body').show();
                    $(event.target).removeClass('fa-angle-double-down').addClass('fa-angle-double-up');
                } else if ($(event.target).hasClass('fa-angle-double-up')) {
                    itemTable.find('tr.field-item-row-body').hide();
                    $(event.target).removeClass('fa-angle-double-up').addClass('fa-angle-double-down');
                }
            }
        };
    });
</script>
