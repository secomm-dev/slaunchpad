<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Sales::sales">
                    <resource id="Mageplaza_RMA::rma" title="Mageplaza RMA" sortOrder="25">
                        <resource id="Mageplaza_RMA::request" title="Manage RMA Request" sortOrder="10">
                            <resource id="Mageplaza_RMA::request_delete" title="Manage RMA Request Delete" sortOrder="10"/>
                        </resource>
                        <resource id="Mageplaza_RMA::status" title="Manage Status" sortOrder="20"/>
                        <resource id="Mageplaza_RMA::rule" title="Manage Rule" sortOrder="30"/>
                        <resource id="Mageplaza_RMA::shipping_label" title="Manage Shipping Label" sortOrder="40"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mageplaza_RMA::configuration" title="Mageplaza RMA"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
