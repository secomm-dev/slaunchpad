<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="secomm_ui"
            class="Secomm\UiWidget\Block\Widget\SecommUi"
            is_email_compatible="false">
        <label translate="true">Secomm UI</label>
        <description translate="true">Render an approved Secomm UI component.</description>
        <parameters>
            <parameter name="component"
                       xsi:type="select"
                       source_model="Secomm\UiWidget\Model\Config\Source\Component"
                       visible="true"
                       required="true"
                       sort_order="10">
                <label translate="true">Component</label>
                <description translate="true">Select an approved component to configure.</description>
            </parameter>
            <parameter name="schema_version"
                       xsi:type="text"
                       visible="false"
                       required="false"
                       sort_order="20">
                <value>1</value>
            </parameter>
        </parameters>
    </widget>
</widgets>
