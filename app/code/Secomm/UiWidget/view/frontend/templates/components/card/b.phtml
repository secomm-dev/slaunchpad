 * @var \Secomm\UiWidget\Block\Widget\SecommUi $block
 * @var \Magento\Framework\Escaper $escaper
 */

$data = (array)$block->getData('component_data');
$instanceId = $block->getInstanceId();
$titleId = $instanceId . '-title';
$imagePosition = (string)($data['image_position'] ?? 'left');
$linkClasses = [
    'button' => 'btn inline-flex before:absolute before:inset-0',
    'primary' => 'btn btn-primary inline-flex before:absolute before:inset-0',
    'secondary' => 'btn btn-secondary inline-flex before:absolute before:inset-0',
];
?>
<article id="<?= $escaper->escapeHtmlAttr($instanceId) ?>"
         class="relative card card-interactive flex items-start gap-6 overflow-clip"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($titleId) ?>"
         data-secomm-ui-component="card_b">
    <img src="<?= $escaper->escapeUrl((string)$data['image']) ?>"
         alt="<?= $escaper->escapeHtmlAttr((string)$data['image_alt']) ?>"
         width="150"
         height="150"
         loading="<?= $escaper->escapeHtmlAttr((string)($data['loading'] ?? 'lazy')) ?>"
         class="max-w-1/2 sm:shrink-0<?= $imagePosition === 'right' ? ' order-2' : '' ?>">
    <div class="prose grow<?= $imagePosition === 'right' ? ' order-1' : '' ?>">
        <p id="<?= $escaper->escapeHtmlAttr($titleId) ?>" class="text-2xl">
            <strong><?= $escaper->escapeHtml((string)$data['title']) ?></strong>
        </p>
        <?php if (!empty($data['content'])): ?>
            <?= /* @noEscape trusted-rich-text filtered by Magento CMS */
            $block->renderTrustedHtml((string)$data['content']) ?>
        <?php endif; ?>
        <?php if (!empty($data['cta_url'])): ?>
            <p class="mt-8 mb-0">
                <a href="<?= $escaper->escapeUrl((string)$data['cta_url']) ?>"
                   class="<?= $escaper->escapeHtmlAttr($linkClasses[$data['link_appearance'] ?? 'button']) ?>"
                    <?php if (!empty($data['open_in_new'])): ?>target="_blank" rel="noopener noreferrer"<?php endif; ?>>
                    <?= $escaper->escapeHtml((string)$data['cta_label']) ?>
                </a>
            </p>
        <?php endif; ?>
    </div>
</article>
