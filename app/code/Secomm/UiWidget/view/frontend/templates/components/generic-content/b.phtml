$data = (array)$block->getData('component_data');
$instanceId = $block->getInstanceId();
$headingId = $instanceId . '-heading';
$imageRight = ($data['image_position'] ?? 'left') === 'right';
$linkClasses = [
    'button' => 'btn inline-flex',
    'primary' => 'btn btn-primary inline-flex',
    'secondary' => 'btn btn-secondary inline-flex',
];
?>
<article id="<?= $escaper->escapeHtmlAttr($instanceId) ?>"
         class="lg:grid lg:grid-cols-2 lg:gap-x-2 bg-zinc-100"
         data-secomm-ui-component="generic_content_b">
    <div class="grid<?= $imageRight ? ' lg:order-2' : '' ?>">
        <img src="<?= $escaper->escapeUrl($block->getMediaUrl((string)$data['image'])) ?>"
             alt="<?= $escaper->escapeHtmlAttr((string)$data['image_alt']) ?>"
             class="col-start-1 row-start-1 lg:w-full lg:h-full lg:object-cover"
             width="720"
             height="949"
             loading="<?= $escaper->escapeHtmlAttr((string)($data['loading'] ?? 'lazy')) ?>">
        <div class="lg:hidden col-start-1 row-start-1 self-end pt-16 pb-8 px-6
                    bg-gradient-to-t from-slate-800/75 text-white">
            <span class="inline-block mb-2 px-2 py-1 rounded bg-blue-800 text-blue-100
                         text-lg font-semibold uppercase">
                <?= $escaper->escapeHtml((string)$data['eyebrow']) ?>
            </span>
            <h2 class="text-4xl font-bold lg:text-5xl">
                <?= $escaper->escapeHtml((string)$data['heading']) ?>
            </h2>
        </div>
    </div>

    <div class="p-6 max-w-full prose prose-slate prose-p:text-slate-500 prose-lead:text-slate-600
                prose-li:my-0 prose-p:my-8 prose-lead:mt-0 md:prose-h1:text-5xl<?= $imageRight ? ' lg:order-1' : '' ?>">
        <div class="hidden lg:block">
            <div class="mb-12 space-y-2">
                <span class="inline-block px-2 py-1 rounded bg-blue-100 text-blue-600
                             text-xl font-semibold uppercase">
                    <?= $escaper->escapeHtml((string)$data['eyebrow']) ?>
                </span>
                <h2 id="<?= $escaper->escapeHtmlAttr($headingId) ?>">
                    <?= $escaper->escapeHtml((string)$data['heading']) ?>
                </h2>
            </div>
        </div>
        <p class="lead text-lg font-medium">
            <?= /* @noEscape escaped before applying nl2br */
            nl2br($escaper->escapeHtml((string)$data['lead'])) ?>
        </p>
        <?= /* @noEscape trusted-rich-text filtered by Magento CMS */
        $block->renderTrustedHtml((string)$data['content']) ?>
        <?php if (!empty($data['quote'])): ?>
            <blockquote class="flex gap-3 items-start border-l-0 my-10 pl-0 text-2xl font-normal not-italic
                               text-slate-800 before:content-[open-quote] before:-mt-2 before:text-blue-100
                               before:text-8xl before:leading-none before:font-bold">
                <?= /* @noEscape escaped before applying nl2br */
                nl2br($escaper->escapeHtml((string)$data['quote'])) ?>
            </blockquote>
        <?php endif; ?>
        <?php if (!empty($data['cta_url'])): ?>
            <p class="mt-8 mb-0">
                <a href="<?= $escaper->escapeUrl((string)$data['cta_url']) ?>"
                   class="<?= $escaper->escapeHtmlAttr($linkClasses[$data['link_appearance'] ?? 'button']) ?>"
                    <?php if (!empty($data['open_in_new'])): ?>target="_blank" rel="noopener noreferrer"<?php endif; ?>>
                    <?= $escaper->escapeHtml((string)$data['cta_label']) ?>
                </a>
            </p>
        <?php endif; ?>
    </div>
</article>
