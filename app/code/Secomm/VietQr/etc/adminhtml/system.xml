<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment" translate="label" type="text" sortOrder="400"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <group id="secomm_vietqr" translate="label" type="text"
                   sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>VietQR</label>

                <!-- General -->
                <field id="active" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Title</label>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort Order</label>
                    <frontend_class>validate-number</frontend_class>
                </field>
                <field id="debug" translate="label" type="select" sortOrder="35"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Debug Mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="min_order_total" translate="label" type="text" sortOrder="31"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Minimum Order Total</label>
                </field>
                <field id="max_order_total" translate="label" type="text" sortOrder="32"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Maximum Order Total</label>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="33"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Payment from Applicable Countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="34"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>

                <!-- Merchant Bank -->
                <field id="bank_code" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Bank Code</label>
                </field>
                <field id="bank_account" translate="label" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Bank Account</label>
                </field>
                <field id="account_name" translate="label" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Account Name</label>
                </field>

                <!-- VietQR API -->
                <field id="api_endpoint" translate="label" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Endpoint</label>
                </field>
                <field id="api_client_id" translate="label" type="obscure" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Client ID</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="request_timeout" translate="label" type="text" sortOrder="100"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Request Timeout (seconds)</label>
                    <frontend_class>validate-number</frontend_class>
                </field>

                <!-- Payment -->
                <field id="transfer_content_template" translate="label" type="text" sortOrder="110"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Transfer Content Template</label>
                    <comment><![CDATA[Available placeholder: <b>{{order_increment_id}}</b>]]></comment>
                </field>
                <field id="payment_instructions" translate="label" type="textarea" sortOrder="120"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment Instructions</label>
                </field>
                <field id="customer_confirm_comment" translate="label comment" type="textarea" sortOrder="125"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Customer Confirmed Comment</label>
                    <comment>Default order comment added to status history when customer confirms bank transfer on VietQR page.</comment>
                </field>
                <field id="order_status" translate="label" type="select" sortOrder="130"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>New Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\Newprocessing</source_model>
                </field>
                <field id="awaiting_confirm_status" translate="label" type="select" sortOrder="140"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Awaiting Confirm Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                </field>

                <!-- Auto-Cancel (AC-024..AC-027) -->
                <field id="autocancel_active" translate="label" type="select" sortOrder="150"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enable Auto-Cancel Cron</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Cancels unpaid VietQR orders that exceeded the payment timeout.</comment>
                </field>
                <field id="autocancel_frequency" translate="label" type="select" sortOrder="155"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Cron Frequency</label>
                    <source_model>Secomm\VietQr\Model\Source\CronFrequency</source_model>
                    <!-- Option values are literal cron expressions; the crontab job's
                         <config_path> points at this field's path, so the schedule is
                         resolved from this value at runtime. Server-level: default scope only. -->
                    <comment>The effective cancel delay is the timeout plus up to one interval. A frequency change can take up to ~1 hour to apply (already-generated schedule entries).</comment>
                </field>
                <field id="autocancel_timeout" translate="label" type="text" sortOrder="160"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Payment Timeout (minutes)</label>
                    <frontend_class>validate-greater-than-zero</frontend_class>
                    <comment>Maximum time an order may stay in the pending VietQR status before the cron cancels it. 1440 = 24 hours.</comment>
                    <depends>
                        <field id="autocancel_active">1</field>
                    </depends>
                </field>
                <field id="autocancel_reason" translate="label" type="text" sortOrder="170"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Cancel Reason</label>
                    <comment>Saved as an (admin-only) order status history comment when the cron cancels an order.</comment>
                    <depends>
                        <field id="autocancel_active">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>