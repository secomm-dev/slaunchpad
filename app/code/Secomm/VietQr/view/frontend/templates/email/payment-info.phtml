<?php
/** @var $block \Magento\Sales\Block\Order\Email\Items */
$order = $block->getOrder();
$payment = $order->getPayment();
if (!$payment || $payment->getMethod() !== 'secomm_vietqr') {
    return;
}
$info = $payment->getAdditionalInformation() ?: [];
$bankCode = $info['vietqr_bank_code'] ?? '';
$bankAccount = $info['vietqr_bank_account'] ?? '';
// Always VND (BUG-4BX0CK) — bank transfers only accept VND
$vndAmount = $block->getData('vietqr_vnd_amount');
$amount = isset($info['vietqr_amount'])
    ? (int)round((float)$info['vietqr_amount'])
    : ($vndAmount?->get($order) ?? 0);
$amountDisplay = $vndAmount ? $vndAmount->format($amount) : '';
$content = $info['vietqr_content'] ?? '';
$accountName = $info['vietqr_account_name'] ?? '';

$params = [];
if ($amount > 0) {
    $params['amount'] = $amount;
}
if (!empty($content)) {
    $params['addInfo'] = $content;
}
if (!empty($accountName)) {
    $params['accountName'] = $accountName;
}
$qrImageUrl = ($bankCode && $bankAccount)
    ? 'https://img.vietqr.io/image/' . urlencode($bankCode) . '-' . urlencode($bankAccount) . '-compact2.png?' . http_build_query($params)
    : '';

// AC-028: payment deadline while the order is still awaiting payment and the
// auto-cancel cron is enabled. This template reads the payment snapshot
// directly (PaymentInfo block is session-dependent); Config + Timezone are
// injected via layout arguments on vietqr.email.payment.info.
$deadlineLine = '';
$vietqrConfig = $block->getData('vietqr_config');
$vietqrTimezone = $block->getData('vietqr_timezone');
$storeId = (int)$order->getStoreId();
if ($vietqrConfig
    && $vietqrTimezone
    && $vietqrConfig->isAutoCancelEnabled($storeId)
    && $order->getStatus() === $vietqrConfig->getNewOrderStatus($storeId)
) {
    $deadline = new \DateTime($order->getCreatedAt(), new \DateTimeZone('UTC'));
    $deadline->modify('+' . $vietqrConfig->getAutoCancelTimeout($storeId) . ' minutes');
    $deadlineText = $vietqrTimezone->formatDateTime($deadline, \IntlDateFormatter::MEDIUM, \IntlDateFormatter::SHORT);
    $deadlineLine = (string)__(
        'Please complete your bank transfer before %1 — after this time the order will be canceled automatically.',
        $deadlineText
    );
}
?>
<?php if ($qrImageUrl): ?>
<div style="text-align:center;margin:20px 0;">
    <img src="<?= $block->escapeUrl($qrImageUrl) ?>" alt="<?= $block->escapeHtmlAttr(__('VietQR')) ?>" style="max-width:320px;width:100%;height:auto;border-radius:8px;border:1px solid #e0e0e0;"/>
</div>
<?php endif; ?>
<table class="order-info" style="width:100%;margin:20px 0 0;font-size:13px;border:1px solid #e0e0e0;border-collapse:collapse;">
    <tr>
        <td colspan="2" style="background:#f5f5f5;padding:10px;font-weight:bold;border-bottom:1px solid #e0e0e0;">
            <?= $block->escapeHtml(__('VietQR Payment Instructions')) ?>
        </td>
    </tr>
    <tr>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;width:40%;color:#666;">
            <?= $block->escapeHtml(__('Bank')) ?>
        </td>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;">
            <?= $block->escapeHtml($info['vietqr_bank_code'] ?? '') ?>
        </td>
    </tr>
    <tr>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;color:#666;">
            <?= $block->escapeHtml(__('Account Number')) ?>
        </td>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;">
            <?= $block->escapeHtml($info['vietqr_bank_account'] ?? '') ?>
        </td>
    </tr>
    <tr>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;color:#666;">
            <?= $block->escapeHtml(__('Account Holder')) ?>
        </td>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;">
            <?= $block->escapeHtml($info['vietqr_account_name'] ?? '') ?>
        </td>
    </tr>
    <tr>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;color:#666;">
            <?= $block->escapeHtml(__('Amount')) ?>
        </td>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;font-weight:bold;">
            <?= $block->escapeHtml($amountDisplay) ?>
        </td>
    </tr>
    <tr>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;color:#666;">
            <?= $block->escapeHtml(__('Transfer Content')) ?>
        </td>
        <td style="padding:8px 10px;border-bottom:1px solid #e0e0e0;">
            <?= $block->escapeHtml($info['vietqr_content'] ?? '') ?>
        </td>
    </tr>
    <?php if ($deadlineLine): ?>
    <tr>
        <td colspan="2" style="padding:10px;color:#b45309;border-bottom:1px solid #e0e0e0;">
            <?= $block->escapeHtml($deadlineLine) ?>
        </td>
    </tr>
    <?php endif; ?>
    <?php if (!empty($info['vietqr_payment_instructions'])): ?>
    <tr>
        <td colspan="2" style="padding:10px;color:#666;">
            <?= $block->escapeHtml($info['vietqr_payment_instructions']) ?>
        </td>
    </tr>
    <?php endif; ?>
</table>
