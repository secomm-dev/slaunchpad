<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
            <action method="setTitle">
                <argument name="title" xsi:type="string" translate="true">VietQR Payment</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Secomm\VietQr\Block\PaymentInfo"
                   name="vietqr.payment.info"
                   template="Secomm_VietQr::payment/view.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>