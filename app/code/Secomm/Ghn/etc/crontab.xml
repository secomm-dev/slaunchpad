<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <!-- TASK-GKHXY1 (GHN-E1): reconciliation refresh — heals missed webhooks for non-terminal
         GHN shipments. Opt-in via carriers/secomm_ghn/tracking_refresh_enabled; the webhook
         remains the primary source. -->
    <group id="default">
        <job name="secomm_ghn_tracking_refresh" instance="Secomm\Ghn\Cron\RefreshTracking" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
