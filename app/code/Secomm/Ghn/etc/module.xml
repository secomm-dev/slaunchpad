<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <!-- SPEC-FEAT-FQWEQ3 §39 — dependency direction: Secomm_Ghn → Secomm_ShippingCore →
         Secomm_VietNamAddress. No dependency on Secomm_GiaoHangNhanh / Secomm_GhnAddressMapper
         (legacy, replaced at GHN-F / TASK-8019VC); no carrier may depend on Secomm_Ghn. -->
    <module name="Secomm_Ghn">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Config"/>
            <module name="Magento_Directory"/>
            <module name="Magento_Shipping"/>
            <module name="Magento_Store"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Quote"/>
            <module name="Secomm_VietNamAddress"/>
            <module name="Secomm_ShippingCore"/>
        </sequence>
    </module>
</config>
