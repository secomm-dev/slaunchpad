<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <!-- GHN carrier defaults under the standard Delivery Methods section (carriers/secomm_ghn/*).
         api_token deliberately has NO default (encrypted backend; legacy giaohangnhanh_setting is
         NOT reused — parallel coexistence until GHN-F/TASK-8019VC). Debug defaults to 0.
         TASK-FMBBSD slice 2: the `enabled` field was replaced by Magento's standard carrier
         `active` gate (the carrier model node is what turns this group into a live carrier). -->
    <default>
        <carriers>
            <secomm_ghn>
                <active>0</active>
                <model>Secomm\Ghn\Model\Carrier\Ghn</model>
                <title>GHN</title>
                <!-- Storefront method title (SPEC §20 — one stable method, no provider ids). -->
                <name>GHN Delivery</name>
                <sort_order>20</sort_order>
                <showmethod>0</showmethod>
                <sallowspecific>1</sallowspecific>
                <specificcountry>VN</specificcountry>
                <specificerrmsg>This shipping method is not available. To use this shipping method, please contact us.</specificerrmsg>
                <environment>sandbox</environment>
                <!-- origin_district_id empty by default: GHN prices/creates against the shop's
                     registered address until the merchant pins a specific legacy district. -->
                <origin_district_id/>
                <!-- payment_type 1 = shop pays the GHN fee (Magento already charged shipping at
                     checkout — 2 would double-charge the customer; TASK-FMBBSD contract audit). -->
                <payment_type>1</payment_type>
                <required_note>CHOXEMHANGKHONGTHU</required_note>
                <debug>0</debug>
                <!-- TASK-GKHXY1 (GHN-E1): shared callback secret — the merchant configures the
                     SAME value as a GHN dashboard custom header (X-Secomm-Ghn-Secret). GHN
                     webhooks carry NO signature; empty = all callbacks rejected 401. -->
                <webhook_secret/>
                <tracking_refresh_enabled>0</tracking_refresh_enabled>
                <tracking_refresh_threshold_hours>6</tracking_refresh_threshold_hours>
                <connection_timeout>10</connection_timeout>
                <request_timeout>30</request_timeout>
                <!-- TASK-WAWNDS (v10) — explicit defaults matching Config accessors exactly:
                     fresh merchant config resolves deterministically without a save. -->
                <rate_source_mode>CARRIER_WITH_FALLBACK</rate_source_mode>
                <address_resolution_policy>FALLBACK</address_resolution_policy>
                <!-- FEAT-QA23PZ / DEC-FEATQA23PZ-001 — ALL keeps the pre-zone behavior exactly. -->
                <destination_scope>ALL</destination_scope>
                <allowed_zone_codes/>
                <!-- TASK-ZS2B41 (rev. 3-path, 2026-10-01) — merchant-tunable dimension limits
                     (cm) SHARED by RATE and CREATE (per LENGTH/WIDTH/HEIGHT). Authoritative
                     default lives in GhnShipmentConstraints (MAX_SIDE_CM = 200, Create
                     contract); the 150 sandbox observation is superseded as default — lower
                     these values when the GHN account enforces 150. Empty/invalid admin values
                     fall back to the constant (Config readPositiveInt); change BOTH
                     together when revising. -->
                <max_length_cm>200</max_length_cm>
                <max_width_cm>200</max_width_cm>
                <max_height_cm>200</max_height_cm>
                <!-- TASK-WNQCRW (2026-10-01, DEC-TASKWNQCRW-001) — merchant-tunable RATE
                     (checkout display) weight gate in GRAMS. Default 50000 =
                     GhnShipmentConstraints::TYPE_5_MAX_WEIGHT_G (Create contract) so checkout
                     display matches what CREATE enforces anyway; CREATE itself is FROZEN at
                     the constant and ignores this value. The fee API has no weight bound
                     (SANDBOX_OBSERVED 2026-09-30) — merchants RAISE this to re-enable >50kg
                     quoting. Per-unit only; aggregate weight is never capped. Empty/invalid
                     falls back to the constant (Config readPositiveInt). -->
                <max_package_weight_g>50000</max_package_weight_g>
                <rate_adjustment_enabled>0</rate_adjustment_enabled>
                <rate_adjustment_type>fixed</rate_adjustment_type>
                <rate_adjustment_rounding>none</rate_adjustment_rounding>
                <rate_adjustment_apply_to>carrier_rate_only</rate_adjustment_apply_to>
                <rate_adjustment_value>0</rate_adjustment_value>
            </secomm_ghn>
        </carriers>
    </default>
</config>
