<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Gateway config reader (methodCode = momo_payment) -->
    <virtualType name="MoMoConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">momo_payment</argument>
        </arguments>
    </virtualType>

    <!-- Module-wide config reader (decrypt secret_key, build endpoint by mode) -->
    <type name="Secomm\MoMo\Model\Config">
        <arguments>
            <argument name="config" xsi:type="object">MoMoConfig</argument>
        </arguments>
    </type>

    <!-- Value handler pool -->
    <virtualType name="MoMoValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">MoMoConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="MoMoConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">MoMoConfig</argument>
        </arguments>
    </virtualType>

    <!-- Validator pool -->
    <virtualType name="MoMoValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">MoMoCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="MoMoCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">MoMoConfig</argument>
        </arguments>
    </virtualType>

    <!-- Logger for gateway client -->
    <virtualType name="MoMoLogger" type="Magento\Payment\Model\Method\Logger">
        <arguments>
            <argument name="config" xsi:type="object">MoMoConfig</argument>
        </arguments>
    </virtualType>

    <!-- HTTP client (Laminas) with JSON->array converter -->
    <virtualType name="MoMoHttpClient" type="Secomm\MoMo\Gateway\Http\Client\Laminas">
        <arguments>
            <argument name="logger" xsi:type="object">MoMoLogger</argument>
            <argument name="converter" xsi:type="object">Secomm\MoMo\Gateway\Http\Converter\JsonToArray</argument>
        </arguments>
    </virtualType>

    <!-- Create order command (/v2/gateway/api/create) — attempt-based payload -->
    <virtualType name="MoMoCreateOrderCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Secomm\MoMo\Gateway\Request\CreateOrderBuilder</argument>
            <argument name="transferFactory" xsi:type="object">Secomm\MoMo\Gateway\Http\TransferFactory</argument>
            <argument name="client" xsi:type="object">MoMoHttpClient</argument>
            <argument name="handler" xsi:type="object">Secomm\MoMo\Gateway\Response\CreateOrderHandler</argument>
            <argument name="validator" xsi:type="object">Secomm\MoMo\Gateway\Validator\CreateOrderValidator</argument>
        </arguments>
    </virtualType>

    <!-- v2/query command (server-side authoritative status for the Return
         path). Response signature + identity echoes validated INSIDE the
         command (QueryValidator) — a signature-invalid response fails the
         command before any caller sees it. -->
    <virtualType name="MoMoQueryTransferFactory" type="Secomm\MoMo\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="urlPath" xsi:type="const">Secomm\MoMo\Model\Config::PATH_QUERY</argument>
        </arguments>
    </virtualType>
    <virtualType name="MoMoQueryCommand" type="Secomm\MoMo\Gateway\Command\QueryTransactionCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Secomm\MoMo\Gateway\Request\QueryDataBuilder</argument>
            <argument name="transferFactory" xsi:type="object">MoMoQueryTransferFactory</argument>
            <argument name="client" xsi:type="object">MoMoHttpClient</argument>
            <argument name="validator" xsi:type="object">Secomm\MoMo\Gateway\Validator\QueryValidator</argument>
        </arguments>
    </virtualType>

    <!-- Refund command (/v2/gateway/api/refund) -->
    <virtualType name="MoMoRefundTransferFactory" type="Secomm\MoMo\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="urlPath" xsi:type="const">Secomm\MoMo\Model\Config::PATH_REFUND</argument>
        </arguments>
    </virtualType>
    <virtualType name="MoMoRefundCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Secomm\MoMo\Gateway\Request\RefundBuilder</argument>
            <argument name="transferFactory" xsi:type="object">MoMoRefundTransferFactory</argument>
            <argument name="client" xsi:type="object">MoMoHttpClient</argument>
            <argument name="handler" xsi:type="object">Secomm\MoMo\Gateway\Response\RefundHandler</argument>
            <argument name="validator" xsi:type="object">Secomm\MoMo\Gateway\Validator\RefundValidator</argument>
        </arguments>
    </virtualType>

    <!-- Command pool. NO `notify` entry: the IPN is processed by
         IpnProcessor (outcomes + lifecycle), not a gateway command.
         capture/cancel stay NullCommand: the local capture runs inside the
         OrderFinalizer transaction, local only, no HTTP in TX. -->
    <virtualType name="MoMoCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">Secomm\MoMo\Gateway\Command\InitializeCommand</item>
                <item name="get_pay_url" xsi:type="string">MoMoCreateOrderCommand</item>
                <item name="query_transaction" xsi:type="string">MoMoQueryCommand</item>
                <item name="refund" xsi:type="string">MoMoRefundCommand</item>
                <item name="capture" xsi:type="string">Magento\Payment\Gateway\Command\NullCommand</item>
                <item name="cancel_order" xsi:type="string">Magento\Payment\Gateway\Command\NullCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Payment method facade (Adapter — required by spec §10) -->
    <virtualType name="MoMoFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">momo_payment</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">MoMoValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">MoMoValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">MoMoCommandPool</argument>
        </arguments>
    </virtualType>

    <!--
        Server-side guard: a MoMo quote may only become a Sales Order
        through the exact internal authorization opened by OrderFinalizer
        (OrderPlacementAuthorization). Registered on the concrete
        QuoteManagement (the single CartManagementInterface implementation
        and the interface preference) so the plugin compiles for frontend,
        webapi_rest, graphql and webapi_soap. Admin order creation is
        unaffected: it places orders via QuoteManagement::submit()
        (AdminOrder\Create::createOrder), which is not intercepted.
    -->
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="momo_place_order_guard"
                type="Secomm\MoMo\Plugin\Quote\CartManagementPlaceOrderGuard"
                sortOrder="10"/>
    </type>
    <type name="Secomm\MoMo\Plugin\Quote\CartManagementPlaceOrderGuard">
        <arguments>
            <argument name="method" xsi:type="object">MoMoFacade</argument>
        </arguments>
    </type>

    <!-- Payment-first services -->
    <type name="Secomm\MoMo\Model\PaymentAttemptManagement">
        <arguments>
            <argument name="commandPool" xsi:type="object">MoMoCommandPool</argument>
            <argument name="method" xsi:type="object">MoMoFacade</argument>
            <argument name="config" xsi:type="object">MoMoConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\MoMo\Service\OrderFinalizer">
        <arguments>
            <argument name="method" xsi:type="object">MoMoFacade</argument>
            <argument name="config" xsi:type="object">MoMoConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\MoMo\Service\ReturnProcessor">
        <arguments>
            <argument name="commandPool" xsi:type="object">MoMoCommandPool</argument>
        </arguments>
    </type>
</config>
