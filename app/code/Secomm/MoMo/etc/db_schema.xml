<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        Payment-first initiation attempts (MOMO-01).
        One row per MoMo transaction created against a Quote (before any
        Magento order exists). order_ref is unique => a provider transaction
        can never fork into two attempts; order_id is unique => two attempts
        can never claim the same Magento order.
    -->
    <table name="secomm_momo_payment_attempt" resource="default" engine="innodb"
           comment="MoMo payment-first initiation attempts">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity Id"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" comment="Owning Quote Id"/>
        <column xsi:type="varchar" name="reserved_order_id" nullable="false" length="64"
                comment="Quote reserved order increment id"/>
        <column xsi:type="varchar" name="order_ref" nullable="true" length="64"
                comment="MoMo orderId merchant reference (minted at initiation)"/>
        <column xsi:type="varchar" name="request_id" nullable="true" length="96"
                comment="MoMo requestId of the create call (query identity)"/>
        <column xsi:type="varchar" name="provider_transaction_id" nullable="true" length="64"
                comment="MoMo transId of the confirmed transaction"/>
        <column xsi:type="text" name="pay_url" nullable="true" comment="MoMo pay URL"/>
        <column xsi:type="varchar" name="provider_status" nullable="true" length="32"
                comment="Provider-side status"/>
        <column xsi:type="varchar" name="payment_status" nullable="false" length="32" default="initiated"
                comment="Attempt lifecycle status"/>
        <column xsi:type="int" name="amount" padding="10" unsigned="true" nullable="false"
                comment="Snapshot amount in VND (locked at initiation)"/>
        <column xsi:type="varchar" name="currency" nullable="false" length="3" default="VND" comment="Currency"/>
        <column xsi:type="varchar" name="contract_hash" nullable="true" length="64"
                comment="Quote payment-contract fingerprint (sha-256) locked at initiation"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true"
                comment="Sales order entity id after finalize"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last error message"/>
        <column xsi:type="boolean" name="requires_reconciliation" nullable="false" default="false"
                comment="Money-real but NOT auto-finalizable (amount/contract/provider-id conflict)"/>
        <column xsi:type="varchar" name="reconciliation_code" nullable="true" length="64"
                comment="Machine-readable reason code for requires_reconciliation"/>
        <column xsi:type="smallint" name="retry_count" padding="5" unsigned="true" nullable="false" default="0"
                comment="Number of prior attempts for the same quote"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" default="0"
                comment="Store Id"/>
        <column xsi:type="int" name="email_dispatch" padding="10" unsigned="true" nullable="true" identity="false"
                comment="Order confirmation email dispatch claim (unix ts of the in-flight claim, NULL = none)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <column xsi:type="timestamp" name="expires_at" nullable="true" on_update="false"
                comment="Attempt expiry (TTL, lazy-evaluated)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_ORDER_REF">
            <column name="order_ref"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_REQUEST_ID">
            <column name="request_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_ORDER_ID">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="secomm_momo_payment_attempt" column="quote_id" referenceTable="quote"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="secomm_momo_payment_attempt" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_RESERVED_ORDER_ID" indexType="btree">
            <column name="reserved_order_id"/>
        </index>
        <index referenceId="SECOMM_MOMO_PAYMENT_ATTEMPT_PAYMENT_STATUS" indexType="btree">
            <column name="payment_status"/>
        </index>
    </table>
</schema>
