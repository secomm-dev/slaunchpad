<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- FEAT-CSWYEJ — Continue Payment button on the customer order view.
             Runtime fix 2026-08-25: placed directly in the content container.
             The previous version attached it as a child of sales.order.info,
             whose template never renders children — the block was never
             instantiated (die() probes in block/template both stayed silent).
             cacheable="false" — visibility depends on order state + expiry. -->
        <referenceContainer name="content">
            <block class="Secomm\PaymentCore\Block\ContinuePaymentButton"
                   name="secomm.paymentcore.continue.button"
                   template="Secomm_PaymentCore::order/continue-payment.phtml"
                   after="sales.order.info"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
