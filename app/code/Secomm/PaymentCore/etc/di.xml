<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Secomm\PaymentCore\Api\Data\PaymentInterface"
                type="Secomm\PaymentCore\Model\Payment"/>
    <preference for="Secomm\PaymentCore\Api\Data\PaymentSearchResultsInterface"
                type="Magento\Framework\Api\SearchResults"/>
    <preference for="Secomm\PaymentCore\Api\PaymentRepositoryInterface"
                type="Secomm\PaymentCore\Model\PaymentRepository"/>

    <!-- FEAT-CSWYEJ / DEC-FEATCSWYEJ-002 — VNPAY adapter lives inside the core
         (Vnpayment_VNPAY stays pristine). Future providers register the same way. -->
    <type name="Secomm\PaymentCore\Model\Adapter\AdapterPool">
        <arguments>
            <argument name="adapters" xsi:type="array">
                <item name="vnpay" xsi:type="object">Secomm\PaymentCore\Model\Provider\VnpayAdapter</item>
            </argument>
        </arguments>
    </type>

    <!-- TASK-Q2BAHW — console command for QC: bin/magento paymentcore:expire:run -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="secommPaymentCoreExpireRun" xsi:type="object">Secomm\PaymentCore\Console\Command\ExpirePaymentsCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- FEAT-CSWYEJ — lifecycle log channel var/log/secomm_paymentcore.log via
         Logger\Handler (dedicated handler class — the framework System handler
         does not work as a virtualType here; runtime-verified 2026-08-25).
         Every class that logs gets the virtual logger injected explicitly. -->
    <type name="Secomm\PaymentCore\Model\Config">
        <arguments>
            <argument name="logger" xsi:type="object">SecommPaymentCoreLogger</argument>
        </arguments>
    </type>
    <type name="Secomm\PaymentCore\Model\Lifecycle\AssignManagedPayment">
        <arguments>
            <argument name="logger" xsi:type="object">SecommPaymentCoreLogger</argument>
        </arguments>
    </type>
    <type name="Secomm\PaymentCore\Model\Lifecycle\ExpirePayments">
        <arguments>
            <argument name="logger" xsi:type="object">SecommPaymentCoreLogger</argument>
        </arguments>
    </type>
    <type name="Secomm\PaymentCore\Model\Lifecycle\CancelExpiredOrder">
        <arguments>
            <argument name="logger" xsi:type="object">SecommPaymentCoreLogger</argument>
        </arguments>
    </type>
    <type name="Secomm\PaymentCore\Controller\Payment\Retry">
        <arguments>
            <argument name="logger" xsi:type="object">SecommPaymentCoreLogger</argument>
        </arguments>
    </type>
    <virtualType name="SecommPaymentCoreLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">secomm_paymentcore</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Secomm\PaymentCore\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
</config>
