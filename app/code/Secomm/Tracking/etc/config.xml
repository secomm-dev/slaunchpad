<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <!-- FEAT-31X6N2 / TASK-0TTQRX AC-3: every enable flag defaults OFF — module is a
         runtime no-op until a vendor section is deliberately configured (AC-5).
         Encrypted backend fields (tokens) default empty; never commit real values. -->
    <default>
        <secomm_tracking>
            <general>
                <enabled>0</enabled>
                <debug_log>0</debug_log>
            </general>
            <tiktok>
                <enabled>0</enabled>
                <pixel_id/>
                <access_token backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <test_mode>0</test_mode>
            </tiktok>
            <refund>
                <enabled>0</enabled>
            </refund>
        </secomm_tracking>
    </default>
</config>