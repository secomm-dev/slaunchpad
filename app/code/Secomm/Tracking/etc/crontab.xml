<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <!-- FEAT-31X6N2 / TASK-0TTQRX: schedule only — Cron/OutboxFlush is a safe no-op
         until TASK-VRKJKQ implements the flush service (exits immediately when the
         master switch is off or no pending rows exist, so it never holds a cron lock).
         Every-minute cadence follows the Mageplaza AbandonedCart precedent. -->
    <group id="default">
        <job name="secomm_tracking_outbox_flush" instance="Secomm\Tracking\Cron\OutboxFlush" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>