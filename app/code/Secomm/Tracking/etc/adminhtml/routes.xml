<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Backend:etc/routes.xsd">
    <!-- FEAT-31X6N2 / TASK-WY5JRN — admin frontName for the read-only QC grids.
         Without this declaration the menu actions 404 (router never matches
         secomm_tracking/... paths). -->
    <router id="admin">
        <route id="secomm_tracking" frontName="secomm_tracking">
            <module name="Secomm_Tracking" before="Magento_Backend"/>
        </route>
    </router>
</config>