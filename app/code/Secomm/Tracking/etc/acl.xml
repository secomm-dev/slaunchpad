<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="MenuSecomm_Base::management" title="CORE" sortOrder="0">
                    <resource id="Secomm_Tracking::tracking" title="Commerce Tracking" sortOrder="20">
                        <resource id="Secomm_Tracking::delivery" title="Delivery Log" sortOrder="10"/>
                        <resource id="Secomm_Tracking::outbox" title="Event Outbox" sortOrder="20"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Secomm_Tracking::config" title="Secomm Commerce Tracking" sortOrder="60"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
