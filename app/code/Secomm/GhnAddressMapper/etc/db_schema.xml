<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="secomm_ghn_address_mapping_location" resource="default" engine="innodb"
           comment="GHN Address Mapping Location">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="country_id" nullable="false" length="10" default="VN"
                comment="Country ID"/>
        <column xsi:type="int" name="region_id" padding="10" unsigned="true" nullable="false"
                comment="Magento Region ID"/>
        <column xsi:type="int" name="city_id" padding="10" unsigned="true" nullable="true"
                comment="Magento City ID (directory_region_city.city_id, locale-independent key)"/>
        <column xsi:type="varchar" name="city_name" nullable="true" length="255"
                comment="City Name (display cache, populated from directory_region_city by city_id)"/>
        <column xsi:type="int" name="ghn_province_id" padding="10" unsigned="true" nullable="false"
                comment="GHN Province ID"/>
        <column xsi:type="varchar" name="ghn_province_name" nullable="true" length="255"
                comment="GHN Province Name"/>
        <column xsi:type="int" name="ghn_district_id" padding="10" unsigned="true" nullable="false"
                comment="GHN District ID"/>
        <column xsi:type="varchar" name="ghn_district_name" nullable="true" length="255"
                comment="GHN District Name"/>
        <column xsi:type="varchar" name="ghn_ward_code" nullable="false" length="32"
                comment="GHN Ward Code"/>
        <column xsi:type="varchar" name="ghn_ward_name" nullable="true" length="255"
                comment="GHN Ward Name"/>
        <column xsi:type="smallint" name="status" padding="6" unsigned="false" nullable="false" default="1"
                comment="Status 1=Enabled 0=Disabled"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHN_ADDR_MAP_UNIQUE_CITY">
            <column name="city_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="GHN_ADDR_MAP_REGION_ID_DIR_COUNTRY_REGION_REGION_ID"
                    table="secomm_ghn_address_mapping_location"
                    column="region_id"
                    referenceTable="directory_country_region"
                    referenceColumn="region_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="GHN_ADDR_MAP_CITY_ID_DIR_REGION_CITY_CITY_ID"
                    table="secomm_ghn_address_mapping_location"
                    column="city_id"
                    referenceTable="directory_region_city"
                    referenceColumn="city_id"
                    onDelete="CASCADE"/>
        <index referenceId="GHN_ADDR_MAP_REGION_ID" indexType="btree">
            <column name="region_id"/>
        </index>
        <index referenceId="GHN_ADDR_MAP_GHN_PROVINCE_ID" indexType="btree">
            <column name="ghn_province_id"/>
        </index>
        <index referenceId="GHN_ADDR_MAP_GHN_DISTRICT_ID" indexType="btree">
            <column name="ghn_district_id"/>
        </index>
        <index referenceId="GHN_ADDR_MAP_GHN_WARD_CODE" indexType="btree">
            <column name="ghn_ward_code"/>
        </index>
    </table>
</schema>
