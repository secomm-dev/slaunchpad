<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="secomm_fulfillment_export" resource="default" engine="innodb"
           comment="Magento order to external OMS export mapping (SLP-30 / FFC-001)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="magento_order_id" unsigned="true" nullable="false"
                comment="sales_order.entity_id"/>
        <column xsi:type="varchar" name="magento_increment_id" nullable="false" length="64"
                comment="sales_order.increment_id (correlation; not PII)"/>
        <column xsi:type="varchar" name="service_code" nullable="false" length="32"
                comment="Registered exporter key (adapter-defined)"/>
        <column xsi:type="varchar" name="external_order_id" nullable="true" length="64"
                comment="Remote OMS order id"/>
        <column xsi:type="varchar" name="origin" nullable="false" length="16" default="magento"
                comment="Always magento for outbound-created rows"/>
        <column xsi:type="varchar" name="push_status" nullable="false" length="16" default="pending"
                comment="pending|success|failed"/>
        <column xsi:type="varchar" name="current_status" nullable="true" length="64"
                comment="Current raw status from the POS/OMS (adapter-defined, e.g. Pancake status code)"/>
        <column xsi:type="smallint" name="attempt_count" unsigned="true" nullable="false" default="0"
                comment="Export attempts"/>
        <column xsi:type="varchar" name="last_error" nullable="true" length="255"
                comment="Generic error code/message; never store PII or secrets"/>
        <column xsi:type="timestamp" name="last_pushed_at" on_update="false" nullable="true"
                comment="Last successful or attempted push"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_FULFILLMENT_EXPORT_ORDER_SERVICE">
            <column name="magento_order_id"/>
            <column name="service_code"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SECOMM_FULFILLMENT_EXPORT_ORDER_ID_SALES_ORDER"
                    table="secomm_fulfillment_export" column="magento_order_id"
                    referenceTable="sales_order" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <index referenceId="SECOMM_FULFILLMENT_EXPORT_STATUS_ATTEMPT" indexType="btree">
            <column name="push_status"/>
            <column name="attempt_count"/>
        </index>
        <index referenceId="SECOMM_FULFILLMENT_EXPORT_SERVICE_EXTERNAL" indexType="btree">
            <column name="service_code"/>
            <column name="external_order_id"/>
        </index>
    </table>
    <table name="secomm_fulfillment_state" resource="default" engine="innodb"
           comment="Latest normalized fulfillment state per Magento order (SLP-30 / FFC-002)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="magento_order_id" unsigned="true" nullable="false"
                comment="sales_order.entity_id"/>
        <column xsi:type="varchar" name="service_code" nullable="false" length="32"
                comment="Adapter service_code"/>
        <column xsi:type="varchar" name="external_order_id" nullable="true" length="64"
                comment="Remote OMS order id"/>
        <column xsi:type="varchar" name="normalized_status" nullable="false" length="32"
                comment="NormalizedFulfillmentStatus constant"/>
        <column xsi:type="varchar" name="raw_status" nullable="true" length="64"
                comment="Vendor raw status code"/>
        <column xsi:type="varchar" name="last_event_id" nullable="true" length="64"
                comment="Idempotency key"/>
        <column xsi:type="varchar" name="carrier_name" nullable="true" length="128"
                comment="Carrier display name"/>
        <column xsi:type="varchar" name="tracking_number" nullable="true" length="64"
                comment="Tracking number"/>
        <column xsi:type="varchar" name="tracking_url" nullable="true" length="255"
                comment="Tracking URL"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_FULFILLMENT_STATE_ORDER">
            <column name="magento_order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SECOMM_FULFILLMENT_STATE_ORDER_ID_SALES_ORDER"
                    table="secomm_fulfillment_state" column="magento_order_id"
                    referenceTable="sales_order" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
    <table name="secomm_fulfillment_warehouse_map" resource="default" engine="innodb"
           comment="MSI source to external OMS warehouse map per service (SLP-30 / FFC-004)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="service_code" nullable="false" length="32"
                comment="Adapter service_code (scopes uniqueness)"/>
        <column xsi:type="varchar" name="magento_source_code" nullable="false" length="64"
                comment="MSI inventory_source.source_code"/>
        <column xsi:type="varchar" name="external_warehouse_id" nullable="false" length="64"
                comment="Remote warehouse id"/>
        <column xsi:type="varchar" name="external_warehouse_label" nullable="true" length="255"
                comment="Cached remote warehouse label for admin"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1"
                comment="1=active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_FF_WH_MAP_SERVICE_SOURCE">
            <column name="service_code"/>
            <column name="magento_source_code"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_FF_WH_MAP_SERVICE_WAREHOUSE">
            <column name="service_code"/>
            <column name="external_warehouse_id"/>
        </constraint>
        <index referenceId="SECOMM_FF_WH_MAP_ACTIVE" indexType="btree">
            <column name="service_code"/>
            <column name="is_active"/>
        </index>
    </table>
    <table name="secomm_fulfillment_status_map" resource="default" engine="innodb"
           comment="POS raw status to Magento sales_order.status map per service (like warehouse map)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="service_code" nullable="false" length="32"
                comment="Adapter service_code (scopes uniqueness)"/>
        <column xsi:type="varchar" name="magento_order_status" nullable="false" length="32"
                comment="Magento sales_order.status"/>
        <column xsi:type="varchar" name="external_status_code" nullable="false" length="64"
                comment="Remote POS/OMS status code"/>
        <column xsi:type="varchar" name="external_status_label" nullable="true" length="255"
                comment="Cached remote status label for admin"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1"
                comment="1=active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="true"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_FF_ST_MAP_SERVICE_EXTERNAL">
            <column name="service_code"/>
            <column name="external_status_code"/>
        </constraint>
        <index referenceId="SECOMM_FF_ST_MAP_ACTIVE" indexType="btree">
            <column name="service_code"/>
            <column name="is_active"/>
        </index>
    </table>
</schema>
