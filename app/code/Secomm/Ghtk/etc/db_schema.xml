<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        GHTK address OVERRIDE table (DEC-TASK7AJ3K8-002 — r1 TEXT_NATIVE correction).
        Responsibility: exception/representation overrides ONLY — canonical Vietnamese
        names (name_vi, Secomm_VietNamAddress reference layer) are the DEFAULT GHTK
        destination/pickup representation; a row here replaces them ONLY for units the
        GHTK API demonstrably needs different text for. Empty table = fully functional.
        NOT a source of truth for VN administrative identity.
        Canonical key (scheme_code, province_code, ward_code) — stable across VN scheme
        swaps (DEC-FEATYA2C0W-004 D6 satisfied); no runtime directory references, hence
        no scheme-swap guard registration.
        Requires `setup:upgrade` (replaces the r0 runtime-keyed alias schema; existing
        rows must be re-imported via the new CSV format).
    -->
    <table name="secomm_ghtk_address_map" resource="default" engine="innodb" comment="GHTK Address Overrides (exception representation only)">
        <column xsi:type="int" name="map_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Override Id"/>
        <column xsi:type="varchar" name="scheme_code" nullable="false" length="32"
                comment="Canonical VN admin scheme code (e.g. VN_ADMIN_2025)"/>
        <column xsi:type="varchar" name="province_code" nullable="false" length="32"
                comment="Canonical region unit code (e.g. VN-01)"/>
        <column xsi:type="varchar" name="ward_code" nullable="false" length="32"
                comment="Canonical ward unit code (e.g. VNA25-3D6A6CF4D0)"/>
        <column xsi:type="varchar" name="ghtk_province" nullable="true" length="255"
                comment="GHTK province override (null = use canonical name_vi)"/>
        <column xsi:type="varchar" name="ghtk_district" nullable="true" length="255"
                comment="GHTK district override (null = omit unless canonical data provides one)"/>
        <column xsi:type="varchar" name="ghtk_ward" nullable="true" length="255"
                comment="GHTK ward override (null = use canonical name_vi)"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" identity="false"
                default="1" comment="Is Active"/>
        <column xsi:type="varchar" name="note" nullable="true" length="255"
                comment="Why this override exists (evidence reference)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="true" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="map_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_GHTK_ADDR_OVERRIDE_SCHEME_PROV_WARD">
            <column name="scheme_code"/>
            <column name="province_code"/>
            <column name="ward_code"/>
        </constraint>
        <index referenceId="SECOMM_GHTK_ADDR_OVERRIDE_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>
    <!--
        TASK-DFGFZ9 phase 2 (DEC-TASKDFGFZ9-002) — GHTK provider shipment persistence: submit
        idempotency anchor + frozen COD collection decision. One row per submit attempt,
        written PENDING BEFORE the Create Order POST (parity with Secomm_Ghn); `cod_amount` is
        FROZEN at the decision so a retry replays the original amount (never re-decides), and
        a non-FAILED row with amount > 0 on a DIFFERENT partner code of the same order blocks
        a second COD collection (P1 one-collection-per-order rule).
        `magento_shipment_id` stays NULL: the submit runs inside the native label flow,
        BEFORE the Magento shipment is saved (there is no entity id yet and no post-save
        hook to backfill); linkage = partner_order_code + shipment comment + sales_shipment_track.
    -->
    <table name="secomm_ghtk_shipment" resource="default" engine="innodb" comment="Secomm_Ghtk provider shipment persistence (submit idempotency + frozen COD collection anchor)">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="partner_order_code" nullable="false" length="64"
                comment="Deterministic idempotency key — ghtk-{increment_id}-{seq}; written before the API call"/>
        <column xsi:type="int" name="magento_order_id" padding="10" unsigned="true" nullable="false"
                comment="sales_order.entity_id"/>
        <column xsi:type="int" name="magento_shipment_id" padding="10" unsigned="true" nullable="true"
                comment="sales_shipment.entity_id — always NULL today (submit precedes the shipment save)"/>
        <column xsi:type="varchar" name="provider_status" nullable="false" length="16" default="PENDING"
                comment="PENDING | SUBMITTED | RECOVERED | FAILED | UNKNOWN (PENDING/UNKNOWN = outcome uncertain)"/>
        <column xsi:type="varchar" name="provider_reason_code" nullable="true" length="64"
                comment="Failure/uncertainty token (FAILED/UNKNOWN rows)"/>
        <column xsi:type="decimal" name="cod_amount" scale="4" precision="12" unsigned="true" nullable="false" default="0"
                comment="Frozen pick_money submitted upstream (VND); 0 = non-COD"/>
        <column xsi:type="int" name="weight_gram" padding="10" unsigned="true" nullable="true"
                comment="Submitted weight (grams)"/>
        <column xsi:type="varchar" name="label_id" nullable="true" length="64"
                comment="GHTK label id (SUBMITTED/RECOVERED rows)"/>
        <column xsi:type="varchar" name="tracking_number" nullable="true" length="64"
                comment="GHTK tracking number (SUBMITTED/RECOVERED rows)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="true" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_GHTK_SHIPMENT_PARTNER_CODE">
            <column name="partner_order_code"/>
        </constraint>
        <index referenceId="SECOMM_GHTK_SHIPMENT_ORDER_ID" indexType="btree">
            <column name="magento_order_id"/>
        </index>
    </table>
</schema>
