<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="zalo_pay_refund" resource="default" engine="innodb" comment="Refund">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity Id Column"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" identity="false"
                comment="Order Id Column"/>
        <column xsi:type="int" name="credit_memo_id" padding="10" unsigned="true" nullable="true" identity="false"
                comment="Credit Memo Id (NULL during the initiating claim; bound to the REAL entity_id before provider I/O - round 4 F17)"/>
        <column xsi:type="varchar" name="increment_id" nullable="false" length="45" comment="Increment Id Column"/>
        <column xsi:type="varchar" name="additional_information" nullable="false" length="255"
                comment="Additional Information Column"/>
        <column xsi:type="varchar" name="m_refund_id" nullable="false" length="64"
                comment="Stable provider request identity (m_refund_id) - identical value re-queried on recovery, never re-requested"/>
        <column xsi:type="boolean" name="is_processed" nullable="false" comment="Is Processed Column"/>
        <column xsi:type="float" name="amount" scale="0" precision="0" unsigned="false" nullable="false" comment="Amount"/>
        <column xsi:type="smallint" name="query_attempts" padding="5" unsigned="true" nullable="false" default="0"
                comment="Bounded v2/query_refund attempts budget (96 = ~24h at 15-min cron)"/>
        <column xsi:type="text" name="last_error" nullable="true"
                comment="Terminal-failure evidence (provider FAIL) - safe text only; NULL when none"/>
        <column xsi:type="varchar" name="refund_state" nullable="false" length="32" default="processing"
                comment="Semantic outcome state: initiating | processing | unknown | provider_success_local_pending | confirmed_success | confirmed_fail (unknown and provider_success_local_pending keep blocking until resolved)"/>
        <column xsi:type="smallint" name="active_claim" padding="5" unsigned="true" nullable="true"
                comment="1 = THE atomic active refund attempt for the order (DB-level guard: unique with order_id and m_refund_id); NULL = resolved/inactive"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ZALO_PAY_REFUND_ENTITY_ID" indexType="btree">
            <column name="entity_id"/>
        </index>
        <index referenceId="ZALO_PAY_REFUND_CREDIT_MEMO_ID" indexType="btree">
            <column name="credit_memo_id"/>
        </index>
        <constraint xsi:type="unique" referenceId="ZALO_PAY_REFUND_ORDER_ACTIVE">
            <column name="order_id"/>
            <column name="active_claim"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZALO_PAY_REFUND_M_REFUND_ID_ACTIVE">
            <column name="m_refund_id"/>
            <column name="active_claim"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ZALO_PAY_REFUND_CREDIT_MEMO_ID" table="zalo_pay_refund"
                    column="credit_memo_id" referenceTable="sales_creditmemo" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
    <!--
        Payment-first initiation attempts (ZALOPAY-PAYMENT-FIRST Phase 1).
        One row per ZaloPay transaction created against a Quote (before any
        Magento order exists). app_trans_id is unique => a provider
        transaction can never fork into two attempts; order_id is unique
        => two attempts can never claim the same Magento order.
    -->
    <table name="secomm_zalopay_payment_attempt" resource="default" engine="innodb"
           comment="ZaloPay payment-first initiation attempts">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity Id"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" comment="Owning Quote Id"/>
        <column xsi:type="varchar" name="reserved_order_id" nullable="false" length="64"
                comment="Quote reserved order increment id"/>
        <column xsi:type="varchar" name="app_trans_id" nullable="true" length="64"
                comment="ZaloPay app_trans_id (our merchant reference)"/>
        <column xsi:type="varchar" name="provider_transaction_id" nullable="true" length="64"
                comment="ZaloPay zp_trans_id"/>
        <column xsi:type="text" name="pay_url" nullable="true" comment="ZaloPay pay URL"/>
        <column xsi:type="varchar" name="provider_status" nullable="true" length="32"
                comment="Provider-side status"/>
        <column xsi:type="varchar" name="payment_status" nullable="false" length="32" default="initiated"
                comment="Attempt lifecycle status"/>
        <column xsi:type="int" name="amount" padding="10" unsigned="true" nullable="false"
                comment="Snapshot amount in VND (locked at initiation)"/>
        <column xsi:type="varchar" name="currency" nullable="false" length="3" default="VND" comment="Currency"/>
        <column xsi:type="varchar" name="contract_hash" nullable="true" length="64"
                comment="Quote payment-contract fingerprint (sha-256) locked at initiation"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true"
                comment="Sales order entity id after finalize"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last error message"/>
        <column xsi:type="boolean" name="requires_reconciliation" nullable="false" default="false"
                comment="Money-real but NOT auto-finalizable (amount/contract/provider-id conflict)"/>
        <column xsi:type="varchar" name="reconciliation_code" nullable="true" length="64"
                comment="Machine-readable reason code for requires_reconciliation"/>
        <column xsi:type="smallint" name="recovery_attempts" padding="5" unsigned="true" nullable="false" default="0"
                comment="Proactive lost-callback query attempts (bounded recovery worker)"/>
        <column xsi:type="boolean" name="recovery_exhausted" nullable="false" default="false"
                comment="Explicit marker: bounded recovery worker consumed its full proactive query budget (operational; NOT money-real evidence)"/>
        <column xsi:type="smallint" name="retry_count" padding="5" unsigned="true" nullable="false" default="0"
                comment="Number of prior attempts for the same quote"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" default="0"
                comment="Store Id"/>
        <column xsi:type="int" name="email_dispatch" padding="10" unsigned="true" nullable="true" identity="false"
                comment="Order confirmation email dispatch claim (unix ts of the in-flight claim, NULL = none)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <column xsi:type="timestamp" name="expires_at" nullable="true" on_update="false"
                comment="Attempt expiry (TTL)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_APP_TRANS_ID">
            <column name="app_trans_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_ORDER_ID">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="secomm_zalopay_payment_attempt" column="quote_id" referenceTable="quote"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="secomm_zalopay_payment_attempt" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_RESERVED_ORDER_ID" indexType="btree">
            <column name="reserved_order_id"/>
        </index>
        <index referenceId="SECOMM_ZALOPAY_PAYMENT_ATTEMPT_PAYMENT_STATUS" indexType="btree">
            <column name="payment_status"/>
        </index>
    </table>
</schema>
