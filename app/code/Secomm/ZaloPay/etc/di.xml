<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="ZaloPayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">zalopay</argument>
        </arguments>

    </virtualType>
    <virtualType name="ZaloPayLogger" type="Magento\Payment\Model\Method\Logger">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </virtualType>
    <type name="Secomm\ZaloPay\Gateway\Helper\Authorization">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Gateway\Request\OrderAdditionalInformationDataBuilder">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <virtualType name="ZaloPayTransferFactory" type="Secomm\ZaloPay\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
            <argument name="urlPath" xsi:type="const">
                Secomm\ZaloPay\Gateway\Request\AbstractDataBuilder::PAY_URL_PATH
            </argument>
        </arguments>
    </virtualType>
    <type name="Secomm\ZaloPay\Block\Info">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <virtualType name="ZaloPayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">zalopay</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Secomm\ZaloPay\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">ZaloPayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">ZaloPayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">ZaloPayCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ZaloPayDefaultValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayDefaultValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">ZaloPayCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayLaminasHttpClient" type="Secomm\ZaloPay\Gateway\Http\Client\Zend">
        <arguments>
            <argument name="logger" xsi:type="object">ZaloPayLogger</argument>
            <argument name="converter" xsi:type="object">Secomm\ZaloPay\Gateway\Http\Converter\JsonToArray</argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">Secomm\ZaloPay\Gateway\Command\InitializeCommand</item>
                <item name="get_pay_url" xsi:type="string">Secomm\ZaloPay\Gateway\Command\GetPayUrlCommand</item>
                <item name="query_transaction" xsi:type="string">Secomm\ZaloPay\Gateway\Command\QueryTransactionCommand</item>
                <item name="capture" xsi:type="string">Magento\Payment\Gateway\Command\NullCommand</item>
                <item name="cancel_order" xsi:type="string">Magento\Payment\Gateway\Command\NullCommand</item>
                <item name="refund" xsi:type="string">Secomm\ZaloPay\Gateway\Command\RefundCommand</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Secomm\ZaloPay\Gateway\Command\GetPayUrlCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">ZaloPayPayUrlDataBuilder</argument>
            <argument name="transferFactory" xsi:type="object">ZaloPayTransferFactory</argument>
            <argument name="client" xsi:type="object">ZaloPayLaminasHttpClient</argument>
            <argument name="validator" xsi:type="object">Secomm\ZaloPay\Gateway\Validator\GetPayUrlValidator</argument>
        </arguments>
        <plugin name="generateMac" type="Secomm\ZaloPay\Plugin\Gateway\Command\PayUrlGenerateMac" sortOrder="10"/>
    </type>

    <!-- v2/query transaction status (payment-first return verification) -->
    <type name="Secomm\ZaloPay\Gateway\Command\QueryTransactionCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">ZaloPayQueryDataBuilder</argument>
            <argument name="transferFactory" xsi:type="object">ZaloPayQueryTransferFactory</argument>
            <argument name="client" xsi:type="object">ZaloPayLaminasHttpClient</argument>
            <argument name="validator" xsi:type="object">Secomm\ZaloPay\Gateway\Validator\QueryTransactionValidator</argument>
        </arguments>
        <plugin name="generateMac" type="Secomm\ZaloPay\Plugin\Gateway\Command\QueryGenerateMac" sortOrder="10"/>
    </type>
    <virtualType name="ZaloPayQueryDataBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="query_transaction" xsi:type="string">Secomm\ZaloPay\Gateway\Request\QueryTransactionDataBuilder</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayQueryTransferFactory" type="Secomm\ZaloPay\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
            <argument name="urlPath" xsi:type="const">
                Secomm\ZaloPay\Gateway\Request\AbstractDataBuilder::QUERY_URL_PATH
            </argument>
        </arguments>
    </virtualType>
    <type name="Secomm\ZaloPay\Gateway\Request\QueryTransactionDataBuilder">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <virtualType name="ZaloPayPayUrlDataBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="zalo_app_info" xsi:type="string">Secomm\ZaloPay\Gateway\Request\ZaloAppInfoDataBuilder
                </item>
                <item name="item_details" xsi:type="string">Secomm\ZaloPay\Gateway\Request\ItemDetailsDataBuilder
                </item>
                <item name="order_additional_information" xsi:type="string">
                    Secomm\ZaloPay\Gateway\Request\OrderAdditionalInformationDataBuilder
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!--
        placeOrder guard: a ZaloPay quote may only become a Sales Order via
        the exact internal authorization opened by OrderFinalizer
        (OrderPlacementAuthorization). Registered on the concrete
        QuoteManagement (the single CartManagementInterface implementation and
        the interface preference) so the plugin compiles for frontend,
        webapi_rest, graphql and webapi_soap. Admin order creation is
        unaffected: it places orders via QuoteManagement::submit()
        (AdminOrder\Create::createOrder), which is not intercepted.
    -->
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="zalopay_place_order_guard"
                type="Secomm\ZaloPay\Plugin\Quote\CartManagementPlaceOrderGuard"
                sortOrder="10"/>
    </type>
    <type name="Secomm\ZaloPay\Plugin\Quote\CartManagementPlaceOrderGuard">
        <arguments>
            <argument name="method" xsi:type="object">ZaloPayFacade</argument>
        </arguments>
    </type>

    <!-- Payment-first services -->
    <type name="Secomm\ZaloPay\Model\PaymentAttemptManagement">
        <arguments>
            <argument name="commandPool" xsi:type="object">ZaloPayCommandPool</argument>
            <argument name="method" xsi:type="object">ZaloPayFacade</argument>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Service\OrderFinalizer">
        <arguments>
            <argument name="method" xsi:type="object">ZaloPayFacade</argument>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Service\ReturnProcessor">
        <arguments>
            <argument name="commandPool" xsi:type="object">ZaloPayCommandPool</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Service\IpnProcessor">
        <arguments>
            <!-- Authoritative v2/query fallback for callbacks that arrive
                 without a verifiable amount (corrective round 3, Blocker 4). -->
            <argument name="commandPool" xsi:type="object">ZaloPayCommandPool</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Service\PaymentRecovery">
        <arguments>
            <argument name="commandPool" xsi:type="object">ZaloPayCommandPool</argument>
        </arguments>
    </type>
    <preference for="Secomm\ZaloPay\Api\PaymentAttemptRepositoryInterface"
                type="Secomm\ZaloPay\Model\PaymentAttemptRepository"/>

    <!-- CompleteCommand/IpnCommand/UpdateOrderCommand (order-first
         verification chain) were removed with the order-first flow —
         TASK-EDS9T5: payment-first only. -->
    <type name="Secomm\ZaloPay\Gateway\Request\ZaloAppInfoDataBuilder">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Gateway\Command\RefundCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">ZaloPayRefundDataBuilder</argument>
            <argument name="transferFactory" xsi:type="object">ZaloPayRefundTransferFactory</argument>
            <argument name="client" xsi:type="object">ZaloPayLaminasHttpClient</argument>
            <argument name="handler" xsi:type="object">ZaloPayRefundResponseHandler</argument>
            <argument name="validator" xsi:type="object">Secomm\ZaloPay\Gateway\Validator\RefundValidator</argument>
        </arguments>
        <plugin name="generateMac" type="Secomm\ZaloPay\Plugin\Gateway\Command\RefundGenerateMac" sortOrder="10"/>
    </type>

    <type name="Secomm\ZaloPay\Gateway\Command\RefundQueryCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">ZaloPayRefundDataBuilder</argument>
            <argument name="transferFactory" xsi:type="object">ZaloPayRefundQueryTransferFactory</argument>
            <argument name="client" xsi:type="object">ZaloPayLaminasHttpClient</argument>
            <argument name="handler" xsi:type="object">ZaloPayRefundResponseHandler</argument>
            <argument name="validator" xsi:type="object">Secomm\ZaloPay\Gateway\Validator\RefundValidator</argument>
        </arguments>
        <plugin name="generateMac" type="Secomm\ZaloPay\Plugin\Gateway\Command\RefundQueryGenerateMac" sortOrder="10"/>
    </type>

    <virtualType name="ZaloPayRefundDataBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="refund_data" xsi:type="string">Secomm\ZaloPay\Gateway\Request\RefundDataBuilder</item>
            </argument>
        </arguments>
        <plugin name="generateMac" type="Secomm\ZaloPay\Plugin\Gateway\Command\RefundGenerateMac" sortOrder="10"/>
    </virtualType>
    <virtualType name="ZaloPayRefundTransferFactory" type="Secomm\ZaloPay\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
            <argument name="urlPath" xsi:type="const">
                Secomm\ZaloPay\Gateway\Request\AbstractDataBuilder::REFUND_URL_PATH
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayRefundQueryTransferFactory" type="Secomm\ZaloPay\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
            <argument name="urlPath" xsi:type="const">
                Secomm\ZaloPay\Gateway\Request\AbstractDataBuilder::REFUND_QUERY_URL_PATH
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ZaloPayRefundResponseHandler" type="Magento\Payment\Gateway\Response\HandlerChain">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="refund" xsi:type="string">Secomm\ZaloPay\Gateway\Response\TransactionRefundHandler</item>
                <item name="response_messages" xsi:type="string">
                    Secomm\ZaloPay\Gateway\Response\ResponseMessagesHandler
                </item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Secomm\ZaloPay\Gateway\Request\RefundDataBuilder">
        <arguments>
            <argument name="config" xsi:type="object">ZaloPayConfig</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Secomm\ZaloPay\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">Zalopay</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Secomm\ZaloPay\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <preference for="Secomm\ZaloPay\Api\Data\RefundInterface" type="Secomm\ZaloPay\Model\Data\RefundData"/>

    <!-- Plugin for TotalMinMax to handle ZaloPay currency conversion -->
    <type name="Magento\Payment\Model\Checks\TotalMinMax">
        <plugin name="zalopay_total_min_max" type="Secomm\ZaloPay\Plugin\Model\Checks\TotalMinMaxPlugin" sortOrder="10" disabled="false"/>
    </type>

    <!-- Plugin for Creditmemo to add PROCESSING state -->
    <type name="Magento\Sales\Model\Order\Creditmemo">
        <plugin name="zalopay_creditmemo_states" type="Secomm\ZaloPay\Plugin\Model\Order\CreditmemoPlugin" sortOrder="10" disabled="false"/>
    </type>
</config>
