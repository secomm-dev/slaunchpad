<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <zalopay>
                <active>0</active>
                <model>ZaloPayFacade</model>
                <order_status>pending_payment</order_status>
                <title>ZaloPay</title>
                <sandbox_flag>0</sandbox_flag>
                <!-- Payment-first: create the ZaloPay transaction from the ACTIVE
                     QUOTE (no order at redirect). 0 keeps the historical
                     order-first flow for staged rollout. -->
                <payment_first>0</payment_first>
                <!-- Attempt TTL in minutes (ZaloPay unpaid orders expire ~15min). -->
                <attempt_ttl>15</attempt_ttl>
                <allowspecific>0</allowspecific>
                <payment_action>authorize_capture</payment_action>
                <can_initialize>1</can_initialize>
                <can_authorize>0</can_authorize>
                <can_capture>1</can_capture>
                <can_void>0</can_void>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>1</can_use_internal>
                <is_gateway>1</is_gateway>
                <sort_order>99</sort_order>
                <form>zalopay_wallet</form>
                <app_id></app_id>
                <key1></key1>
                <key2></key2>
                <app_user></app_user>
                <desc>Thanh toán qua ZaloPay</desc>
            </zalopay>
        </payment>
    </default>
</config>
