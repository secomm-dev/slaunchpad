<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="zalopay" translate="label" type="text" sortOrder="99" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>ZaloPay</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1"
                       showInStore="1" canRestore="1">
                    <label>Title</label>
                </field>
                <field id="app_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>App Id</label>
                </field>
                <field id="key1" translate="label" type="obscure" sortOrder="32" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>Mac key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="key2" translate="label" type="obscure" sortOrder="33" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>Callback key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="app_user" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>App User</label>
                </field>
                <field id="desc" translate="label" type="text" sortOrder="53" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>Description</label>
                </field>
                <field id="sandbox_flag" translate="label" type="select" sortOrder="60" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Sandbox Mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="attempt_ttl" translate="label comment" type="text" sortOrder="66" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Payment Attempt TTL (minutes)</label>
                    <comment><![CDATA[Lifetime of a payment-first initiation attempt. ZaloPay unpaid orders expire after ~15 minutes; a stale attempt is never reused as a new payment.]]></comment>
                    <frontend_class>validate-number</frontend_class>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="80" showInDefault="1"
                       showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Payment from Applicable Countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="90" showInDefault="1"
                       showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Payment from Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="min_order_total" translate="label" type="text" sortOrder="100" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Minimum Order Total</label>
                    <comment><![CDATA[Currency VND.<br />
                        Minimum price/1 order:<br />
                        - ZaloPay QR Code: 1,000 VND <br />
                        - Bank: 1,000 VND <br />]]>
                    </comment>
                    <frontend_class>validate-number</frontend_class>
                </field>
                <field id="max_order_total" translate="label" type="text" sortOrder="110" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Maximum Order Total</label>
                    <comment><![CDATA[Currency VND.<br />
                        Maximum price/1 order:<br />
                        - ZaloPay QR Code: 23,000,000 VND <br />
                        - Bank: 10,000,000 VND <br />]]>
                    </comment>
                    <frontend_class>validate-number</frontend_class>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>Sort Order</label>
                    <frontend_class>validate-number</frontend_class>
                </field>
                <field id="form" translate="label" type="select" sortOrder="210" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Forms Of Payment</label>
                    <source_model>Secomm\ZaloPay\Model\Config\Source\PaymentsForm</source_model>
                    <comment>
                        <![CDATA[ Click <a href="https://docs.zalopay.vn/v2/docs/gateway/guide.html#2-1-theo-cau-truc-moi" target="_blank">here</a> for more information.]]>
                    </comment>
                </field>
            </group>
        </section>
    </system>
</config>
