<?xml version="1.0"?>
<!--
  ~ Secomm_VietNamAddress — SL-011 / FEAT-007 (DEC-019/025)
  ~ Adminhtml-scoped server-side validation of the VN 2-level ward(province) relationship
  ~ for a customer-address save. Mirrors the cart estimate plugin (etc/frontend/di.xml,
  ~ SL-003/FEAT-005). The generic dropdown cascade lives in Secomm_AddressDropdown; only
  ~ the VN-specific rule is owned here.
  -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Api\AddressRepositoryInterface">
        <plugin name="secomm_vietnam_customer_validate_ward" type="Secomm\VietNamAddress\Plugin\Customer\Address\ValidateVietNamWard" />
    </type>

    <!-- SL-013 / FEAT-007 (DEC-019/025): validate ward(province) for the VN origin saved in
         Store Information (general/store_information) and Shipping Origin (shipping/origin). -->
    <type name="Magento\Config\Model\Config">
        <plugin name="secomm_vietnam_config_validate_ward" type="Secomm\VietNamAddress\Plugin\Adminhtml\Config\ValidateVietNamWard" />
    </type>

    <!-- TASK-9EX975 Slice A (AC-003): the remaining admin surfaces get the same
         ward(province) validation — the quote save behind admin order create/edit, the
         order address edit form, and the MSI (Inventory) source form. Same non-fatal
         neutralise+log contract as the two validators above; storefront is not touched. -->
    <type name="Magento\Quote\Api\CartRepositoryInterface">
        <plugin name="secomm_vietnam_quote_validate_ward" type="Secomm\VietNamAddress\Plugin\Quote\ValidateVietNamWard" />
    </type>

    <type name="Magento\Sales\Api\OrderAddressRepositoryInterface">
        <plugin name="secomm_vietnam_order_address_validate_ward" type="Secomm\VietNamAddress\Plugin\Sales\ValidateVietNamWard" />
    </type>

    <type name="Magento\InventoryApi\Api\SourceRepositoryInterface">
        <plugin name="secomm_vietnam_source_validate_ward" type="Secomm\VietNamAddress\Plugin\Inventory\ValidateVietNamWard" />
    </type>
</config>
