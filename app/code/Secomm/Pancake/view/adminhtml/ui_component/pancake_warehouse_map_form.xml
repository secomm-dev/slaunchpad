<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pancake_warehouse_map_form.pancake_warehouse_map_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Warehouse Map</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Secomm\Pancake\Block\Adminhtml\WarehouseMap\Edit\BackButton"/>
            <button name="save" class="Secomm\Pancake\Block\Adminhtml\WarehouseMap\Edit\SaveButton"/>
        </buttons>
        <namespace>pancake_warehouse_map_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>pancake_warehouse_map_form.pancake_warehouse_map_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="pancake_warehouse_map_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="pancake/warehousemap/save"/>
        </settings>
        <dataProvider class="Secomm\Pancake\Model\WarehouseMap\FormDataProvider"
                      name="pancake_warehouse_map_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Mapping</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="magento_source_code" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Magento MSI Source</label>
                <notice translate="true">Loaded from Magento Inventory sources (Stores → Inventory → Sources), not from Pancake. This is the source Magento uses when the order is exported. One source can map to only one Pancake warehouse.</notice>
                <dataScope>magento_source_code</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Secomm\Pancake\Model\Config\Source\MagentoSources"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="external_warehouse_id" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Pancake Warehouse</label>
                <notice translate="true">Loaded live from Pancake POS GET /shops/{Shop ID}/warehouses using the API Key in Stores → Configuration → Secomm Extensions → Pancake POS. If the list is empty, set Shop ID and API Key first and confirm the key is enabled on Pancake. One warehouse can map to only one Magento source. Unmapped sources block the order push (error warehouse_unmapped).</notice>
                <dataScope>external_warehouse_id</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Secomm\Pancake\Model\Config\Source\PancakeWarehouses"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="is_active" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <notice translate="true">Only active rows are used at export. Inactive maps are ignored; the order then fails with warehouse_unmapped until another active map exists for that MSI source.</notice>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
