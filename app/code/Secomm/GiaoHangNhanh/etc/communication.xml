<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Communication/etc/communication.xsd">
    <topic name="ghn.sync.order" request="string">
        <handler name="ghnSyncOrderHandler"
                 type="Secomm\GiaoHangNhanh\Model\Queue\OrderSyncConsumer"
                 method="process"/>
    </topic>
    <topic name="ghn.cancel.order" request="string">
        <handler name="ghnCancelOrderHandler"
                 type="Secomm\GiaoHangNhanh\Model\Queue\OrderCancelConsumer"
                 method="process"/>
    </topic>
</config>
