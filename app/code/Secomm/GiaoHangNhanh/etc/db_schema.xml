<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ghn_webhook_track" resource="default" engine="innodb" comment="Track">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity Id Column"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" identity="false"
                comment="Order Id Column"/>
        <column xsi:type="varchar" name="tracking_code" nullable="false" length="255" comment="Order Code GHN Column"/>
        <column xsi:type="varchar" name="status_code" nullable="false" length="255" comment="Status Code Column"/>
        <column xsi:type="varchar" name="status_label" nullable="false" length="255" comment="Status Label Column"/>
        <column xsi:type="text" name="warehouse" nullable="false" comment="Warehouse Column"/>
        <column xsi:type="decimal" name="total_fee" precision="20" scale="2" unsigned="true" nullable="false"
                comment="Total Fee Column"/>
        <column xsi:type="int" name="shop_id" padding="10" unsigned="true" nullable="false" identity="false"
                comment="Shop Id Column"/>
        <column xsi:type="text" name="request" nullable="false" comment="Request Column"/>
        <column xsi:type="int" name="result_code" padding="10" unsigned="true" nullable="false" identity="false"
                comment="Result Code Column"/>
        <column xsi:type="varchar" name="result_label" nullable="false" length="255" comment="Result Label Column"/>
        <column xsi:type="text" name="additional_data" nullable="false"
                comment="Additional Data Column"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TRACK_ORDER_ID_SALES_ORDER_ENTITY_ID" table="ghn_webhook_track"
                    column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE" />
        <index referenceId="GHN_WEBHOOK_TRACK_ENTITY_ID" indexType="btree">
            <column name="entity_id"/>
        </index>
    </table>
    <table name="secomm_giaohangnhanh_province" resource="default" engine="innodb"
           comment="GHN Province">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="province_id" unsigned="true" nullable="false" comment="Province ID from GHN"/>
        <column xsi:type="varchar" name="country_id" nullable="false" length="10" comment="Country ID"/>
        <column xsi:type="varchar" name="code" nullable="true" length="32" comment="Province Code"/>
        <column xsi:type="varchar" name="province_name" nullable="false" length="255" comment="Province Name"/>
        <column xsi:type="int" name="region_id_mapping" unsigned="true" nullable="true" comment="Region ID Mapping"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GHN_PROVINCE_PROVINCE_ID">
            <column name="province_id"/>
        </constraint>
    </table>
    <table name="secomm_giaohangnhanh_district" resource="default" engine="innodb"
           comment="Boolfly giao hang nhanh district table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="district_id" unsigned="true" nullable="false" padding="11" comment="District Id"/>
        <column xsi:type="int" name="province_id" unsigned="true" nullable="false" padding="11" comment="Province Id"/>
        <column xsi:type="varchar" name="district_name" nullable="false" length="255" comment="District Name"/>
        <constraint xsi:type="foreign" referenceId="GHN_DISTRICT_PROVINCE_ID_GHN_PROVINCE_ENTT_ID" table="secomm_giaohangnhanh_district"
            column="province_id" referenceTable="secomm_giaohangnhanh_province" referenceColumn="province_id" onDelete="CASCADE" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="sales_order" resource="sales" engine="innodb">
        <column xsi:type="varchar" name="ghn_status" nullable="true" length="50" default=""
                comment="Giaohangnhanh status"/>
        <column xsi:type="varchar" name="tracking_code" nullable="true" length="255" comment="Tracking Code"/>
        <column xsi:type="smallint" name="ghn_canceling_status" nullable="true" default="0" unsigned="false" identity="false"
                comment="Giaohangnhanh canceling status"/>
    </table>
    <table name="quote_address" resource="checkout" engine="innodb">
        <column xsi:type="varchar" name="district" nullable="true" length="11" comment="District"/>
        <column xsi:type="varchar" name="shipping_service_id" nullable="true" length="11" comment="Shipping Service ID"/>
        <column xsi:type="varchar" name="shipping_service_type_id" nullable="true" length="11" comment="Shipping Service Type ID"/>
    </table>
    <table name="sales_order_grid" resource="sales" engine="innodb">
        <column xsi:type="varchar" name="ghn_status" nullable="true" length="50" default=""
                comment="Giaohangnhanh status"/>
        <column xsi:type="varchar" name="tracking_code" nullable="true" length="255" comment="Tracking Code"/>
        <column xsi:type="smallint" name="ghn_canceling_status" nullable="true" default="0" unsigned="false" identity="false"
                comment="Giaohangnhanh canceling status"/>
    </table>
    <table name="secomm_giaohangnhanh_ward" resource="default" engine="innodb"
           comment="Giaohangnhanh ward table">
        <column xsi:type="int" name="entity_id" padding="11" unsigned="false" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="ward_code" unsigned="true" nullable="false" padding="11" comment="Ward Code"/>
        <column xsi:type="int" name="district_id" unsigned="true" nullable="false" identity="false"
            default="0" comment="District ID"/>
        <column xsi:type="varchar" name="ward_name" nullable="false" length="255" comment="Ward Name"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GHN_WARD_DISTRICT_ID_GHN_DISTRICT_ENTT_ID" table="secomm_giaohangnhanh_ward"
            column="district_id" referenceTable="secomm_giaohangnhanh_district" referenceColumn="entity_id" onDelete="CASCADE" />
        <index referenceId="GHN_WARD_DISTRICT_ID" indexType="btree">
            <column name="district_id"/>
        </index>
    </table>
</schema>
