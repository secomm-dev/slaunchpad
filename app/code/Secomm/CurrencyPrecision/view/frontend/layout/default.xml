<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Wrap hyva.formatPrice right after Hyvä defines it (head.hyva-scripts
             renders vendor page/js/hyva.phtml in the same container) — before
             Alpine init, so every dynamic price goes through the wrapper. -->
        <referenceContainer name="head.additional">
            <block class="Secomm\CurrencyPrecision\Block\CurrencyPrecision"
                   name="secomm.currency-precision"
                   template="Secomm_CurrencyPrecision::currency_precision.phtml"
                   after="head.hyva-scripts"/>
        </referenceContainer>
    </body>
</page>
