<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <!-- FEAT-008 / DEC-FEAT008-001: Maximum Discount Cap for by_percent Sales Rules.
         Magento SalesRule stays the execution engine — this module only caps + redistributes. -->
    <module name="Secomm_PromotionMaxDiscount">
        <sequence>
            <module name="Secomm_Promotion"/>
            <module name="Magento_SalesRule"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
        </sequence>
    </module>
</config>
