<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <!-- TASK-YPWH9B / SPEC-TASK-YPWH9B (LC-26): COD Blacklist & Basic Risk Control.
         Risk domain owner: rules, phone risk identity, risk events, admin surface,
         plus the COD availability plugin on Magento default CashOnDelivery
         (single-module decision 2026-09-21 — former Secomm_Cod skeleton merged in).
         Does NOT own the COD payment method logic — only availability asks CodRisk
         via CodRiskEvaluatorInterface (AD-01). -->
    <module name="Secomm_CodRisk">
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Config"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Ui"/>
            <module name="Magento_Payment"/>
            <module name="Magento_OfflinePayments"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
        </sequence>
    </module>
</config>