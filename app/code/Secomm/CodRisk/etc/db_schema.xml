<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- TASK-YPWH9B / SPEC-TASK-YPWH9B — additive only. Rollback: DROP the 5 tables below. -->
    <table name="secomm_cod_risk_list" resource="default" engine="innodb" comment="COD Risk Phone List (Blacklist/Allowlist)">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="varchar" name="normalized_phone" nullable="false" length="20" comment="Normalized Phone (E.164 VN)"/>
        <column xsi:type="varchar" name="list_type" nullable="false" length="10" comment="List Type: ALLOW | BLOCK"/>
        <column xsi:type="int" name="website_id" padding="10" unsigned="true" nullable="false" default="0" comment="Website Id (0 = all websites)"/>
        <column xsi:type="varchar" name="reason" nullable="true" length="64" comment="Reason Code"/>
        <column xsi:type="text" name="note" nullable="true" comment="Note"/>
        <column xsi:type="varchar" name="source" nullable="false" length="16" default="ADMIN" comment="Source: ADMIN | IMPORT | ORDER"/>
        <column xsi:type="date" name="effective_from" nullable="true" comment="Effective From"/>
        <column xsi:type="date" name="effective_to" nullable="true" comment="Effective To (null = indefinite)"/>
        <column xsi:type="smallint" name="is_active" padding="5" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="varchar" name="created_by" nullable="true" length="40" comment="Created By (admin username)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CODRISK_LIST_PHONE_SITE_ACTIVE" indexType="btree">
            <column name="normalized_phone"/>
            <column name="website_id"/>
            <column name="is_active"/>
        </index>
    </table>

    <table name="secomm_cod_risk_event" resource="default" engine="innodb" comment="COD Risk Event (normalized)">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="varchar" name="normalized_phone" nullable="false" length="20" comment="Normalized Phone (E.164 VN)"/>
        <column xsi:type="int" name="website_id" padding="10" unsigned="true" nullable="false" default="0" comment="Website Id"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" comment="Order Id"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="true" comment="Quote Id"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="true" comment="Customer Id"/>
        <column xsi:type="varchar" name="reason_code" nullable="false" length="64" comment="Internal Business Reason Code"/>
        <column xsi:type="varchar" name="source" nullable="false" length="16" comment="Source: CUSTOMER | ADMIN | SYSTEM | CARRIER | IMPORT"/>
        <column xsi:type="smallint" name="include_snapshot" padding="5" unsigned="true" nullable="false" default="0" comment="Include In Historical Count (snapshot at record time)"/>
        <column xsi:type="text" name="note" nullable="true" comment="Note"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CODRISK_EVENT_PHONE_SITE_DATE" indexType="btree">
            <column name="normalized_phone"/>
            <column name="website_id"/>
            <column name="created_at"/>
        </index>
    </table>

    <table name="secomm_cod_risk_evaluation" resource="default" engine="innodb" comment="COD Risk Evaluation Log (WARNING/BLOCK only)">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="varchar" name="normalized_phone" nullable="false" length="20" comment="Normalized Phone (E.164 VN)"/>
        <column xsi:type="int" name="website_id" padding="10" unsigned="true" nullable="false" default="0" comment="Website Id"/>
        <column xsi:type="varchar" name="decision" nullable="false" length="10" comment="Decision: WARNING | BLOCK"/>
        <column xsi:type="varchar" name="matched_rule" nullable="true" length="32" comment="Matched Rule Code"/>
        <column xsi:type="varchar" name="reason_code" nullable="true" length="64" comment="Reason Code"/>
        <column xsi:type="int" name="historical_count" padding="10" unsigned="true" nullable="false" default="0" comment="Historical Count At Evaluation"/>
        <column xsi:type="smallint" name="spam_matched" padding="5" unsigned="true" nullable="false" default="0" comment="Spam Matched"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" comment="Order Id"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="true" comment="Quote Id"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CODRISK_EVAL_PHONE_SITE_DATE" indexType="btree">
            <column name="normalized_phone"/>
            <column name="website_id"/>
            <column name="created_at"/>
        </index>
    </table>

    <table name="secomm_cod_risk_override" resource="default" engine="innodb" comment="COD Risk Manual Override (per order)">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Order Id"/>
        <column xsi:type="varchar" name="normalized_phone" nullable="false" length="20" comment="Normalized Phone (E.164 VN)"/>
        <column xsi:type="int" name="website_id" padding="10" unsigned="true" nullable="false" default="0" comment="Website Id"/>
        <column xsi:type="varchar" name="base_decision" nullable="false" length="10" comment="Base Decision"/>
        <column xsi:type="varchar" name="override_decision" nullable="false" length="10" comment="Override Decision"/>
        <column xsi:type="varchar" name="reason" nullable="false" length="64" comment="Override Reason (required)"/>
        <column xsi:type="text" name="note" nullable="true" comment="Note"/>
        <column xsi:type="varchar" name="admin_username" nullable="false" length="40" comment="Admin Username"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CODRISK_OVERRIDE_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="CODRISK_OVERRIDE_PHONE" indexType="btree">
            <column name="normalized_phone"/>
        </index>
    </table>

    <table name="secomm_cod_risk_audit" resource="default" engine="innodb" comment="COD Risk Audit Log">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="Entity Type: list | event | override | config"/>
        <column xsi:type="int" name="entity_id_ref" padding="10" unsigned="true" nullable="true" comment="Referenced Entity Id"/>
        <column xsi:type="varchar" name="action" nullable="false" length="32" comment="Action: created | updated | deactivated | activated | recorded | overridden | config_changed"/>
        <column xsi:type="text" name="old_value" nullable="true" comment="Old Value (summary)"/>
        <column xsi:type="text" name="new_value" nullable="true" comment="New Value (summary)"/>
        <column xsi:type="varchar" name="admin_username" nullable="true" length="40" comment="Admin Username"/>
        <column xsi:type="varchar" name="note" nullable="true" length="255" comment="Note"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CODRISK_AUDIT_ENTITY" indexType="btree">
            <column name="entity_type"/>
            <column name="entity_id_ref"/>
        </index>
    </table>
</schema>