        <add id="Secomm_CodRisk::events" title="Risk Events" module="Secomm_CodRisk"
             sortOrder="30" parent="Secomm_CodRisk::parent"
             action="codrisk/events/index" resource="Secomm_CodRisk::manage"/>
        <add id="Secomm_CodRisk::evaluations" title="Evaluations" module="Secomm_CodRisk"
             sortOrder="40" parent="Secomm_CodRisk::parent"
             action="codrisk/evaluations/index" resource="Secomm_CodRisk::manage"/>
        <add id="Secomm_CodRisk::audit" title="Audit Log" module="Secomm_CodRisk"
             sortOrder="50" parent="Secomm_CodRisk::parent"
