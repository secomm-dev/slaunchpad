/** @var \Secomm\CodRisk\Block\Adminhtml\Lists\Form $block */
/** @var \Magento\Framework\Escaper $escaper */
$record = $block->getRecord();
$phoneNumber = $record !== null ? (string)$record->getData('normalized_phone') : '';
$listType = $record !== null ? (string)$record->getData('list_type') : 'BLOCK';
$reason = $record !== null ? (string)$record->getData('reason') : '';
$note = $record !== null ? (string)$record->getData('note') : '';
$websiteId = $record !== null ? (string)(int)($record->getData('website_id') ?? 0) : '0';
$isActive = $record !== null ? (int)($record->getData('is_active') ?? 1) : 1;
// Timestamps are stored UTC (Magento convention); the calendar edits local time.
$effectiveFrom = $record !== null
    ? $block->formatEffective((string)($record->getData('effective_from') ?? ''), (int)$websiteId)
    : '';
$effectiveTo = $record !== null
    ? $block->formatEffective((string)($record->getData('effective_to') ?? ''), (int)$websiteId)
    : '';
?>
