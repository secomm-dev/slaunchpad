            </label>
            <div class="admin__field-control control">
                <select class="select admin__control-select" id="list_type" name="list_type" required>
                    <?php foreach ($block->getListTypeOptions() as $option): ?>
                        <option value="<?= $escaper->escapeHtml((string)$option['value']) ?>"
                            <?= $option['value'] === $listType ? 'selected' : '' ?>>
                            <?= $escaper->escapeHtml((string)$option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div class="admin__field">
            <label class="label admin__field-label" for="website_id">
                <span><?= $escaper->escapeHtml(__('Website')) ?></span>
            </label>
            <div class="admin__field-control control">
                <select class="select admin__control-select" id="website_id" name="website_id">
                    <?php foreach ($block->getWebsiteOptions() as $option): ?>
                        <option value="<?= $escaper->escapeHtml((string)$option['value']) ?>"
                            <?= $option['value'] === $websiteId ? 'selected' : '' ?>>
                            <?= $escaper->escapeHtml((string)$option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div class="admin__field">
            <label class="label admin__field-label" for="reason">
                <span><?= $escaper->escapeHtml(__('Reason')) ?></span>
            </label>
            <div class="admin__field-control control">
                <select class="select admin__control-select" id="reason" name="reason">
                    <option value="">—</option>
                    <?php foreach ($block->getReasonOptions() as $option): ?>
                        <option value="<?= $escaper->escapeHtml((string)$option['value']) ?>"
                            <?= $option['value'] === $reason ? 'selected' : '' ?>>
                            <?= $escaper->escapeHtml((string)$option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div class="admin__field">
            <label class="label admin__field-label" for="is_active">
                <span><?= $escaper->escapeHtml(__('Status')) ?></span>
            </label>
            <div class="admin__field-control control">
                <select class="select admin__control-select" id="is_active" name="is_active">
                    <?php foreach ($block->getStatusOptions() as $option): ?>
                        <option value="<?= $escaper->escapeHtml((string)$option['value']) ?>"
                            <?= (string)$isActive === (string)$option['value'] ? 'selected' : '' ?>>
                            <?= $escaper->escapeHtml((string)$option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
                <div class="note"><?= $escaper->escapeHtml(__('Inactive = the record stays in the list but does not affect evaluation.')) ?></div>
            </div>
        </div>
        <div class="admin__field">
            <label class="label admin__field-label" for="effective_from">
                <span><?= $escaper->escapeHtml(__('Effective From')) ?></span>
            </label>
            <div class="admin__field-control control">
                <input class="input-text admin__control-text" type="text" id="effective_from"
                       name="effective_from" value="<?= $escaper->escapeHtml($effectiveFrom) ?>"
                       data-mage-init='{"mage/calendar": {"showsTime": true, "dateFormat": "yy-mm-dd", "timeFormat": "HH:mm"}}'/>
            </div>
        </div>
        <div class="admin__field">
            <label class="label admin__field-label" for="effective_to">
                <span><?= $escaper->escapeHtml(__('Effective To')) ?></span>
