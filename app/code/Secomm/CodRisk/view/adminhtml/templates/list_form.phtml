            <div class="admin__field-control control">
                <input class="input-text admin__control-text" type="text" id="effective_to"
                       name="effective_to" value="<?= $escaper->escapeHtml($effectiveTo) ?>"
                       data-mage-init='{"mage/calendar": {"showsTime": true, "dateFormat": "yy-mm-dd", "timeFormat": "HH:mm"}}'/>
                <div class="note"><?= $escaper->escapeHtml(__('Leave empty = block/allow indefinitely.')) ?></div>
            </div>
        </div>
        <div class="admin__field">
            <label class="label admin__field-label" for="note">
                <span><?= $escaper->escapeHtml(__('Note')) ?></span>
            </label>
            <div class="admin__field-control control">
                <textarea class="textarea admin__control-textarea" id="note" name="note"
                          rows="3"><?= $escaper->escapeHtml($note) ?></textarea>
            </div>
        </div>
    </fieldset>
</form>


