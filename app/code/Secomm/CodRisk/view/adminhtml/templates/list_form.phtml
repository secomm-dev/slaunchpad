    <div class="codrisk-list-actions">
        <button class="action-default scalable back" type="button"
                onclick="setLocation('<?= $escaper->escapeJs($block->getBackUrl()) ?>'); return false;">
            <?= $escaper->escapeHtml(__('Back')) ?>
        </button>
        <button class="action-default scalable primary save" type="submit">
            <?= $escaper->escapeHtml(__('Save')) ?>
        </button>
    </div>
    <?= $block->getBlockHtml('formkey') ?>
    <fieldset class="admin__fieldset">
        <div class="admin__field">
            <label class="label admin__field-label" for="raw_phone">
                <span><?= $escaper->escapeHtml(__('Phone (any format)')) ?> <em>*</em></span>
            </label>
            <div class="admin__field-control control">
                <input class="input-text admin__control-text" type="text" id="raw_phone" name="raw_phone"
                       value="<?= $escaper->escapeHtml($phoneNumber) ?>"
                       placeholder="0901 234 567 / 84901234567 / +84 901 234 567" required/>
                <div class="note"><?= $escaper->escapeHtml(__('The number is normalized to +84 format on save.')) ?></div>
            </div>
        </div>
        <div class="admin__field">
