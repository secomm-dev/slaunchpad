<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codrisk_evaluations_listing.codrisk_evaluations_listing_data_source</item>
            <item name="deps" xsi:type="string">codrisk_evaluations_listing.codrisk_evaluations_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">codrisk_evaluations_columns</item>
    </argument>
    <dataSource name="codrisk_evaluations_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Secomm_CodRisk::manage</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="codrisk_evaluations_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_toolbar">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="codrisk_evaluations_columns">
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Time</label>
            </settings>
        </column>
        <column name="normalized_phone">
            <settings>
                <filter>text</filter>
                <label translate="true">Phone</label>
            </settings>
        </column>
        <column name="decision">
            <settings>
                <filter>select</filter>
                <label translate="true">Decision</label>
                <options class="Secomm\CodRisk\Model\Source\Decisions"/>
            </settings>
        </column>
        <column name="matched_rule">
            <settings>
                <filter>text</filter>
                <label translate="true">Matched Source</label>
            </settings>
        </column>
        <column name="historical_count">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Historical Count</label>
            </settings>
        </column>
        <column name="spam_matched" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <label translate="true">Spam Match</label>
                <options class="Secomm\CodRisk\Model\Source\YesNo"/>
                <dataType>text</dataType>
            </settings>
        </column>
    </columns>
</listing>
