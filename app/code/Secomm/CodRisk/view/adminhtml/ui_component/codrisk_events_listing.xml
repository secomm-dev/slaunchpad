<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codrisk_events_listing.codrisk_events_listing_data_source</item>
            <item name="deps" xsi:type="string">codrisk_events_listing.codrisk_events_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">codrisk_events_columns</item>
    </argument>
    <dataSource name="codrisk_events_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Secomm_CodRisk::manage</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="codrisk_events_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_toolbar">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="codrisk_events_columns">
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
            </settings>
        </column>
        <column name="normalized_phone">
            <settings>
                <filter>text</filter>
                <label translate="true">Phone</label>
            </settings>
        </column>
        <column name="reason_code" class="Secomm\CodRisk\Ui\Component\Listing\Columns\ReasonLabel">
            <settings>
                <filter>select</filter>
                <options class="Secomm\CodRisk\Model\Source\ReasonCodes"/>
                <dataType>select</dataType>
                <label translate="true">Reason</label>
            </settings>
        </column>
        <column name="source">
            <settings>
                <filter>text</filter>
                <label translate="true">Source</label>
            </settings>
        </column>
        <column name="order_id" class="Secomm\CodRisk\Ui\Component\Listing\Columns\OrderIncrement">
            <settings>
                <filter>text</filter>
                <label translate="true">Order</label>
            </settings>
        </column>
        <column name="website_id" class="Secomm\CodRisk\Ui\Component\Listing\Columns\WebsiteName">
            <settings>
                <filter>select</filter>
                <options class="Secomm\CodRisk\Model\Source\Websites"/>
                <label translate="true">Website</label>
                            <dataType>select</dataType>
            </settings>
        </column>
        <column name="note">
            <settings>
                <label translate="true">Note</label>
            </settings>
        </column>
    </columns>
</listing>
