<?xml version="1.0" ?>
<!--/**-->
<!-- * Module AddressDropdown of Secomm package-->
<!-- * @package Secomm_AddressDropdown-->
<!-- * @author Bao Le-->
<!-- * @date 2024-->
<!-- */-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
	<module name="Secomm_AddressDropdown">
		<sequence>
			<module name="Magento_Customer"/>
			<module name="Magento_Checkout"/>
			<module name="Magento_Sales"/>
			<module name="Magento_ImportExport"/>
			<!-- SL-013: load after core config owners so our system.xml frontend_model override
			     of general/store_information/city + shipping/origin/city merges deterministically. -->
			<module name="Magento_Backend"/>
			<module name="Magento_Shipping"/>
		</sequence>
	</module>
</config>
