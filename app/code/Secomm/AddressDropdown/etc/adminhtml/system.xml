<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="address" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Address Dropdown</label>
            <tab>secomm</tab>
            <resource>Secomm_AddressDropdown::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Configuration</label>
                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>

        <!-- SL-013 / FEAT-007 (DEC-019/025): override the core config `city` field on the two
             admin origin surfaces with a dependent-ward dropdown renderer (frontend_model).
             Minimal id-based override: Magento merges the frontend_model child onto the
             existing core field, keeping core type/label/sortOrder. Generic, country-agnostic;
             VN behaviour/label/validate is owned by Secomm_VietNamAddress. -->
        <section id="general">
            <group id="store_information">
                <field id="city">
                    <frontend_model>Secomm\AddressDropdown\Block\Adminhtml\System\Config\Field\City</frontend_model>
                </field>
            </group>
        </section>
        <section id="shipping">
            <group id="origin">
                <field id="city">
                    <frontend_model>Secomm\AddressDropdown\Block\Adminhtml\System\Config\Field\City</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
