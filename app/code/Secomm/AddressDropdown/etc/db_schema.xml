<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="sales_order_address">
        <column name="sub_city" nullable="true" xsi:type="varchar" length="256" comment="Sub city"/>
    </table>
    <table name="quote_address">
        <column name="sub_city" nullable="true" xsi:type="varchar" length="256" comment="Sub city"/>
    </table>
    <table name="customer_address_entity">
        <column name="sub_city" nullable="true" xsi:type="varchar" length="256" comment="Sub city"/>
    </table>

    <table name="directory_region_city" resource="default" engine="innodb" comment="City">
        <column xsi:type="int" name="city_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="City Id Column"/>
        <column xsi:type="int" name="region_id" padding="10" unsigned="true" nullable="false" identity="false"
                comment="Region Id Column"/>
        <column xsi:type="varchar" name="default_name" nullable="false" length="255" comment="Default Name Column"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="city_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="DIRECTORY_REGION_CITY_REGION_ID_DIRECTORY_COUNTRY_REGION_REGION_ID"
                    table="directory_region_city" column="region_id" referenceTable="directory_country_region"
                    referenceColumn="region_id" onDelete="CASCADE"/>
        <index referenceId="DIRECTORY_REGION_CITY_CITY_ID" indexType="btree">
            <column name="city_id"/>
        </index>
    </table>
    <table name="directory_region_city_name" resource="default" engine="innodb" comment="CityName">
        <column xsi:type="int" name="city_id" padding="10" unsigned="true" nullable="false" identity="false"
                comment="City Id Column"/>
        <column xsi:type="varchar" name="locale" nullable="false" length="255" comment="Locale Column"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name Column"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="city_id"/>
            <column name="locale"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="DIRECTORY_REGION_CITY_NAME_CITY_NAME_DIRECTORY_REGION_CITY_CITY_NAME"
                    table="directory_region_city_name" column="city_id" referenceTable="directory_region_city"
                    referenceColumn="city_id" onDelete="CASCADE"/>
        <index referenceId="DIRECTORY_REGION_CITY_NAME_CITY_ID" indexType="btree">
            <column name="city_id"/>
        </index>
    </table>

    <table name="directory_city_sub_city" resource="default" engine="innodb" comment="SubCity">
        <column xsi:type="int" name="sub_city_id" unsigned="true" nullable="false" identity="true"
                comment="Sub City Id Column"/>
        <column xsi:type="int" name="city_id" padding="10" unsigned="true" nullable="false" identity="false"
                comment="City Id Column"/>
        <column xsi:type="varchar" name="default_name" nullable="false" length="255" comment="Default Name Column"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="sub_city_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="DIRECTORY_REGION_SUB_CITY_CITY_ID_DIRECTORY_REGION_CITY_CITY_NAME"
                    table="directory_city_sub_city" column="city_id" referenceTable="directory_region_city"
                    referenceColumn="city_id" onDelete="CASCADE"/>
        <index referenceId="DIRECTORY_CITY_SUB_CITY_SUB_CITY_ID" indexType="btree">
            <column name="sub_city_id"/>
        </index>
    </table>
    <table name="directory_city_sub_city_name" resource="default" engine="innodb" comment="SubCityName">
        <column xsi:type="int" name="sub_city_id" unsigned="true" nullable="false" identity="false"
                comment="Sub City Id Column"/>
        <column xsi:type="varchar" name="locale" nullable="false" length="16" comment="Locale"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name Column"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="sub_city_id"/>
            <column name="locale"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="DIRECTORY_REGION_SUB_CITY_NAME_SUB_CITY_NAME_DIRECTORY_REGION_SUBCITY_SUB_CITY_NAME"
                    table="directory_city_sub_city_name" column="sub_city_id" referenceTable="directory_city_sub_city"
                    referenceColumn="sub_city_id" onDelete="CASCADE"/>
        <index referenceId="DIRECTORY_CITY_SUB_CITY_NAME_SUB_CITY_ID" indexType="btree">
            <column name="sub_city_id"/>
        </index>
    </table>

    <table name="directory_country_region" resource="default" engine="innodb" comment="Directory Country Region">
        <column xsi:type="boolean" name="is_default" nullable="false" default="1" comment="Default Data"/>
    </table>
</schema>
