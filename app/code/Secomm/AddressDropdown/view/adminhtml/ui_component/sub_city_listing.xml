<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">sub_city_listing.sub_city_listing_data_source</item>
            <item name="deps" xsi:type="string">sub_city_listing.sub_city_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Secomm\AddressDropdown\Block\Form\SubCity\BackListing"/>
            <button name="add" class="Secomm\AddressDropdown\Block\Form\SubCity\AddNew"/>
        </buttons>
        <spinner>sub_city_listing_columns</spinner>
        <deps>
            <dep>sub_city_listing.sub_city_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="sub_city_listing_data_source" component="Secomm_AddressDropdown/js/grid/custom-provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">sub_city_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Secomm_AddressDropdown::management</aclResource>
        <dataProvider class="Secomm\AddressDropdown\Ui\DataProvider\SubCityDataProvider"
                      name="sub_city_listing_data_source">
            <settings>
                <requestFieldName>sub_city_id</requestFieldName>
                <primaryFieldName>sub_city_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
<!--        <massaction name="listing_massaction">-->
<!--            <action name="delete">-->
<!--                <settings>-->
<!--                    <confirm>-->
<!--                        <message translate="true">Are you sure you want to delete selected items?</message>-->
<!--                        <title translate="true">Delete items</title>-->
<!--                    </confirm>-->
<!--                    <url path="*/*/massDelete"/>-->
<!--                    <type>delete</type>-->
<!--                    <label translate="true">Delete</label>-->
<!--                </settings>-->
<!--            </action>-->
<!--        </massaction>-->
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="sub_city_listing_columns">
<!--        <selectionsColumn name="ids" sortOrder="0">-->
<!--            <settings>-->
<!--                <indexField>sub_city_id</indexField>-->
<!--            </settings>-->
<!--        </selectionsColumn>-->
        <column name="sub_city_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="city_id">
            <settings>
                <filter>false</filter>
                <sorting>false</sorting>
                <label translate="true">City Id</label>
            </settings>
        </column>
        <column name="default_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Default Name</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Secomm\AddressDropdown\Ui\Component\Listing\Column\SubCityBlockActions">
            <settings>
                <indexField>sub_city_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
