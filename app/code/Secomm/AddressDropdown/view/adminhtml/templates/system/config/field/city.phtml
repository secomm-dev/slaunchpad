<?php
/**
 * SL-013 / FEAT-007 (DEC-019/025): config `city` field markup for the generic dependent
 * dropdown. The native input (rendered by the element) is the config value carrier; the
 * city_select is populated by the cascade JS. The extra select is hidden until the JS
 * has city data for the chosen country/region.
 *
 * TASK-9EX975 Slice A: the select span hosts the schema-driven cascade — the JS injects
 * the deeper level selects next to the level-0 select, so the markup is level-agnostic.
 *
 * @var \Secomm\AddressDropdown\Block\Adminhtml\System\Config\Field\City $block
 * @var \Magento\Framework\Data\Form\Element\AbstractElement $element
 * @var \Magento\Framework\Escaper $escaper
 */

$element = $block->getElement();
$cityInputId = $block->getData('city_input_id');
$citySelectId = $block->getData('city_select_id');

$initConfig = [
    'cityInputId' => $cityInputId,
    'citySelectId' => $citySelectId,
    'currentCity' => (string) $block->getData('current_city'),
];

$initJson = json_encode(
    ['Secomm_AddressDropdown/js/config/address-city' => $initConfig],
    JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_TAG | JSON_HEX_AMP
);
?>
<div class="secomm-config-address-city"
     data-mage-init='<?= /* @noEscape */ $initJson ?>'>
    <span class="secomm-config-city-input" style="display: inline-block">
        <?= /* @noEscape */ $element->getElementHtml() ?>
    </span>
    <span class="secomm-config-city-select" style="display: none">
        <select id="<?= $escaper->escapeHtmlAttr($citySelectId) ?>"
                class="secomm-config-city-select-el"
                data-secomm-city-select="1"
                autocomplete="off">
            <option value=""><?= $escaper->escapeHtml(__('Please select a city')) ?></option>
        </select>
    </span>
</div>
