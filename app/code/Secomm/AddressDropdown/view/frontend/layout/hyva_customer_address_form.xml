<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            SL-001 dual-theme (HYVA): overrides the customer address form with the
            Hyva-native template (Alpine.js + GraphQL cascade, Tailwind).
            This handle is auto-added by Hyva\Theme (`AddLayoutHandles` observer)
            ONLY on Hyva storefronts, and loads AFTER `customer_address_form` —
            so this setTemplate wins on Hyva. On Luma this file never loads.
            `ifconfig` gates on address/general/enable.
        -->
        <referenceBlock name="customer_address_edit">
            <action method="setTemplate" ifconfig="address/general/enable">
                <argument name="template" xsi:type="string">Secomm_AddressDropdown::hyva/address/edit.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
