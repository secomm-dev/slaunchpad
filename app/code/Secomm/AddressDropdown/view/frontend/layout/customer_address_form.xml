<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Secomm_AddressDropdown::css/styles.css"/>
    </head>
    <body>
        <!--
            SL-001 dual-theme (LUMA): set the customer address form to the Luma template
            (jQuery + requirejs `directoryAddressDropdownUpdater` cascade).
            Hyva themes also load this handle, but `hyva_customer_address_form.xml`
            overrides the template to hyva/address/edit.phtml (loaded after, wins).
            `ifconfig` gates on the module enable flag (address/general/enable).
        -->
        <referenceBlock name="customer_address_edit">
            <action method="setTemplate" ifconfig="address/general/enable">
                <argument name="template" xsi:type="string">Secomm_AddressDropdown::address/edit.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
