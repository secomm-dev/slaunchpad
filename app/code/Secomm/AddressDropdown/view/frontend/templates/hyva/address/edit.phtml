<script>
function initCustomerAddressEdit() {
    return {
        directoryData: {},
        availableRegions: {},
        messageTime: 5000,
        fieldsNames: [],
        selectedRegion: '<?= $escaper->escapeJs($block->getRegion() ?: 0) ?>',
        isZipRequired: true,
        isRegionRequired: true,
        showOptionalRegions: <?= $showOptionalRegions ? 'true' : 'false' ?>,

        // VN hierarchical dropdown state (SL-001) — city + sub_city via GraphQL.
        selectedCity: '<?= $escaper->escapeJs($cityInitial) ?>',
        selectedSubCity: '<?= $escaper->escapeJs($subCityInitial) ?>',
        cities: [],
        subCities: [],
        isLoadingCities: false,
        isLoadingSubCities: false,

        async onPrivateContentLoaded(data) {
            this.directoryData = data['directory-data'] || {};

            <?php if ($block->getCountryId()): ?>
                this.setCountry(this.$refs['country_id'], '<?= $escaper->escapeJs($block->getRegion()) ?>');

                // Pre-fill VN cascade for an existing address (edit mode).
                const initialRegionId = this.selectedRegion;
                if (initialRegionId && initialRegionId !== '0') {
                    await this.populateCities(initialRegionId);
                    if (this.selectedCity) {
                        await this.populateSubCities(this.selectedCity, initialRegionId);
                    }
                }
            <?php endif; ?>
        },
        setRegionInputValue(regionName) {
            this.$nextTick(() => {
                const regionInputElement = this.$refs['region'];
                if (regionInputElement) {
                    regionInputElement.value = regionName;
                }
            })
        },
        setCountry(countrySelectElement, initialRegion) {
            const selectedOption = countrySelectElement.options[countrySelectElement.selectedIndex];
            const countryCode = countrySelectElement.value;
            const countryData = this.directoryData[countryCode] || false;

            if (!countryData) {
                this.setRegionInputValue('');
                return;
            }

            this.isZipRequired = selectedOption.dataset.isZipRequired === '1';
            this.isRegionRequired = selectedOption.dataset.isRegionRequired === '1';

            this.availableRegions = countryData.regions || {};

            const initialRegionId = Object.keys(this.availableRegions).filter(regionId => this.availableRegions[regionId].name === initialRegion)[0];
            this.selectedRegion = initialRegionId || '0';
            this.setRegionInputValue(initialRegionId && this.availableRegions[initialRegionId].name || '');

        },
        changeCountry(event, initialRegion) {
            this.setCountry(event.target, initialRegion);
            this.validateCountryDependentFields();
            // Country change resets the VN cascade.
            this.resetVnCascade();
            this.onChange(event);
        },
        validateCountryDependentFields() {
            this.$nextTick(() => {
                this.fields['postcode'] && this.removeMessages(this.fields['postcode'])
                this.fields['region'] && this.removeMessages(this.fields['region'])
                delete this.fields['postcode'];
                delete this.fields['region'];
                this.setupField(this.$refs['country_id']);
                this.setupField(this.$refs['postcode']);
                this.setupField(this.$refs['region']);
                this.setupField(this.$refs['region_id']);

                this.fields['postcode'] && this.validateField(this.fields['postcode']);
                this.fields['region'] && this.validateField(this.fields['region']);
                this.fields['region_id'] && this.validateField(this.fields['region_id']);
            })
        },
        hasAvailableRegions() {
            return Object.keys(this.availableRegions).length > 0;
        },
        onRegionIdChange(event) {
            this.$refs.region.value = this.selectedRegion.length > 0 ?
                this.availableRegions[this.selectedRegion].name :
                ''
            this.onChange(event)
            this.validateField(this.fields['region'])
            // Region change reloads cities (province → city).
            this.loadCities(this.selectedRegion);
        },
        onCityChange(event) {
            // City change reloads sub-cities (city → sub-city).
            this.loadSubCities(this.selectedCity);
            this.onChange(event);
        },
        updateSubmitBtnText() {
            return this.isSubmitting
                ? '<?= $escaper->escapeJs(__('Saving...')) ?>'
                : '<?= $escaper->escapeJs(__('Save Address')) ?>'
        },

        // ---- VN hierarchical dropdown helpers (SL-001) ----
        resetVnCascade() {
            this.cities = [];
            this.subCities = [];
            this.selectedCity = '';
            this.selectedSubCity = '';
        },
        async fetchCities(regionId) {
            const query = 'query{ GetListCity(input:{region_id:"' + regionId + '"}){ default_name label } }';
            try {
                const response = await fetch('/graphql', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: query })
                });
                const json = await response.json();
                return (json.data && json.data.GetListCity) ? json.data.GetListCity : [];
            } catch (error) {
                console.error('AddressDropdown: failed to load cities', error);
                return [];
            }
        },
        async fetchSubCities(cityName, regionId) {
            const query = 'query{ GetListSubCity(input:{default_name:"' + cityName + '",region_id:"' + regionId + '"}){ default_name label } }';
            try {
                const response = await fetch('/graphql', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: query })
                });
                const json = await response.json();
                return (json.data && json.data.GetListSubCity) ? json.data.GetListSubCity : [];
            } catch (error) {
                console.error('AddressDropdown: failed to load sub-cities', error);
                return [];
            }
        },
        async populateCities(regionId) {
            if (!regionId || regionId === '0') {
                this.cities = [];
                return;
            }
            this.isLoadingCities = true;
            this.cities = await this.fetchCities(regionId);
            this.isLoadingCities = false;
        },
        async populateSubCities(cityName, regionId) {
            if (!cityName || !regionId || regionId === '0') {
                this.subCities = [];
                return;
            }
            this.isLoadingSubCities = true;
            this.subCities = await this.fetchSubCities(cityName, regionId);
            this.isLoadingSubCities = false;
        },
        async loadCities(regionId) {
            // Fresh region selection resets downstream selections.
            this.selectedCity = '';
            this.selectedSubCity = '';
            this.subCities = [];
            await this.populateCities(regionId);
        },
        async loadSubCities(cityName) {
            this.selectedSubCity = '';
            await this.populateSubCities(cityName, this.selectedRegion);
        }
    }
}

window.addEventListener('DOMContentLoaded', () => {

    hyva.formValidation.addRule('telephone', (value, options) => {
        const phoneNumber = value.trim().replace(' ', '');
        if (phoneNumber && phoneNumber.length < (options.minlength || 3)) {
            return '<?= $escaper->escapeJs(__('The telephone number is too short.')) ?>';
        }

        return true;
    });

    const postCodeSpecs = <?= /* @noEscape */ $block->getPostCodeConfig()->getSerializedPostCodes() ?>;

    hyva.formValidation.addRule('postcode', (postCode, options, field, context) => {
        context.removeMessages(field, 'postcode-warning')
        const countryId = (context.fields['country_id'] && context.fields['country_id'].element.value),
              validatedPostCodeExamples = [],
              countryPostCodeSpecs = countryId && postCodeSpecs ? postCodeSpecs[countryId] : false;

        if (! postCode || ! countryPostCodeSpecs) return true;

        for (const postCodeSpec of Object.values(countryPostCodeSpecs)) {
            if (new RegExp(postCodeSpec.pattern).test(postCode)) return true;
            validatedPostCodeExamples.push(postCodeSpec.example);
        }
        if (validatedPostCodeExamples) {
            context.addMessages(field, 'postcode-warning', [
                '<?= $escaper->escapeJs(__('Provided Zip/Postal Code seems to be invalid.')) ?>',
                '<?= $escaper->escapeJs(__(' Example: ')) ?>' + validatedPostCodeExamples.join('; ') + '. ',
                '<?= $escaper->escapeJs(__('If you believe it is the right one you can ignore this notice.')) ?>'
            ]);
        }

        return true;
    });
})
</script>
