                                                       a strict compare is always false and the :selected effect then DEselects
                                                       the option the user just picked (first pick appears to not stick). */ ?>
                                                :selected="String(level.selectedId) === String(option.city_id)"
                                                x-text="option.name"></option>
                                    </template>
