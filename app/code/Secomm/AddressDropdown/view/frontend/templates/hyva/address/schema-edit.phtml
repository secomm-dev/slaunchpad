<script>
    function initCustomerAddressSchemaEdit() {
        return {
            directoryData: {},
            availableRegions: {},
            messageTime: 5000,
            fieldsNames: [],
            selectedRegion: '<?= $escaper->escapeJs($block->getRegion() ?: 0) ?>',
            isZipRequired: true,
            isRegionRequired: true,
            showOptionalRegions: <?= $showOptionalRegions ? 'true' : 'false' ?>,

            // ---- Schema-driven cascade (FEAT-2PZQKJ / TASK-3T3NSV) ----
            profileCode: null,          // null => unmapped country => native `city` input
            regionLabel: '<?= $escaper->escapeJs(__('State/Province')) ?>',
            regionPlaceholder: '<?= $escaper->escapeJs(__('Please select a region, state or province.')) ?>',
            cityLevels: [],             // [{label, placeholder, required, options, selectedId, selectedName, loading, active}]
            leafIndex: -1,              // index of the select currently acting as the leaf
            cityInitial: '<?= $escaper->escapeJs($cityInitial) ?>',

            async onPrivateContentLoaded(data) {
                this.directoryData = data['directory-data'] || {};

                <?php if ($block->getCountryId()): ?>
                    this.setCountry(this.$refs['country_id'], '<?= $escaper->escapeJs($block->getRegion()) ?>');
                    await this.loadSchemaForCountry(this.$refs['country_id'].value);

                    // Pre-fill the cascade for an existing address (edit mode).
                    const initialRegionId = this.selectedRegion;
                    if (initialRegionId && initialRegionId !== '0' && this.profileCode !== null) {
                        await this.loadLevelOptions(0, initialRegionId);
                        await this.preFillCascade();
                    }
                <?php endif; ?>
            },
            setRegionInputValue(regionName) {
                this.$nextTick(() => {
                    const regionInputElement = this.$refs['region'];
                    if (regionInputElement) {
                        regionInputElement.value = regionName;
                    }
                })
            },
            setCountry(countrySelectElement, initialRegion) {
                const selectedOption = countrySelectElement.options[countrySelectElement.selectedIndex];
                const countryCode = countrySelectElement.value;
                const countryData = this.directoryData[countryCode] || false;

                if (!countryData) {
                    this.setRegionInputValue('');
                    return;
                }

                this.isZipRequired = selectedOption.dataset.isZipRequired === '1';
                this.isRegionRequired = selectedOption.dataset.isRegionRequired === '1';

                this.availableRegions = countryData.regions || {};

                const initialRegionId = Object.keys(this.availableRegions)
                    .filter(regionId => this.availableRegions[regionId].name === initialRegion)[0];
                this.selectedRegion = initialRegionId || '0';
                this.setRegionInputValue(initialRegionId && this.availableRegions[initialRegionId].name || '');
            },
            async changeCountry(event, initialRegion) {
                this.setCountry(event.target, initialRegion);
                this.validateCountryDependentFields();
                // Country change re-resolves the profile and resets the cascade.
                await this.loadSchemaForCountry(event.target.value);
                const regionId = this.selectedRegion && this.selectedRegion !== '0' ? this.selectedRegion : null;
                if (this.profileCode !== null && regionId) {
                    await this.loadLevelOptions(0, regionId);
                }
                this.onChange(event);
            },
            validateCountryDependentFields() {
                this.$nextTick(() => {
                    this.fields['postcode'] && this.removeMessages(this.fields['postcode'])
                    this.fields['region'] && this.removeMessages(this.fields['region'])
                    delete this.fields['postcode'];
                    delete this.fields['region'];
                    this.setupField(this.$refs['country_id']);
                    this.setupField(this.$refs['postcode']);
                    this.setupField(this.$refs['region']);
                    this.setupField(this.$refs['region_id']);

                    this.fields['postcode'] && this.validateField(this.fields['postcode']);
                    this.fields['region'] && this.validateField(this.fields['region']);
                    this.fields['region_id'] && this.validateField(this.fields['region_id']);
                })
            },
            hasAvailableRegions() {
                return Object.keys(this.availableRegions).length > 0;
            },
            onRegionIdChange(event) {
                this.$refs.region.value = this.selectedRegion.length > 0 ?
                    this.availableRegions[this.selectedRegion].name :
                    ''
                this.onChange(event)
                this.validateField(this.fields['region'])
                // Region change reloads the first city level.
                if (this.profileCode !== null && this.selectedRegion && this.selectedRegion !== '0') {
                    this.loadLevelOptions(0, this.selectedRegion);
                }
            },
            updateSubmitBtnText() {
                return this.isSubmitting
                    ? '<?= $escaper->escapeJs(__('Saving...')) ?>'
                    : '<?= $escaper->escapeJs(__('Save Address')) ?>'
            },

            // ---- Schema cascade helpers ----
            get leafName() {
                const level = this.cityLevels[this.leafIndex];
                return level ? (level.selectedName || '') : '';
            },
            get leafId() {
                const level = this.cityLevels[this.leafIndex];
                return level && level.selectedId ? String(level.selectedId) : '';
            },
            get leafPathJson() {
                const path = [];
                for (let i = 0; i <= this.leafIndex; i++) {
                    const level = this.cityLevels[i];
                    if (level && level.selectedId) {
                        path.push({city_id: level.selectedId, level: i + 1, default_name: level.selectedName});
                    }
                }
                return path.length ? JSON.stringify(path) : '';
            },
            async fetchGraphQL(query) {
                try {
                    const response = await fetch('/graphql', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({query: query})
                    });
                    const json = await response.json();
                    return (json && json.data) ? json.data : null;
                } catch (error) {
                    console.error('AddressDropdown schema renderer: GraphQL request failed', error);
                    return null;
                }
            },
            async loadSchemaForCountry(countryCode) {
                const data = await this.fetchGraphQL(
                    'query{addressSchema(input:{country_id:' + JSON.stringify(String(countryCode)) + '})'
                    + '{profile_code levels{entity_type depth label placeholder sort_order required}}}'
                );
                const schema = data && data.addressSchema ? data.addressSchema : null;
                const levels = schema && schema.levels ? schema.levels : [];

                // Reset cascade state first (country switch).
                this.cityLevels = [];
                this.leafIndex = -1;

                if (!schema || !schema.profile_code || levels.length === 0) {
                    this.profileCode = null; // native Magento city input
                    return;
                }
                this.profileCode = schema.profile_code;

                const regionLevel = levels.find(level => level.entity_type === 'region');
                if (regionLevel) {
                    this.regionLabel = regionLevel.label;
                    this.regionPlaceholder = regionLevel.placeholder || this.regionPlaceholder;
                }

                this.cityLevels = levels
                    .filter(level => level.entity_type === 'city')
                    .map(level => ({
                        label: level.label,
                        placeholder: level.placeholder || '',
                        required: !!level.required,
                        options: [],
                        selectedId: '',
                        selectedName: '',
                        loading: false,
                        active: true
                    }));
                // Only the first level is selectable before a parent is chosen.
                this.cityLevels.forEach((level, idx) => { level.active = idx === 0; });
            },
            async loadLevelOptions(idx, parentId) {
                if (idx >= this.cityLevels.length || !this.profileCode) {
                    return;
                }
                const level = this.cityLevels[idx];
                level.loading = true;
                level.options = [];
                level.selectedId = '';
                level.selectedName = '';
                // Deactivate deeper levels until this one resolves.
                this.cityLevels.forEach((other, otherIdx) => { if (otherIdx > idx) other.active = false; });
                this.leafIndex = -1;

                const input = idx === 0
                    ? 'region_id:' + parseInt(parentId, 10)
                    : 'parent_city_id:' + parseInt(parentId, 10);
                const data = await this.fetchGraphQL(
                    'query{addressLocations(input:{' + input
                    + ',profile_code:' + JSON.stringify(this.profileCode)
                    + '}){city_id default_name name has_children depth}}'
                );
                const options = data && data.addressLocations ? data.addressLocations : [];
                level.options = options;
                level.loading = false;
                level.active = true;
                if (options.length === 0) {
                    // No qualifying children — the previous selection is the leaf.
                    this.leafIndex = idx - 1;
                }
            },
            async onLevelChange(idx, event) {
                const level = this.cityLevels[idx];
                const option = level.options.find(option => String(option.city_id) === String(level.selectedId));
                level.selectedName = option ? option.default_name : '';
                this.leafIndex = idx;
                if (idx + 1 < this.cityLevels.length) {
                    await this.loadLevelOptions(idx + 1, level.selectedId);
                }
                // Pass the real Alpine event: the form-validation mixin's onChange reads
                // event.target (dataset/name) — a placeholder object throws TypeError.
                this.onChange(event);
            },
            async preFillCascade() {
                if (!this.cityLevels.length) {
                    return;
                }
                const first = this.cityLevels[0];
                // Saved addresses carry the leaf name (legacy data); new-format saves also
                // carry address_city_id. Depth-1 profiles prefill exactly; deeper chains
                // prefill the first level and require re-selection below it (known limitation
                // until location_path is persisted server-side — TASK-YQSS3M).
                const option = first.options.find(option => option.default_name === this.cityInitial)
                    || first.options.find(option => String(option.city_id) === String(this.cityInitial));
                if (!option) {
                    return;
                }
                first.selectedId = String(option.city_id);
                first.selectedName = option.default_name;
                this.leafIndex = 0;
                if (this.cityLevels.length > 1) {
                    await this.loadLevelOptions(1, option.city_id);
                }
            }
        }
    }

    window.addEventListener('DOMContentLoaded', () => {

        hyva.formValidation.addRule('telephone', (value, options) => {
            const phoneNumber = value.trim().replace(' ', '');
            if (phoneNumber && phoneNumber.length < (options.minlength || 3)) {
                return '<?= $escaper->escapeJs(__('The telephone number is too short.')) ?>';
            }

            return true;
        });

        const postCodeSpecs = <?= /* @noEscape */ $block->getPostCodeConfig()->getSerializedPostCodes() ?>;

        hyva.formValidation.addRule('postcode', (postCode, options, field, context) => {
            context.removeMessages(field, 'postcode-warning')
            const countryId = (context.fields['country_id'] && context.fields['country_id'].element.value),
                  validatedPostCodeExamples = [],
                  countryPostCodeSpecs = countryId && postCodeSpecs ? postCodeSpecs[countryId] : false;

            if (! postCode || ! countryPostCodeSpecs) return true;

            for (const postCodeSpec of Object.values(countryPostCodeSpecs)) {
                if (new RegExp(postCodeSpec.pattern).test(postCode)) return true;
                validatedPostCodeExamples.push(postCodeSpec.example);
            }
            if (validatedPostCodeExamples) {
                context.addMessages(field, 'postcode-warning', [
                    '<?= $escaper->escapeJs(__('Provided Zip/Postal Code seems to be invalid.')) ?>',
                    '<?= $escaper->escapeJs(__(' Example: ')) ?>' + validatedPostCodeExamples.join('; ') + '. ',
                    '<?= $escaper->escapeJs(__('If you believe it is the right one you can ignore this notice.')) ?>'
                ]);
            }

            return true;
        });
    })
</script>
<?php $hyvaCsp->registerInlineScript() ?>
