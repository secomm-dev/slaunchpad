<!--
  ~ TASK-DFGFZ9 (DEC-TASKDFGFZ9-001/003): COD identification moved OUT of ShippingCore —
  ~ owned by Secomm_Cod (P1 default `cashondelivery` hardcoded; the former "COD Settings"
  ~ admin section no longer exists).
  ~ This section keeps ShippingCore-owned configuration only (Physical Package Defaults).
  -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="secomm_shippingcore" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Secomm Shipping Core</label>
            <tab>secomm</tab>
            <resource>Magento_Backend::stores</resource>
                <group id="physical" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Physical Package Defaults</label>
                <comment>Merchant default package dimensions (cm), used ONLY to prefill the shipment package-information input. The confirmed values on the shipment are what carriers receive.</comment>
                <field id="default_package_length" translate="label" type="text" sortOrder="10" showInDefault="1">
                    <label>Default Package Length (cm)</label>
                    <validate>integer</validate>
                </field>
                <field id="default_package_width" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Default Package Width (cm)</label>
                    <validate>integer</validate>
                </field>
                <field id="default_package_height" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Default Package Height (cm)</label>
                    <validate>integer</validate>
                </field>
            </group>
</section>
    </system>
</config>
