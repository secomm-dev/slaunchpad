<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Secomm_ShippingCore">
        <!-- SL-015 / DEC-SL015-001: generic shipping contracts. Depends on NO Secomm carrier. -->
        <!-- DEC-FEATYA2C0W-004 (D1) / TASK-AQT7V3: ShippingCore consumes Secomm_VietNamAddress
             contracts (Phase E-A). Direction is one-way — VietNamAddress never depends on us. -->
        <sequence>
            <module name="Magento_Directory"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Shipping"/>
            <module name="Magento_Store"/>
            <module name="Secomm_VietNamAddress"/>
        </sequence>
    </module>
</config>
