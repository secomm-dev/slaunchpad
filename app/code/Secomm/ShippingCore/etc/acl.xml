<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- FEAT-QA23PZ / DEC-FEATQA23PZ-001 — Shipping Zones admin surface.
                     Deliberately NOT reusing any address-management permission. -->
                <resource id="Secomm_ShippingCore::shipping_zones" title="Shipping" translate="title" sortOrder="65">
                    <resource id="Secomm_ShippingCore::zones" title="View Shipping Zones" translate="title" sortOrder="10"/>
                    <resource id="Secomm_ShippingCore::zones_manage" title="Manage Shipping Zones" translate="title" sortOrder="20"/>
                    <!-- TASK-WY6WP5 — Shipping Coverage (availability + zones + shared rate
                         orchestration policy). Assignment editing surface for zone refs.
                         Resource IDs stay stable — only the labels change. -->
                    <resource id="Secomm_ShippingCore::carrier_coverage" title="View Shipping Coverage" translate="title" sortOrder="30"/>
                    <resource id="Secomm_ShippingCore::carrier_coverage_manage" title="Manage Shipping Coverage" translate="title" sortOrder="40"/>
                </resource>
                <!-- Stores → Settings → Config section (existing secomm_shippingcore system section). -->
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Secomm_ShippingCore::config" title="Secomm ShippingCore Configuration" translate="title" sortOrder="70"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
