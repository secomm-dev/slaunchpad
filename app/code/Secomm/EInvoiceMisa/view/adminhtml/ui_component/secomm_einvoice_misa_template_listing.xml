<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                secomm_einvoice_misa_template_listing.secomm_einvoice_misa_template_listing_data_source
            </item>
        </item>
    </argument>
    <settings>
        <spinner>secomm_einvoice_misa_template_columns</spinner>
        <deps>
            <dep>secomm_einvoice_misa_template_listing.secomm_einvoice_misa_template_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="refresh" class="Secomm\EInvoiceMisa\Block\Adminhtml\Template\RefreshButton"/>
        </buttons>
    </settings>
    <dataSource name="secomm_einvoice_misa_template_listing_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Secomm_EInvoiceMisa::template</aclResource>
        <dataProvider class="Secomm\EInvoiceMisa\Ui\DataProvider\Template\ListingDataProvider"
                      name="secomm_einvoice_misa_template_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="secomm_einvoice_misa_template_columns">
        <column name="inv_series" sortOrder="10">
            <settings>
                <label translate="true">Invoice Series</label>
            </settings>
        </column>
        <column name="template_name" sortOrder="20">
            <settings>
                <label translate="true">Template Name</label>
            </settings>
        </column>
        <column name="ip_template_id" sortOrder="30">
            <settings>
                <label translate="true">Template ID</label>
            </settings>
        </column>
        <column name="status" sortOrder="40">
            <settings>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="is_default" sortOrder="50">
            <settings>
                <label translate="true">Store Default</label>
            </settings>
        </column>
    </columns>
</listing>
