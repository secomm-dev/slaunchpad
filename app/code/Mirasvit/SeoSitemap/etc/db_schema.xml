<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="mst_seo_sitemap_provider" resource="default" engine="innodb" comment="SEO Sitemap Provider">
        <column xsi:type="int" name="provider_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Provider ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="text" name="url" nullable="true" comment="URL"/>
        <column xsi:type="varchar" name="priority" nullable="true" length="10" comment="Priority"/>
        <column xsi:type="varchar" name="frequency" nullable="true" length="32" comment="Frequency"/>
        <column xsi:type="smallint" name="is_active" padding="5" unsigned="true" nullable="false" identity="false" default="1" comment="Is Active"/>
        <column xsi:type="varchar" name="store_ids" nullable="true" length="255" comment="Store IDs"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="provider_id"/>
        </constraint>
    </table>

</schema>
