<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_commit_after">
        <observer name="mst_seo_auto_redirect_product_save" instance="Mirasvit\Seo\Observer\AutoRedirect\ProductSaveAfterObserver"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="mst_seo_auto_redirect_product_delete_after" instance="Mirasvit\Seo\Observer\AutoRedirect\ProductDeleteAfterObserver"/>
    </event>
</config>
