<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_cart_product_add_after">
        <observer name="magefanFBPixelCartProductAddAfter" instance="Magefan\FacebookPixelPlus\Observer\ProductAddToCartAfter" />
    </event>
    <event name="checkout_cart_save_after">
        <observer name="magefanFBPixelSalesCartSaveAfter" instance="Magefan\FacebookPixelPlus\Observer\CartSaveAfter" />
    </event>
    <event name="wishlist_add_product">
        <observer name="magefanFBPixelWishlistProductAdd" instance="Magefan\FacebookPixelPlus\Observer\ProductAddToWishlist" />
    </event>
</config>
