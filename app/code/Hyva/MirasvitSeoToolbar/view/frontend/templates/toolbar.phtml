<script>
    function init_mst_seo_toolbar() {
        const cookieName = 'mst-seo-toolbar';
        return {
            decorate: function () {
                Array.from(this.$root.querySelectorAll('li a')).map(el => {
                    el.classList.add('underline', 'text-blue-500', 'hover:text-blue-700');
                })
            },
            open: hyva.getCookie(cookieName) === null || hyva.getCookie(cookieName) !== 'off',
            toggle: function() {
                this.open = !this.open;
                hyva.setCookie(cookieName, this.open ? 'on' : 'off', 1);
            },
            toolbarClasses() {
                return {
                    'fixed bottom-4 right-4 border border-1 border-gray-800': this.open
                }
            },
            toolbarHeaderClasses() {
                return {
                    'fixed bottom-8 left-8 pr-10': !this.open,
                    'pr-14 text-center': this.open
                }
            }
        };
    }

    window.addEventListener(
        'alpine:init',
        () => Alpine.data('init_mst_seo_toolbar', init_mst_seo_toolbar),
        {once: true}
    );
</script>
